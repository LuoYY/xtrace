+
+bool XTraceLogger::LogGeneratedEntry(const char* api,
+                                     const char* entry_kind,
+                                     const char* interface_name,
+                                     const char* member_name,
+                                     unsigned overload_count,
+                                     uint64_t call_token) {
+  const XTraceConfig& config = GetCachedConfig();
+  if (!config.enabled ||
+      // Same first-config barrier as every other entry (N3-part2).
+      !xtrace::XTraceProducerHub::Get()->ConfigReceived()) {
+    return false;  // P5-R5: not admitted (capture window closed)
+  }
+  auto snapshot = EntrySnapshot();
+  if (!CategoriesInclude(snapshot->categories, "reverse")) {
+    return false;  // P5-R5: not admitted (filtered)
+  }
+  // Entry facts as a webidl_entry sub-object (channel explicit inside for
+  // self-containment — DP2 ruling: no default semantics). The envelope's
+  // top-level channel is set by EmitEvent's parameter below.
+  std::string extra;
+  extra.append("\"webidl_entry\":{");
+  extra.append("\"channel\":\"bindings\",");
+  extra.append("\"entry_kind\":");
+  extra.append(QuoteJsonString(entry_kind ? entry_kind : "unknown"));
+  extra.append(",\"interface\":");
+  extra.append(QuoteJsonString(interface_name ? interface_name : ""));
+  extra.append(",\"member\":");
+  extra.append(QuoteJsonString(member_name ? member_name : ""));
+  extra.append(",\"overload_count\":");
+  extra.append(base::NumberToString(overload_count));
+  // P5-R5: call_token is a decimal STRING (schema numeric convention;
+  // the validator enforces the single form).
+  extra.append(",\"call_token\":\"");
+  extra.append(base::NumberToString(call_token));
+  extra.append("\"");
+  extra.append("}");
+  EmitEvent(config, "reverse", "call", api ? api : "WebIDL.entry",
+            String("[]"),
+            /*capture_stack=*/false, std::string_view(), std::string_view(),
+            nullptr, nullptr, nullptr, nullptr, extra, snapshot->generation,
+            /*channel=*/kBindingsChannelName);
+  // P5-R5 admission: the paired outcome is emitted only when the entry
+  // was counted by the producer (see EmitEvent's admission report).
+  return t_last_event_admitted;
+}
+
+void XTraceLogger::LogValueTap(uint32_t script_id,
+                                uint32_t bytecode_version,
+                                uint32_t bytecode_offset,
+                                uint32_t window_id,
+                                const char* value_json,
+                                size_t value_len) {
+  const XTraceConfig& config = GetCachedConfig();
+  if (!config.enabled ||
+      !xtrace::XTraceProducerHub::Get()->ConfigReceived()) {
+    return;
+  }
+  auto snapshot = EntrySnapshot();
+  if (!CategoriesInclude(snapshot->categories, "reverse")) {
+    return;
+  }
+  std::string extra;
+  extra.append("\"value_tap\":{");
+  extra.append("\"channel\":\"impl\",");
+  extra.append("\"value_role\":\"unclassified\",");
+  extra.append("\"slot\":\"accumulator\",");
+  extra.append("\"timepoint\":\"pre-dispatch\",");
+  extra.append("\"instance\":\"");
+  extra.append(base::NumberToString(script_id));
+  extra.append("/");
+  extra.append(base::NumberToString(bytecode_version));
+  extra.append("\",");
+  extra.append("\"offset\":\"");
+  extra.append(base::NumberToString(bytecode_offset));
+  extra.append("\",\"window_id\":\"");
+  extra.append(base::NumberToString(window_id));
+  extra.append("\",\"value\":");
+  if (value_json && value_len > 0) {
+    extra.append(value_json, value_len);
+  } else {
+    extra.append("{\"state\":\"unavailable\",\"reason\":\"empty-encoding\"}");
+  }
+  extra.append("}");
+  EmitEvent(config, "reverse", "call", "ValueTap.observe", String("[]"),
+            /*capture_stack=*/false, std::string_view(), std::string_view(),
+            nullptr, nullptr, nullptr, nullptr, extra, snapshot->generation);
+}
+
+void XTraceLogger::LogGeneratedOutcome(uint64_t call_token,
+                                        const char* outcome,
+                                        int selected_overload,
+                                        bool promise_returning) {
+  const XTraceConfig& config = GetCachedConfig();
+  if (!config.enabled ||
+      !xtrace::XTraceProducerHub::Get()->ConfigReceived()) {
+    return;
+  }
+  auto snapshot = EntrySnapshot();
+  if (!CategoriesInclude(snapshot->categories, "reverse")) {
+    return;
+  }
+  std::string extra;
+  extra.append("\"webidl_outcome\":{");
+  extra.append("\"channel\":\"bindings\",");
+  extra.append("\"call_token\":\"");
+  extra.append(base::NumberToString(call_token));
+  extra.append("\",\"outcome\":");
+  extra.append(QuoteJsonString(outcome ? outcome : "unknown"));
+  if (selected_overload >= 0) {
+    // Dispatcher routing fact (DP1: no second entry event) — the selected
+    // 0-based overload index rides the paired terminal event.
+    extra.append(",\"selected_overload\":\"");
+    extra.append(base::NumberToString(selected_overload));
+    extra.append("\"");
+  }
+  if (promise_returning) {
+    // P5-R2 (chief review): a promise-returning entry's synchronous
+    // exception converts to a rejection — labeled explicitly, never
+    // conflated with a plain throw's terminal semantics.
+    extra.append(",\"sync_exception_becomes\":\"rejection\"");
+  }
+  extra.append("}");
+  EmitEvent(config, "reverse", "return", "WebIDL.outcome", String("[]"),
+            /*capture_stack=*/false, std::string_view(), std::string_view(),
+            nullptr, nullptr, nullptr, nullptr, extra, snapshot->generation,
+            /*channel=*/kBindingsChannelName);
+}
+
+void XTraceLogger::LogEventNoStack(const char* category,
+                                   const char* phase,
+                                   const char* api,
+                                   const String& args_json) {
+  const XTraceConfig& config = GetCachedConfig();
+  if (!config.enabled ||
+      // N3-part2 conservative non-acceptance: until the browser's config
+      // (initial backfill included) has been applied, this process emits
+      // nothing — a fresh renderer never labels events with a stale
+      // launch snapshot.
+      !xtrace::XTraceProducerHub::Get()->ConfigReceived()) {
+    return;
+  }
+  auto snapshot = EntrySnapshot();
+  if (!CategoriesInclude(snapshot->categories, category)) {
+    return;
+  }
+  EmitEvent(config, category, phase, api, args_json,
+            /*capture_stack=*/false, std::string_view(), std::string_view(),
+            nullptr, nullptr, nullptr, nullptr, std::string_view(),
+            snapshot->generation);
+}
