+
+bool CaptureFullAssetsEnabled(const XTraceConfig& config) {
+  return config.capture_assets == "full";
+}
+
+bool IsInternalScriptUrl(const String& url) {
+  std::string url_utf8 = url.Utf8();
+  return url_utf8.starts_with("chrome://") ||
+         url_utf8.starts_with("chrome-untrusted://") ||
+         url_utf8.starts_with("devtools://") ||
+         url_utf8.starts_with("chrome-extension://");
+}
+
+std::string SanitizeAssetIdForPath(std::string_view asset_id) {
+  std::string safe;
+  safe.reserve(asset_id.size());
+  for (char c : asset_id) {
+    unsigned char uc = static_cast<unsigned char>(c);
+    safe.push_back(std::isalnum(uc) ? c : '_');
+  }
+  return safe.empty() ? "asset" : safe;
+}
+
+bool AssetAlreadySent(std::string_view asset_id) {
+  thread_local auto* sent_assets = new std::unordered_set<std::string>();
+  auto [_, inserted] = sent_assets->insert(std::string(asset_id));
+  return !inserted;
+}
+
+// Event-side asset references (schema v3 §5.3): the truncation quadruple
+// travels with the event so consumers can judge without table lookups.
+// The full source never appears in the event line (V06 closure).
+struct ScriptAssetRef {
+  std::string asset_id;
+  std::string sha1;
+  std::string content_path;  // empty for metadata-only
+  uint64_t original_size = 0;
+  bool captured = false;
+};
+
+ScriptAssetRef PrepareScriptAssetRef(const XTraceConfig& config,
+                                     const char* kind,
+                                     const String& url,
+                                     const String& source) {
+  ScriptAssetRef ref;
+  std::string source_utf8 = source.Utf8();
+  std::string url_utf8 = url.Utf8();
+  std::string kind_string(kind ? kind : "unknown");
+  ref.sha1 = Sha1Ref(source_utf8);
+  ref.original_size = source_utf8.size();
+  std::string asset_hash_input =
+      kind_string + "\n" + url_utf8 + "\n" + source_utf8;
+  ref.asset_id = Sha1Ref(asset_hash_input);
+  ref.captured = CaptureFullAssetsEnabled(config);
+  if (ref.captured) {
+    std::string trace_stem =
+        config.trace_stem.empty() ? "trace_unknown" : config.trace_stem;
+    ref.content_path = "assets/" + trace_stem + "/" +
+                       SanitizeAssetIdForPath(ref.asset_id) + ".js";
+  }
+  return ref;
+}
+
+void AppendAssetRefFields(std::string* fields, const ScriptAssetRef& ref) {
+  fields->append("\"asset_refs\":[{\"asset_id\":");
+  fields->append(QuoteJsonString(ref.asset_id));
+  fields->append(",\"sha1\":");
+  fields->append(QuoteJsonString(ref.sha1));
+  fields->append(",\"original_size\":");
+  fields->append("\"" + base::NumberToString(ref.original_size) + "\"");
+  fields->append(",\"saved_size\":");
+  fields->append("\"" + base::NumberToString(ref.original_size) + "\"");
+  fields->append(",\"truncated\":false");
+  fields->append("}]");
+}
+
+// Asset manifest row (schema v3 §5.3). The row body never embeds the
+// source: full mode ships the content through the asset channel, summary
+// mode is metadata-only and retrieval_status declares which (V06 closure).
+void SendScriptAssetRow(xtrace::XTraceThreadProducer* producer,
+                        const char* kind,
+                        const String& url,
+                        const String& source,
+                        const ScriptAssetRef& ref,
+                        uint64_t first_seq) {
+  std::string row;
+  row.append("{\"schema_version\":3");
+  row.append(",\"asset_id\":");
+  row.append(QuoteJsonString(ref.asset_id));
+  row.append(",\"kind\":");
+  row.append(QuoteJsonString(kind ? kind : "unknown"));
+  row.append(",\"url\":");
+  row.append(QuoteJsonString(url.Utf8()));
+  row.append(",\"original_size\":");
+  row.append("\"" + base::NumberToString(ref.original_size) + "\"");
+  row.append(",\"saved_size\":");
+  row.append("\"" + base::NumberToString(ref.original_size) + "\"");
+  row.append(",\"truncated\":false");
+  row.append(",\"sha1\":");
+  row.append(QuoteJsonString(ref.sha1));
+  row.append(",\"retrieval_status\":");
+  row.append(QuoteJsonString(ref.captured ? "captured" : "metadata-only"));
+  if (ref.captured) {
+    row.append(",\"content_path\":");
+    row.append(QuoteJsonString(ref.content_path));
+  }
+  row.append(",\"first_seq\":");
+  row.append("\"" + base::NumberToString(first_seq) + "\"");
+  row.append("}");
+  producer->SendAsset(std::move(row), ref.content_path,
+                      ref.captured ? source.Utf8() : std::string());
+}
+
+bool IsActivationTerminal(const char* phase, const char* api) {
+  if (!phase || !api ||
+      (std::string_view(phase) != "return" &&
+       std::string_view(phase) != "exception")) {
+    return false;
+  }
+  const std::vector<XTraceActivation>& stack = ActivationStack();
+  return !stack.empty() && stack.back().api == api;
+}
+
+CausalityFields CurrentCausalityFields(const XTraceConfig& config,
+                                       const char* phase,
+                                       const char* api,
+                                       int64_t mono_time_us) {
+  const std::vector<XTraceActivation>& stack = ActivationStack();
+  if (IsActivationTerminal(phase, api)) {
+    const XTraceActivation& activation = stack.back();
+    return {.call_token = activation.token,
+            .parent_token = activation.parent_token,
+            .depth = activation.depth,
+            .kind = "paired",
+            .has_parent = activation.parent_token != 0,
+            .has_duration = true,
+            .duration_us = std::max<int64_t>(
+                0, mono_time_us - activation.started_mono_us)};
+  }
+
+  CausalityFields fields;
+  fields.call_token = NextActivationSequenceNumber();
+  if (!stack.empty()) {
+    fields.parent_token = stack.back().token;
+    fields.has_parent = true;
+    fields.depth = stack.back().depth + 1;
+  }
+  return fields;
+}
+
+// Schema v3 §3.4: the causality object is always present. `duration_us`
+// is a decimal string on paired terminal events, otherwise null.
+void AppendCausalityObject(std::string* line,
+                           const XTraceConfig& config,
+                           const CausalityFields& fields) {
+  line->append("\"causality\":{\"kind\":");
+  line->append(QuoteJsonString(fields.kind));
+  line->append(",\"call_id\":");
+  AppendCallId(line, config, fields.call_token);
+  line->append(",\"parent_id\":");
+  if (fields.has_parent) {
+    AppendCallId(line, config, fields.parent_token);
+  } else {
+    line->append("null");
+  }
+  line->append(",\"depth\":");
+  line->append(base::NumberToString(fields.depth));
+  line->append(",\"duration_us\":");
+  line->append(fields.has_duration
+                   ? "\"" + base::NumberToString(fields.duration_us) + "\""
+                   : "null");
+  line->append("}");
+}
+
+// Core v3 emission. The producer assigns the logical sequence number and
+// appends the identity tail; the browser writer stamps capture_id and
+// writer_seq. Asset references travel with the event; the asset row (and
+// content in full mode) follows on the same thread pipe after the event's
+// sequence number is known.
+void EmitEvent(const XTraceConfig& config,
+               const char* category,
+               const char* phase,
+               const char* api,
+               const String& args_json,
+               bool capture_stack,
+               std::string_view frame_url,
+               std::string_view origin,
+               const CausalityFields* causal_fields,
+               const char* asset_kind = nullptr,
+               const String* asset_url = nullptr,
+               const String* asset_source = nullptr,
+               std::string_view extra_top_fields = std::string_view(),
+               const std::string& config_generation = std::string(),
+               // DP2 ruling (P5 review fix 4): every v3 envelope carries a
+               // top-level channel with a real value. Handwritten hook
+               // entry points (the LogEvent* family) default to "impl";
+               // the generated-callback path passes "bindings"
+               // explicitly. The webidl_entry/webidl_outcome sub-objects
+               // keep their own channel copies for self-containment.
+               const char* channel = "impl") {
+  xtrace::XTraceThreadProducer* producer =
+      xtrace::XTraceThreadProducer::Current();
+  if (!producer) {
+    return;
+  }
+
+  const int64_t wall_time_us =
+      (base::Time::Now() - base::Time::UnixEpoch()).InMicroseconds();
+  const int64_t mono_time_us =
+      base::TimeTicks::Now().since_origin().InMicroseconds();
+
+  std::string args = args_json.Utf8();
+  std::string stack_json = capture_stack ? CaptureJavaScriptStack() : "[]";
+
+  ScriptAssetRef asset_ref;
+  bool has_asset_ref = false;
+  std::string extra_fields;
+  if (asset_kind && asset_url && asset_source && CaptureAssetsEnabled(config) &&
+      !asset_source->empty() && !IsInternalScriptUrl(*asset_url)) {
+    asset_ref =
+        PrepareScriptAssetRef(config, asset_kind, *asset_url, *asset_source);
+    has_asset_ref = true;
+    AppendAssetRefFields(&extra_fields, asset_ref);
+  }
+
+  // In causality=off mode the activation stack is unmaintained and every
+  // renderer event renders as a singleton with a fresh token: call_id is
+  // null only for external producer-local observations (browser network),
+  // which never originate here.
+  CausalityFields fields =
+      causal_fields ? *causal_fields
+                    : CurrentCausalityFields(config, phase, api, mono_time_us);
+
+  std::string line;
+  line.append("{\"schema_version\":3");
+  // config_generation is stamped ONCE, in the identity tail appended by
+  // AcceptEvent from the caller's effective-config snapshot (F1/B7).
+  line.append(",\"mono_time_us\":\"");
+  line.append(base::NumberToString(mono_time_us));
+  line.append("\",\"wall_time_us\":\"");
+  line.append(base::NumberToString(wall_time_us));
+  line.append("\",\"pid\":");
+  line.append(base::NumberToString(base::GetCurrentProcId()));
+  line.append(",\"tid\":");
+  line.append(base::NumberToString(base::PlatformThread::CurrentId().raw()));
+  line.append(",\"category\":");
+  line.append(QuoteJsonString(category));
+  line.append(",\"phase\":");
+  line.append(QuoteJsonString(phase));
+  line.append(",\"api\":");
+  line.append(QuoteJsonString(api));
+  line.append(",\"channel\":");
+  line.append(QuoteJsonString(channel ? channel : "impl"));
+  line.append(",\"args\":");
+  line.append(args);
+  line.append(",\"stack\":");
+  line.append(stack_json);
+  line.append(",\"attribution\":");
+  if (frame_url.empty() && origin.empty()) {
+    // Schema v3 §3.3: absence is explicit; never empty-string placeholders
+    // (§6.6 frame_url/origin closure).
+    line.append("{\"status\":\"unresolved\"}");
+  } else {
+    line.append("{\"status\":\"resolved\",\"frame\":{\"frame_url\":");
+    line.append(QuoteJsonString(frame_url));
+    line.append(",\"origin\":");
+    line.append(QuoteJsonString(origin));
+    line.append("}}");
+  }
+  line.append(",");
+  AppendCausalityObject(&line, config, fields);
+  if (!extra_top_fields.empty()) {
+    if (!extra_fields.empty()) {
+      extra_fields.append(",");
+    }
+    extra_fields.append(extra_top_fields);
+  }
+  if (!extra_fields.empty()) {
+    line.append(",");
+    line.append(extra_fields);
+  }
+  line.append("}");
+
+  std::optional<uint64_t> seq =
+      producer->AcceptEvent(std::move(line), config_generation);
+  t_last_event_admitted = seq.has_value();
+  if (seq && has_asset_ref && !AssetAlreadySent(asset_ref.asset_id)) {
+    SendScriptAssetRow(producer, asset_kind, *asset_url, *asset_source,
+                       asset_ref, *seq);
+  }
+}
+
