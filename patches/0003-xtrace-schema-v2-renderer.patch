+namespace blink {
+
+class PLATFORM_EXPORT XTraceLogger {
+ public:
+  static bool Enabled();
+  static bool CausalitySyncEnabled();
+  // P4-E3: the ignition bridge bridges activation_ref to the current
+  // activation's causality token (0 when no activation is active).
+  static uint64_t CurrentActivationToken();
+  // P4: call_id string of the enclosing activation ("" when none) — the
+  // design's activation_ref carries the call_id, not the raw token.
+  static String CurrentActivationCallId();
+  // P4-E3: emit one structured pre-execution Ignition observation through
+  // the standard v3 envelope (no hand-rolled JSON at the bridge).
+  static void LogIgnitionEvent(uint32_t script_id,
+                               uint32_t bytecode_version,
+                               uint32_t bytecode_offset,
+                               const char* opcode_name,
+                               const String& activation_ref);
+  // Starts a paired renderer-side activation. The returned token is only
+  // meaningful on the current thread and is consumed by CompleteActivation.
+  static uint64_t BeginActivation(const char* category,
+                                  const char* api,
+                                  const String& args_json,
+                                  const String& frame_url,
+                                  const String& origin);
+  static void CompleteActivation(uint64_t token);
+  static void AbandonActivation(uint64_t token);
+  static void LogCall(const char* api, const String& args_json);
+  static void LogCall(const char* category,
+                      const char* api,
+                      const String& args_json);
+  static void LogEvent(const char* category,
+                       const char* phase,
+                       const char* api,
+                       const String& args_json);
+  static void LogEventWithContext(const char* category,
+                                  const char* phase,
+                                  const char* api,
+                                  const String& args_json,
+                                  const String& frame_url,
+                                  const String& origin);
+  // P5-E3: generated-callback entry event (channel always "bindings",
+  // never defaulted — DP2 ruling). The scope provides the entry facts;
+  // the logger handles envelope + batching through the standard v3
+  // pipeline.
+  // Returns whether the entry was ADMITTED by the producer (counted and
+  // buffered): the scope suppresses the paired outcome for unadmitted
+  // entries (P5-R5 — no orphan terminal events).
+  static bool LogGeneratedEntry(const char* api,
+                                const char* entry_kind,
+                                const char* interface_name,
+                                const char* member_name,
+                                unsigned overload_count,
+                                uint64_t call_token);
+  // P5-E3: terminal outcome for the same entry (paired by call_token).
+  // outcome: "ok" | "receiver-error" | "arg-error" | "native-exception" |
+  // "call-form-error" | "overload-resolution-failed" |
+  // "lenient-receiver" | "early-return"
+  // selected_overload: 0-based index recorded by RecordOverload on a
+  // dispatcher-routed call; -1 when the entry had no routing fact.
+  // P5.5 E7: value-tap fact event (channel "impl" — engine observer
+  // family). value_json is the V8-side bounded layer-1 encoding; the
+  // event records slot/timepoint/instance/window with value_role
+  // "unclassified" (facts only, contract §4).
+  static void LogValueTap(uint32_t script_id,
+                          uint32_t bytecode_version,
+                          uint32_t bytecode_offset,
+                          uint32_t window_id,
+                          const char* value_json,
+                          size_t value_len);
+  static void LogGeneratedOutcome(uint64_t call_token,
+                                  const char* outcome,
+                                  int selected_overload = -1,
+                                  bool promise_returning = false);
+  static void LogEventNoStack(const char* category,
+                              const char* phase,
+                              const char* api,
+                              const String& args_json);
+  static void LogEventNoStackWithContext(const char* category,
+                                         const char* phase,
+                                         const char* api,
+                                         const String& args_json,
+                                         const String& frame_url,
+                                         const String& origin);
+  static void LogAssetEvent(const char* category,
+                            const char* phase,
+                            const char* api,
+                            const String& args_json,
+                            const char* kind,
+                            const String& url,
+                            const String& source);
+  static void LogEventWithOptionalAsset(const char* category,
+                                        const char* phase,
+                                        const char* api,
+                                        const String& args_json,
+                                        const char* kind,
+                                        const String& url,
+                                        const String& source);
+  static void LogEventWithOptionalAssetAndContext(const char* category,
+                                                  const char* phase,
+                                                  const char* api,
+                                                  const String& args_json,
+                                                  const char* kind,
+                                                  const String& url,
+                                                  const String& source,
+                                                  const String& frame_url,
+                                                  const String& origin);
+  static String QuoteJson(const String& value);
+  static String StringHashRefJson(const String& value);
+  static String NetworkCorrelationKey(const String& method, const String& url);
+};
+
+// Keeps the renderer activation stack balanced across all early returns.
+// Script runners call Complete() only after the terminal record is emitted;
+// destruction otherwise discards the local stack entry without fabricating a
+// terminal event.
+class PLATFORM_EXPORT XTraceActivationScope {
+ public:
+  XTraceActivationScope(const char* category,
+                        const char* api,
+                        const String& args_json,
+                        const String& frame_url,
+                        const String& origin);
+  ~XTraceActivationScope();
+
+  XTraceActivationScope(const XTraceActivationScope&) = delete;
+  XTraceActivationScope& operator=(const XTraceActivationScope&) = delete;
+
+  void Complete();
+
+ private:
+  uint64_t token_ = 0;
+};
