+      // launch snapshot.
+      !xtrace::XTraceProducerHub::Get()->ConfigReceived()) {
+    return;
+  }
+  auto snapshot = EntrySnapshot();
+  if (!CategoriesInclude(snapshot->categories, category)) {
+    return;
+  }
+  const char* asset_kind = nullptr;
+  const String* asset_url = nullptr;
+  const String* asset_source = nullptr;
+  if (!IsInternalScriptUrl(url)) {
+    asset_kind = kind;
+    asset_url = &url;
+    asset_source = &source;
+  }
+  EmitEvent(config, category, phase, api, args_json,
+            /*capture_stack=*/false, std::string_view(), std::string_view(),
+            nullptr, asset_kind, asset_url, asset_source, std::string_view(),
