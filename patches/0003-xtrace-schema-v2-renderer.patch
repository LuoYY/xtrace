+    return;
+  }
+  auto snapshot = EntrySnapshot();
+  if (!CategoriesInclude(snapshot->categories, category)) {
+    return;
+  }
+  const char* asset_kind = nullptr;
+  const String* asset_url = nullptr;
+  const String* asset_source = nullptr;
+  if (!IsInternalScriptUrl(url)) {
+    asset_kind = kind;
+    asset_url = &url;
+    asset_source = &source;
+  }
+  EmitEvent(config, category, phase, api, args_json,
+            /*capture_stack=*/false, frame_url.Utf8(), origin.Utf8(), nullptr,
+            asset_kind, asset_url, asset_source, std::string_view(),
+            snapshot->generation);
+}
+
+XTraceActivationScope::XTraceActivationScope(const char* category,
+                                             const char* api,
+                                             const String& args_json,
+                                             const String& frame_url,
+                                             const String& origin)
+    : token_(XTraceLogger::BeginActivation(category, api, args_json, frame_url,
+                                           origin)) {}
+
+XTraceActivationScope::~XTraceActivationScope() {
+  XTraceLogger::AbandonActivation(token_);
+}
+
+void XTraceActivationScope::Complete() {
+  XTraceLogger::CompleteActivation(token_);
+  token_ = 0;
+}
