+// Script runners call Complete() only after the terminal record is emitted;
+// destruction otherwise discards the local stack entry without fabricating a
+// terminal event.
+class PLATFORM_EXPORT XTraceActivationScope {
+ public:
+  XTraceActivationScope(const char* category,
+                        const char* api,
+                        const String& args_json,
+                        const String& frame_url,
+                        const String& origin);
+  ~XTraceActivationScope();
+
+  XTraceActivationScope(const XTraceActivationScope&) = delete;
+  XTraceActivationScope& operator=(const XTraceActivationScope&) = delete;
+
+  void Complete();
+
+ private:
+  uint64_t token_ = 0;
