+  const std::vector<XTraceActivation>& stack = ActivationStack();
+  if (stack.empty()) {
+    return String();
+  }
+  // Same construction as AppendCallId: session_id is numeric-derived and
+  // JSON-safe, so no escaping is needed.
+  return String::FromUtf8(config.session_id + ":" +
+                          base::NumberToString(stack.back().token));
+}
+
+void XTraceLogger::LogIgnitionEvent(uint32_t script_id,
+                                    uint32_t bytecode_version,
+                                    uint32_t bytecode_offset,
+                                    const char* opcode_name,
+                                    const String& activation_ref) {
+  const XTraceConfig& config = GetCachedConfig();
+  if (!config.enabled) {
+    return;
+  }
+  auto snapshot = EntrySnapshot();
+  if (!CategoriesInclude(snapshot->categories, "reverse")) {
+    return;
+  }
+  // Schema v3 §2 / design DP2: the six fields live in a top-level
+  // `ignition` object (args stays an empty array — no per-event payload).
+  std::string ignition;
+  ignition.append("\"ignition\":{\"script_id\":");
+  ignition.append(QuoteJsonString(base::NumberToString(script_id)));
+  ignition.append(",\"bytecode_version\":");
+  ignition.append(QuoteJsonString(base::NumberToString(bytecode_version)));
+  ignition.append(",\"bytecode_offset\":");
+  ignition.append(QuoteJsonString(base::NumberToString(bytecode_offset)));
+  ignition.append(",\"opcode\":");
+  ignition.append(QuoteJsonString(
+      opcode_name ? opcode_name : std::string("Unknown")));
+  ignition.append(",\"tier\":\"ignition\",\"activation_ref\":");
+  ignition.append(activation_ref.empty()
+                      ? "null"
+                      : QuoteJsonString(activation_ref.Utf8()));
+  ignition.append("}");
+  // Hot path: no stack capture; attribution stays unresolved (schema v3
+  // §3.3 explicitly allows this for V8 paths — never guess from URL/time).
+  // Causality comes from the ambient activation stack: the event is a
+  // singleton child of the active script activation.
+  EmitEvent(config, "reverse", "call", "Ignition.execute", String("[]"),
+            /*capture_stack=*/false, std::string_view(), std::string_view(),
+            nullptr, /*asset_kind=*/nullptr, /*asset_url=*/nullptr,
+            /*asset_source=*/nullptr, ignition, snapshot->generation);
+}
+
+bool XTraceLogger::CausalitySyncEnabled() {
+  return blink::CausalitySyncEnabled(GetCachedConfig());
+}
+
+uint64_t XTraceLogger::BeginActivation(const char* category,
+                                       const char* api,
+                                       const String& args_json,
+                                       const String& frame_url,
+                                       const String& origin) {
+  const XTraceConfig& config = GetCachedConfig();
+  if (!blink::CausalitySyncEnabled(config)) {
+    return 0;
+  }
+  auto snapshot = EntrySnapshot();
+  if (!CategoriesInclude(snapshot->categories, category)) {
+    return 0;
+  }
+
+  std::vector<XTraceActivation>& stack = ActivationStack();
+  XTraceActivation activation;
+  activation.token = NextActivationSequenceNumber();
+  activation.api = api;
+  activation.started_mono_us =
+      base::TimeTicks::Now().since_origin().InMicroseconds();
+  if (!stack.empty()) {
+    activation.parent_token = stack.back().token;
+    activation.depth = stack.back().depth + 1;
+  }
+
+  CausalityFields fields;
+  fields.call_token = activation.token;
+  fields.parent_token = activation.parent_token;
+  fields.depth = activation.depth;
+  fields.kind = "paired";
+  fields.has_parent = activation.parent_token != 0;
+  EmitEvent(config, category, "call", api, args_json,
+            /*capture_stack=*/false, frame_url.Utf8(), origin.Utf8(),
+            &fields, nullptr, nullptr, nullptr, std::string_view(),
+            snapshot->generation);
+  stack.push_back(std::move(activation));
+  // P4: bytecode observation is scoped to this activation (bridge no-ops
+  // unless the observer was requested at startup).
+  xtrace::IgnitionBridge::OnActivationBegin(frame_url.Utf8().c_str());
+  return stack.back().token;
+}
+
+void XTraceLogger::CompleteActivation(uint64_t token) {
+  if (!token) {
+    return;
+  }
+  std::vector<XTraceActivation>& stack = ActivationStack();
+  if (!stack.empty() && stack.back().token == token) {
+    stack.pop_back();
+    xtrace::IgnitionBridge::OnActivationEnd();
+  }
+}
+
+void XTraceLogger::AbandonActivation(uint64_t token) {
+  // We intentionally do not synthesize a terminal event here: a scope can be
+  // abandoned before Blink has a ScriptEvaluationResult. The RAII path exists
+  // solely to keep subsequent events from inheriting a stale parent.
+  CompleteActivation(token);
+}
