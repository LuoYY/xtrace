+constexpr char kXTraceEnableEnv[] = "XTRACE_ENABLE";
+constexpr char kXTraceFileEnv[] = "XTRACE_FILE";
+constexpr char kXTraceMaxBodyBytesEnv[] = "XTRACE_MAX_BODY_BYTES";
+constexpr char kXTraceMaxHeaderValueBytesEnv[] =
+    "XTRACE_MAX_HEADER_VALUE_BYTES";
+constexpr char kXTraceCausalityEnv[] = "XTRACE_CAUSALITY";
+constexpr char kXTraceEnableSwitch[] = "xtrace-enable";
+constexpr char kXTraceFileSwitch[] = "xtrace-file";
+constexpr char kXTraceMaxBodyBytesSwitch[] = "xtrace-max-body-bytes";
+constexpr char kXTraceMaxHeaderValueBytesSwitch[] =
+    "xtrace-max-header-value-bytes";
+constexpr char kXTraceCausalitySwitch[] = "xtrace-causality";
