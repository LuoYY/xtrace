+bool IsXTraceCausalitySyncEnabled() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(kXTraceCausalitySwitch)) {
+    return command_line->GetSwitchValueASCII(kXTraceCausalitySwitch) == "sync";
+  }
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  return env->GetVar(kXTraceCausalityEnv).value_or("") == "sync";
+}
+
+void AddXTraceV3ExternalCausality(base::DictValue* event) {
+  // Schema v3 §3.3/§3.4: browser-network observations are producer-local;
+  // attribution stays unresolved (request context materials live in args,
+  // never impersonating frame identity).
+  base::DictValue causality;
+  causality.Set("kind", "external");
+  causality.Set("call_id", base::Value());
+  causality.Set("parent_id", base::Value());
+  causality.Set("depth", 0);
+  causality.Set("duration_us", base::Value());
+  event->Set("causality", std::move(causality));
+  base::DictValue attribution;
+  attribution.Set("status", "unresolved");
+  event->Set("attribution", std::move(attribution));
+}
