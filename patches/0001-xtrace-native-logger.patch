+void LogXTraceMessagePortSend(ScriptState* script_state,
+                              const MessagePort* port,
+                              const ScriptValue& message,
+                              const Transferables& transferables,
+                              SerializedScriptValue* serialized) {
+  const String message_type = XTraceMessageValueType(message);
+  const String message_value = XTraceMessageValue(script_state, message);
+  const String message_value_json =
+      message_value.IsNull() ? String("null")
+                             : XTraceLogger::QuoteJson(message_value);
+  const String message_ref_json =
+      message_value.IsNull()
+          ? String("null")
+          : XTraceLogger::StringHashRefJson(message_value);
+  const String serialized_data_hex = XTraceSerializedDataHex(serialized);
+  const String serialized_data_hex_json =
+      serialized_data_hex.IsNull()
+          ? String("null")
+          : XTraceLogger::QuoteJson(serialized_data_hex);
+  const String serialized_data_ref_json =
+      serialized_data_hex.IsNull()
+          ? String("null")
+          : XTraceLogger::StringHashRefJson(serialized_data_hex);
+  XTraceLogger::LogEvent(
+      "reverse", "call", "MessagePort.postMessage",
+      String::Format(
+          "[{\"direction\":\"send\",\"message_port_id\":%s,"
+          "\"origin\":%s,\"transfer_count\":%u,\"serialized_size\":%llu,"
+          "\"message_type\":%s,\"message_value\":%s,\"message_ref\":%s,"
+          "\"serialized_data_hex\":%s,\"serialized_data_ref\":%s}]",
+          XTraceLogger::QuoteJson(XTraceMessagePortId(port)).Utf8().c_str(),
+          XTraceMessagePortOriginJson(ExecutionContext::From(script_state))
+              .Utf8()
+              .c_str(),
+          static_cast<unsigned>(XTraceTransferCount(transferables)),
+          serialized
