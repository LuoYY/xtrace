+class XTraceThreadProducer;
+
+// Test-only export (P3-E0): parses --xtrace-test-capacity values;
+// decimal > 0 or 0 (no override).
+PLATFORM_EXPORT uint32_t ParseTestCapacitySwitchForTest(const std::string& value);
+
+// Observer scope selector (N3-part2 design §1): URL-substring pattern
+// lists over two NON-interchangeable namespaces plus the explicit
+// internal-scheme switch. Defaults reproduce the historical page-scripts
+// behavior — as configuration, not a hidden hardcode.
+struct PLATFORM_EXPORT ObserverScopeConfig {
+  std::vector<std::string> context_patterns;  // empty = all contexts
+  std::vector<std::string> script_patterns;   // empty = all scripts
+  bool deny_internal = true;
+};
+
+// Effective runtime config published by the browser through XTraceControl
+// (F1/B7): generation and the category filter are ONE snapshot so an event
+// is never filtered by the old config while stamped with the new
+// generation. Immutable once published; the hub swaps the pointer.
+struct PLATFORM_EXPORT EffectiveCaptureConfig {
+  std::string generation = "0";
+  std::string categories;  // launch --xtrace-categories until the first update
+  ObserverScopeConfig observer_scope;
+};
+
+// Producer-side configuration snapshot (startup only; P2 has no hot
+// update). Values are exported for the browser-side manifest.
+struct ProducerRuntimeConfig {
+  uint32_t buffer_capacity = 4096;   // bounded per-thread buffer, events
+  uint32_t max_batch_events = 200;   // count flush trigger
+  uint32_t flush_interval_ms = 50;   // time flush trigger
+  // P2 implements drop-newest only (DP3 default); drop-oldest support would
+  // add interval bookkeeping and is not switchable in this phase.
+  const char* overflow_policy = "drop-newest";
+};
+
+// Process-wide producer hub: the stop flag, the producer-id sequence, and
+// the registry used to distribute a stop to every live producer thread.
+class PLATFORM_EXPORT XTraceProducerHub {
+ public:
+  template <typename T>
+  friend class base::NoDestructor;
+
+  // Test seams (P3-E0): reset stop state and registry between tests, and
+  // override the bounded-buffer capacity without the process command line.
+  void ResetForTesting();
+  // F1/B7: the effective config snapshot. Filter decisions and the
+  // config_generation stamp for one event both come from a single
+  // SnapshotConfig() call at the event entry.
+  std::shared_ptr<const EffectiveCaptureConfig> SnapshotConfig() const;
+  // N3-part2 first-config barrier: false until the browser's initial
+  // config (backfill or update) has been APPLIED in this process. In the
+  // precise environment the observer gate stays closed until then, so a
+  // fresh renderer conservatively emits nothing under a stale snapshot.
+  bool ConfigReceived() const {
+    return config_received_.load(std::memory_order_acquire);
+  }
+  // P3-E4: current effective config, inherited by newly created producers.
+  std::string current_generation() const;
+  void SetCurrentConfig(const std::string& generation,
+                       const std::string& categories,
+                       const ObserverScopeConfig& observer_scope);
+  void SetBufferCapacityForTesting(uint32_t capacity) {
+    config_.buffer_capacity = capacity;
+  }
+  struct RegistryEntry {
+    std::atomic<bool> alive{true};
+    // Only dereferenced on the entry's own sequence (inline when the stop
+    // arrives there, otherwise via a task posted to entry->runner): the
+    // owner thread clears `alive` under the hub lock before destruction.
+    raw_ptr<XTraceThreadProducer> producer = nullptr;
+    scoped_refptr<base::SequencedTaskRunner> runner;
+  };
+
+  static XTraceProducerHub* Get();
+
+  bool stopping() const { return stopping_.load(std::memory_order_acquire); }
+  // Sets the stop flag and distributes settlement to every live producer
+  // thread. See the V09 note in the .cc: delivery count is not an ack.
+  void BeginStop();
+  uint64_t NextLseq();
+  uint64_t Register(std::shared_ptr<RegistryEntry> entry);
+  void Unregister(uint64_t registry_id);
+
+  const std::string& process_epoch() const { return process_epoch_; }
+  const ProducerRuntimeConfig& config() const { return config_; }
+
+  // DP1 ruling condition (P5 review fix 5): NADC entries rejected by the
+  // TryEnter precheck are accounted, never silently dropped. Producer-less
+  // rejections land on this process-wide fallback counter (queryable by
+  // tests and diagnostics; the per-producer counter settles in the
+  // watermark).
+  void RecordNadcPartialNoProducer() { ++nadc_partial_no_producer_; }
+  uint64_t nadc_partial_no_producer() const {
+    return nadc_partial_no_producer_.load(std::memory_order_relaxed);
+  }
+
+  // P5-R2a/R5: outcome marks dropped because no scope was attributable
+  // (TLS depth overflow region) — the recorded gap, never silent.
+  void RecordScopeOverflowNoProducer() { ++scope_overflow_no_producer_; }
+  uint64_t scope_overflow_no_producer() const {
+    return scope_overflow_no_producer_.load(std::memory_order_relaxed);
+  }
+
+ private:
+  XTraceProducerHub();
+
+  std::atomic<bool> stopping_{false};
+  std::atomic<uint64_t> nadc_partial_no_producer_{0};
+  std::atomic<uint64_t> scope_overflow_no_producer_{0};
+  // P3-E4/F1 config propagation: one immutable snapshot; writers swap the
+  // pointer under config_lock_, readers copy the shared_ptr once per event.
+  mutable base::Lock config_lock_;
+  std::shared_ptr<const EffectiveCaptureConfig> effective_config_;
+  std::atomic<bool> config_received_{false};
+  std::atomic<uint64_t> next_lseq_{0};
+  mutable base::Lock lock_;
+  std::map<uint64_t, std::shared_ptr<RegistryEntry>> registry_;
+  uint64_t next_registry_id_ = 0;
+  const std::string process_epoch_;
+  ProducerRuntimeConfig config_;
+};
+
+// Per-thread bounded producer (schema v3, draft §7.1): assigns logical
+// sequence numbers before filtering/dropping, buffers bounded, flushes by
+// count/time, and settles with a watermark on stop or thread exit.
+class PLATFORM_EXPORT XTraceThreadProducer {
+ public:
+  // Lazily created on the current thread; null while capture is disabled.
+  static XTraceThreadProducer* Current();
+
+  // P5-R1: observe an existing producer WITHOUT creating one — the NADC
+  // reject path must not initialize anything as a side effect.
+  static XTraceThreadProducer* CurrentIfExists();
+
+  // F1/B7: register this process's control endpoint at renderer startup
+  // (main thread, before any page script). A renderer spawned AFTER an
+  // updateCapture receives the current config backfill before its first
+  // event, closing the generation-0 first-execution window. No-op when
+  // capture is disabled or the endpoint is already registered.
+  static void EnsureControlEndpointRegistered();
+
+  // Called by core worker code on the worker thread before first use.
+  static void SetCurrentThreadWorkerDescriptor(const char* kind,
+                                               const String& scope_url);
+
+  // Accepts one serialized v3 event line (closing brace included). The
+  // producer appends the identity tail (producer_seq/producer_id/
+  // process_epoch/config_generation) and buffers it. `config_generation`
+  // comes from the SAME effective-config snapshot the caller used for its
+  // category decision (F1/B7: one snapshot per event). Returns the assigned
+  // logical sequence number: absent when the event was not counted
+  // (capture stopping or malformed line); present when the number was
+  // consumed, including drop-newest overflow (counted eligible+dropped,
+  // leaving a tail-only gap).
+  std::optional<uint64_t> AcceptEvent(std::string line,
+                                      const std::string& config_generation);
+
+  // Test seam (P3-E0): replace the browser-side host with an in-process
+  // implementation; when set, no mojo broker binding happens.
+  using HostFactoryForTesting =
+      base::RepeatingCallback<blink::mojom::XTraceHost*()>;
+  static void SetHostFactoryForTesting(HostFactoryForTesting factory);
+
+  // Sends one asset row (and content when present) on this thread's pipe.
+  void SendAsset(std::string asset_json,
+                 std::string content_path,
+                 std::string content);
+
+  // Terminal settlement: flush remaining events, submit the watermark on
+  // this thread's pipe, deactivate. Idempotent; runs on the owning thread.
+  void Settle();
+
+  // DP1 (P5 review fix 5): allocation-free capacity precheck for the
+  // [NoAllocDirectCall] fast path — true when the bounded buffer still has
+  // room and the capture window is open. Sequence-confined like AcceptEvent.
+  bool BufferHasRoom() const;
+
+  // DP1: account one NADC entry rejected by TryEnter (atomic only; this
+  // runs on the no-allocation fast path). Settled in the watermark.
+  void RecordNadcPartial() { ++nadc_partial_; }
+  uint64_t nadc_partial() const {
+    return nadc_partial_.load(std::memory_order_relaxed);
+  }
+
+  // P5-R2a/R5: marks dropped for lack of an attributable scope.
+  void RecordScopeOverflow() { ++scope_overflow_; }
+  uint64_t scope_overflow() const {
+    return scope_overflow_.load(std::memory_order_relaxed);
+  }
+
+  bool settled() const { return settled_; }
+
+  blink::mojom::XTraceHost* host();
+
+ private:
+  XTraceThreadProducer();
+  ~XTraceThreadProducer();  // settles when a capture is still active
+
+  void Flush();
+  void MaybeScheduleFlushTimer();
+  void BuildDescriptor();
+  void SendBatchLocked();
+  blink::mojom::XTraceProducerDescriptorPtr MakeDescriptor();
+
+  // Identity (built lazily at first use so worker descriptors are visible).
+  bool descriptor_built_ = false;
+  bool is_worker_ = false;
+  std::string worker_kind_ = "unresolved";
+  std::string worker_scope_ = "unresolved";
+  std::string producer_id_;
+  std::string process_epoch_;
+  std::string generation_ = "0";  // captured at descriptor build
+  std::string pkind_;
+
+  mojo::Remote<blink::mojom::XTraceHost> host_;
+  bool host_bound_ = false;
+
+  std::deque<std::string> buffer_;  // lines already carry identity tail
+  uint64_t next_seq_ = 1;
+  uint64_t eligible_ = 0;
+  uint64_t enqueued_ = 0;
+  uint64_t dropped_ = 0;
+  std::atomic<uint64_t> nadc_partial_{0};
+  std::atomic<uint64_t> scope_overflow_{0};
+  uint32_t assets_out_ = 0;
+  bool settled_ = false;
+  bool overflowed_ = false;
+  bool flush_timer_posted_ = false;
+  uint64_t registry_id_ = 0;
+};
