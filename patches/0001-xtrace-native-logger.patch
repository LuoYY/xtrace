+
+#include "third_party/blink/renderer/platform/xtrace/xtrace_control_impl.h"
+
+#include "base/functional/bind.h"
+#include "base/task/sequenced_task_runner.h"
+#include "third_party/blink/public/platform/xtrace_control.h"
+#include "third_party/blink/renderer/platform/xtrace/xtrace_producer.h"
+
+namespace blink {
+
+void BindXTraceControlReceiver(
+    mojo::PendingReceiver<mojom::XTraceControl> receiver) {
+  xtrace::XTraceControlImpl::Bind(std::move(receiver));
+}
+
+void EnsureXTraceControlEndpointRegistered() {
+  xtrace::XTraceThreadProducer::EnsureControlEndpointRegistered();
+}
+
+}  // namespace blink
+
+namespace blink::xtrace {
+
+// static
+void XTraceControlImpl::Bind(
+    mojo::PendingReceiver<blink::mojom::XTraceControl> receiver) {
+  // Serviced on the binding thread's default runner; settle fan-out to
+  // worker threads happens through the producer hub's per-thread task
+  // runners, never through a shared mojo::Remote (draft §8.3).
+  new XTraceControlImpl(std::move(receiver));
+}
+
+XTraceControlImpl::XTraceControlImpl(
+    mojo::PendingReceiver<blink::mojom::XTraceControl> receiver)
+    : receiver_(this, std::move(receiver)) {
+  receiver_.set_disconnect_handler(
+      base::BindOnce([](XTraceControlImpl* self) { delete self; },
+                     base::Unretained(this)));
+}
+
+void XTraceControlImpl::UpdateConfig(
+    const std::string& generation, const std::string& categories,
+    const std::vector<std::string>& observer_context_patterns,
+    const std::vector<std::string>& observer_script_patterns,
+    bool observer_deny_internal, UpdateConfigCallback callback) {
+  // P3-E4: swap the process-wide effective config; every subsequent event
+  // stamps the new generation. Confirmation evidence is the events
+  // themselves — no fabricated applied-ACK (draft §8.3). N3-part2: the
+  // observer scope rides the same snapshot.
+  xtrace::ObserverScopeConfig scope;
+  scope.context_patterns = observer_context_patterns;
+  scope.script_patterns = observer_script_patterns;
+  scope.deny_internal = observer_deny_internal;
+  XTraceProducerHub::Get()->SetCurrentConfig(generation, categories, scope);
+  std::move(callback).Run(true /* distributed */);
+}
+
+void XTraceControlImpl::StopCapture(const std::string& capture_id,
+                                    uint32_t deadline_ms,
+                                    StopCaptureCallback callback) {
+  // accepted == "distributed", never "settled" (mojom contract). The hub
+  // fans settlement out to each producer thread; the browser may only
+  // treat watermarks as acknowledgement (draft V09).
+  XTraceProducerHub::Get()->BeginStop();
+  std::move(callback).Run(true);
+}
+
+}  // namespace blink::xtrace
