+      "reverse", "return", "MessagePort.message",
+      String::Format(
+          "[{\"direction\":\"receive\",\"message_port_id\":%s,"
+          "\"origin\":%s,\"sender_origin\":%s,\"port_count\":%u,"
+          "\"transfer_count\":%u,\"serialized_size\":%llu,"
+          "\"message_type\":\"serialized\",\"message_value\":null,"
