+# injection records itself here; generate_interface flushes a per-interface
+# fragment under gen/xtrace/coverage/ and the post-run aggregator (see
+# generate_bindings.py) derives gen/xtrace/webidl_coverage.json from the
+# fragments. The table is therefore same-source with the artifact — it can
+# no longer understate the injected member set.
+_XTRACE_COVERAGE_INJECTIONS = {}  # interface -> member -> set(entry_kind)
