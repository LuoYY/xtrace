+std::vector<XTraceCaptureController::DomainProducerRow>
+XTraceCaptureController::DomainProducerRows() {
+  base::AutoLock lock(writer_lock_);
+  std::vector<DomainProducerRow> rows;
+  for (const auto& [id, state] : producers_) {
+    DomainProducerRow row;
+    row.producer_id = state->producer_id;
+    row.kind = state->pkind == "bnet"
+                   ? std::string("browser-network")
+                   : (state->worker ? state->worker_kind + "-worker"
+                                    : std::string("main-thread"));
+    row.confirmed = state->watermark_received;
+    if (state->watermark_received) {
+      row.final_producer_seq = base::NumberToString(state->final_producer_seq);
+      row.eligible = base::NumberToString(state->eligible);
+      row.enqueued = base::NumberToString(state->enqueued);
+      row.dropped = base::NumberToString(state->dropped);
+    }
+    row.accepted = base::NumberToString(state->accepted);
+    row.written = base::NumberToString(state->written);
+    row.failed = base::NumberToString(state->failed);
+    rows.push_back(std::move(row));
+  }
+  return rows;
+}
