+// F1: once stopping, updateCapture is rejected (serial state machine).
+TEST_F(XTraceCaptureControllerTest, UpdateRejectedWhenStopping) {
+  BeginStop();
+  EXPECT_TRUE(controller_->DomainUpdateCapture("fingerprint", nullptr).empty());
+}
