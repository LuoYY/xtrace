+std::string XTraceCaptureController::DomainUpdateCapture(
+    const std::string& categories, const ObserverScope* observer_scope) {
+  std::string generation;
+  {
+    base::AutoLock lock(writer_lock_);
+    if (stopping_ || finalized_.load(std::memory_order_acquire)) {
+      return std::string();  // updateCapture -> invalidState
+    }
+    generation = base::NumberToString(next_generation_++);
+    status_generation_ = generation;
+    status_categories_ = categories;
+    if (observer_scope) {
+      status_observer_scope_ = *observer_scope;
+    }
+  }
+  // Distribute on the writer runner: the control remotes are bound there
+  // (mojo sequence checker). Delivery is distribution only; confirmation
+  // evidence is per-event config_generation (draft §8.3).
+  WriterRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<XTraceCaptureController> weak,
+             const std::string& generation,
+             const std::string& categories,
+             const ObserverScope& scope) {
+            if (!weak) {
+              return;
+            }
+            base::AutoLock lock(weak->writer_lock_);
+            for (auto& [epoch, remote] : weak->control_remotes_by_epoch_) {
+              remote->UpdateConfig(
+                  generation, categories, scope.context_patterns,
+                  scope.script_patterns, scope.deny_internal,
+                  base::BindOnce([](bool distributed) {}));
+            }
+          },
+          weak_factory_.GetWeakPtr(), generation, categories,
+          status_observer_scope_));
+  return generation;
+}
+
+std::vector<XTraceCaptureController::IdentityRow>
+XTraceCaptureController::DomainIdentityRows() {
+  std::vector<IdentityRow> rows;
+  // Advisory identity snapshot (P3-E5): walk every WebContents' primary
+  // frame tree; unresolved entries stay explicit — never guessed.
+  for (WebContentsImpl* contents : WebContentsImpl::GetAllWebContents()) {
+    std::function<void(FrameTreeNode*)> walk =
+        [&](FrameTreeNode* node) {
+          IdentityRow row;
+          RenderFrameHostImpl* rfh = node->current_frame_host();
+          row.frame_tree_node_id = base::NumberToString(
+              rfh->GetFrameTreeNodeId().GetUnsafeValue());
+          row.document_token = rfh->GetDocumentToken().ToString();
+          row.frame_url = rfh->GetLastCommittedURL().spec();
+          row.resolved = !row.document_token.empty();
+          rows.push_back(std::move(row));
+          for (size_t i = 0; i < node->child_count(); ++i) {
+            walk(node->child_at(i));
+          }
+        };
+    walk(contents->GetPrimaryFrameTree().root());
+  }
+  return rows;
+}
+
+
+void XTraceCaptureController::AcceptNavigationSuccession(
+    uint32_t frame_tree_node_id,
+    const std::string& new_document_token,
+    const std::string& url,
+    bool is_reload,
+    bool same_document) {
+  // UI thread (DidNavigate). Recorded only while a capture is live and
+  // only when the frame's previous document token is KNOWN and DIFFERENT
+  // — first sightings are baseline state, not successions.
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("xtrace-enable")) {
+    return;
+  }
+  base::AutoLock lock(writer_lock_);
+  if (stopping_ || finalized_.load(std::memory_order_acquire)) {
+    return;
+  }
+  auto it = last_document_by_ftn_.find(frame_tree_node_id);
+  if (it == last_document_by_ftn_.end()) {
+    last_document_by_ftn_[frame_tree_node_id] = new_document_token;
+    return;  // first sighting in this capture: baseline
+  }
+  if (it->second == new_document_token) {
+    return;  // same document (same-document navigation)
+  }
+  SuccessionRow row;
+  row.nav_chain_id = "ftn-" + base::NumberToString(frame_tree_node_id);
+  row.frame_tree_node_id = base::NumberToString(frame_tree_node_id);
+  row.from_document = it->second;
+  row.to_document = new_document_token;
+  row.to_url = url;
+  row.cause = is_reload ? "reload"
+                        : (same_document ? "same-document" : "navigation");
+  row.wall_us = base::NumberToString(
+      (base::Time::Now() - base::Time::UnixEpoch()).InMicroseconds());
+  // from_url: best effort from the identity walk's latest snapshot rows.
+  for (const auto& identity : identity_rows_) {
+    if (identity.frame_tree_node_id == row.frame_tree_node_id) {
+      row.from_url = identity.frame_url;
+      break;
+    }
+  }
+  succession_rows_.push_back(std::move(row));
+  it->second = new_document_token;
+}
