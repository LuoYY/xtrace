+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_XTRACE_XTRACE_BRIDGE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_XTRACE_XTRACE_BRIDGE_H_
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace v8 {
+namespace internal {
+class Isolate;
+}  // namespace internal
+}  // namespace v8
+
+namespace blink::xtrace {
+
+// F2 (review B1): embedder side of the structured Ignition observer, owned
+// PER ISOLATE through V8PerIsolateData::UserData. Each activation pushes a
+// scope frame; end pops and restores the outer state — a nested
+// sub-activation ending never closes the enclosing one, and no isolate's
+// lifecycle can close another's gate. Events land on the current thread's
+// XTraceThreadProducer as schema-v3 `ignition` records (six fields,
+// activation_ref bridged to the active causality call_id).
+class PLATFORM_EXPORT IgnitionBridge {
+ public:
+  // Reads the runtime configuration (switch/env). Returns true when the
+  // observer is requested for this capture.
+  static bool ObserverRequested();
+
+  // Marks the observer as requested for this capture; per-isolate wiring
+  // happens lazily at the first activation begin (the isolate is current
+  // there). Idempotent.
+  static void EnsureInstalled();
+
+  // Capture stop: every live isolate's observer closes permanently — new
+  // activations no longer reopen the gate (review B1).
+  static void Close();
+
+  // Activation-scoped gate: pushes a scope frame (selected or not) so end
+  // always has a pair to pop; the gate reflects the innermost SELECTED
+  // activation of THIS isolate.
+  static void OnActivationBegin(const char* frame_url);
+  static void OnActivationEnd();
+};
+
+}  // namespace blink::xtrace
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_XTRACE_XTRACE_IGNITION_BRIDGE_H_
