+
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "third_party/blink/public/mojom/xtrace/xtrace.mojom.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink::xtrace {
+
+// Renderer-side XTraceControl implementation. One instance per renderer
+// process; the endpoint is delivered to the browser in-band on the first
+// producer data pipe (see XTraceHost.ProvideControlEndpoint), so no
+// content-side associated-interface registration is needed (binding-path
+// evidence per DP2 ruling condition ①: XTraceControlImplTest + P2-E7).
+class XTraceControlImpl : public blink::mojom::XTraceControl {
+ public:
+  static void Bind(mojo::PendingReceiver<blink::mojom::XTraceControl> receiver);
+
+  explicit XTraceControlImpl(
+      mojo::PendingReceiver<blink::mojom::XTraceControl> receiver);
+
+  void StopCapture(const std::string& capture_id,
+                   uint32_t deadline_ms,
+                   StopCaptureCallback callback) override;
+  void UpdateConfig(
+      const std::string& generation,
+      const std::string& categories,
+      const std::vector<std::string>& observer_context_patterns,
+      const std::vector<std::string>& observer_script_patterns,
+      bool observer_deny_internal,
+      UpdateConfigCallback callback) override;
+
+ private:
+  // Self-owned: deleted when the associated pipe disconnects.
+  mojo::Receiver<blink::mojom::XTraceControl> receiver_;
+};
+
+}  // namespace blink::xtrace
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_XTRACE_XTRACE_CONTROL_IMPL_H_
diff --git a/third_party/blink/renderer/platform/xtrace/xtrace_generated_scope.cc b/third_party/blink/renderer/platform/xtrace/xtrace_generated_scope.cc
new file mode 100644
index 0000000000..f9b2b7a2ad
--- /dev/null
+++ b/third_party/blink/renderer/platform/xtrace/xtrace_generated_scope.cc
@@ -0,0 +1,250 @@
+// Copyright 2026 The XTrace Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in Chromium's LICENSE file.
+
+#include "third_party/blink/renderer/platform/xtrace/xtrace_generated_scope.h"
+
+#include <atomic>
+#include <string_view>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "third_party/blink/renderer/platform/xtrace/xtrace_logger.h"
+#include "third_party/blink/renderer/platform/xtrace/xtrace_producer.h"
+
+// The thread-local scope stack below is a fixed-size array of intra-thread
+// stack pointers with a depth bound; the accesses are guarded and local.
+#ifdef UNSAFE_BUFFERS_BUILD
+#pragma allow_unsafe_buffers
+#endif
+
+namespace blink::xtrace {
+
+namespace {
+
+constexpr char kBindingsChannel[] = "bindings";
+
+// P5 review fix 2: innermost-active-scope stack for path-classified
+// outcome marking. Overload bodies are separate generated functions from
+// the dispatcher that owns the scope, so error paths mark through this
+// thread-local stack instead of taking a parameter (signatures stay
+// stock). Push/pop in ctor/dtor makes nesting (an operation triggering
+// bindings during its body) collapse to the innermost scope naturally.
+// Plain stack pointers of the same thread — deliberately NOT raw_ptr<>
+// (these are intra-thread stack references, not heap/partition memory),
+// which is why the chain lives here and not as a class member.
+constexpr int kMaxScopeDepth = 64;
+thread_local XTraceGeneratedScope* t_scope_stack[kMaxScopeDepth] = {};
+thread_local int t_scope_depth = 0;
+
+// P5-R2a (chief review): beyond the depth bound the inner scopes are
+// UNMARKABLE — marks are dropped and counted, never written onto the
+// outer stack top (the old behavior bled inner arg-errors onto an
+// unrelated outer scope's outcome).
+void CountScopeOverflowGap() {
+  XTraceThreadProducer* producer =
+      XTraceThreadProducer::CurrentIfExists();
+  if (producer != nullptr) {
+    producer->RecordScopeOverflow();
+    return;
+  }
+  XTraceProducerHub::Get()->RecordScopeOverflowNoProducer();
+}
+
+void PushScopeStack(XTraceGeneratedScope* scope) {
+  if (t_scope_depth < kMaxScopeDepth) {
+    t_scope_stack[t_scope_depth] = scope;
+  } else {
+    CountScopeOverflowGap();
+  }
+  ++t_scope_depth;
+}
+
+void PopScopeStack(XTraceGeneratedScope* scope) {
+  if (t_scope_depth > 0) {
+    --t_scope_depth;
+  }
+}
+
+XTraceGeneratedScope* TopScopeStack() {
+  // Overflow region (depth beyond the stored array) is explicitly
+  // unmarkable: nullptr, never the outermost stored frame.
+  if (t_scope_depth == 0 || t_scope_depth > kMaxScopeDepth) {
+    return nullptr;
+  }
+  return t_scope_stack[t_scope_depth - 1];
+}
+
+std::atomic<uint64_t>& CallTokenSequence() {
+  static std::atomic<uint64_t> sequence{0};
+  return sequence;
+}
+
+// Entry-kind display names for the event payload.
+constexpr const char* kEntryKindNames[] = {
+    "getter", "setter", "overload-dispatcher",
+    "constructor", "nadc-callback", "operation",
+};
+
+bool BindingsInstrumentationEnabled() {
+  return XTraceProducerHub::Get()->ConfigReceived();
+}
+
+bool BindingsPreciseModeSwitch() {
+  // DP5: --xtrace-bindings-precise switch. Independent from and stackable
+  // with --xtrace-ignition-observer (bytecode layer). Read once per
+  // process (command line never changes mid-process).
+  static const bool precise =
+      base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "xtrace-bindings-precise");
+  return precise;
+}
+
+}  // namespace
+
+XTraceGeneratedScope::XTraceGeneratedScope(
+    const char* api,
+    EntryKind kind,
+    const char* interface_name,
+    const char* member_name,
+    unsigned overload_count,
+    const v8::FunctionCallbackInfo<v8::Value>& info,
+    bool promise_returning) {
+  if (!BindingsInstrumentationEnabled()) {
+    return;
+  }
+  token_ = ++CallTokenSequence();
+  active_ = true;
+  promise_returning_ = promise_returning;
+
+  // Entry fact emission through the standard v3 pipeline (P5-E3 wiring).
+  // channel is always explicit "bindings" (DP2 ruling) — the logger
+  // handles the envelope, batching, and the category/generation gates.
+  // P5-R5 admission semantics: the scope records whether the entry was
+  // actually admitted; an unadmitted entry never produces an outcome
+  // (no orphan terminal events, no fabricated pairs).
+  entry_admitted_ = XTraceLogger::LogGeneratedEntry(
+      api, kEntryKindNames[static_cast<unsigned>(kind)], interface_name,
+      member_name, overload_count, token_);
+  (void)info;  // receiver/args capture is E4 value-capture work
+
+  PushScopeStack(this);
+}
+
+XTraceGeneratedScope::XTraceGeneratedScope(
+    const char* api,
+    EntryKind kind,
+    const char* interface_name,
+    const char* member_name,
+    unsigned overload_count,
+    bool promise_returning) {
+  // NADC/Fast API variant (no FunctionCallbackInfo). Constructed AFTER
+  // the unconditional API call behind a passed TryEnter() precheck
+  // (P5-R1 ruling shape) — see make_attribute_set_nadc_* and
+  // make_no_alloc_direct_call_* in bind_gen.
+  if (!BindingsInstrumentationEnabled()) {
+    return;
+  }
+  token_ = ++CallTokenSequence();
+  active_ = true;
+  promise_returning_ = promise_returning;
+  entry_admitted_ = XTraceLogger::LogGeneratedEntry(
+      api, kEntryKindNames[static_cast<unsigned>(kind)], interface_name,
+      member_name, overload_count, token_);
+  PushScopeStack(this);
+}
+
+XTraceGeneratedScope::~XTraceGeneratedScope() {
+  // RAII completion: records the terminal outcome for this entry. For
+  // promise-returning operations the destructor fires when the SYNCHRONOUS
+  // callback returns (settlement is post-P5 by ruling); the outcome
+  // records the synchronous phase only. The selected overload index (when
+  // a dispatcher routed) rides the same paired event — one entry, one
+  // terminal fact, routing included (DP1: no second entry event).
+  if (active_) {
+    active_ = false;
+    PopScopeStack(this);
+    if (entry_admitted_) {
+      XTraceLogger::LogGeneratedOutcome(token_, outcome_,
+                                        selected_overload_,
+                                        promise_returning_);
+    }
+  }
+}
+
+void XTraceGeneratedScope::SetOutcome(const char* outcome) {
+  outcome_ = outcome;
+}
+
+// static
+void XTraceGeneratedScope::MarkOutcome(const char* outcome) {
+  XTraceGeneratedScope* scope = TopScopeStack();
+  if (scope != nullptr && scope->active_) {
+    scope->outcome_ = outcome ? outcome : "unknown";
+    return;
+  }
+  // No attributable scope (none active, or the overflow region):
+  // count the gap — never write onto an unrelated outer scope.
+  CountScopeOverflowGap();
+}
+
+void XTraceGeneratedScope::RecordOverload(unsigned selected_index) {
+  if (!active_) {
+    return;
+  }
+  // Routing fact for the in-flight entry: the 0-based overload index is
+  // carried by the paired outcome event (token join), keeping the entry
+  // event single and immutable (DP1 hard rule).
+  selected_overload_ = static_cast<int>(selected_index);
+}
+
+namespace {
+
+// P5-R1/R5 accounting policy: rejections are only counted while a
+// capture is actually active — a capture-off or stopped process must not
+// grow an unsettlable counter (chief review R1).
+bool CaptureAccountingActive() {
+  XTraceProducerHub* hub = XTraceProducerHub::Get();
+  return hub->ConfigReceived() && !hub->stopping();
+}
+
+}  // namespace
+
+// static
+bool XTraceGeneratedScope::TryEnter() {
+  // P5-R1 precheck: no side effects in the reject path. Capture-off and
+  // stopped states answer false WITHOUT touching the producer. With an
+  // active capture, a producer is (lazily) legitimate; BufferHasRoom
+  // reserves headroom for the entry+outcome pair plus reentrancy.
+  if (!CaptureAccountingActive()) {
+    return false;
+  }
+  XTraceThreadProducer* producer = XTraceThreadProducer::Current();
+  if (producer == nullptr) {
+    return false;
+  }
+  return producer->BufferHasRoom();
+}
+
+// static
+bool XTraceGeneratedScope::BindingsPreciseMode() {
+  return BindingsPreciseModeSwitch();
+}
+
+// static
+void XTraceGeneratedScope::MarkNadcPartial() {
+  // P5-R1 accounting: only an ACTIVE capture counts rejections, and the
+  // reject path never initializes a producer (CurrentIfExists).
+  if (!CaptureAccountingActive()) {
+    return;
+  }
+  XTraceThreadProducer* producer =
+      XTraceThreadProducer::CurrentIfExists();
+  if (producer != nullptr) {
+    producer->RecordNadcPartial();
+    return;
+  }
+  XTraceProducerHub::Get()->RecordNadcPartialNoProducer();
+}
+
+}  // namespace blink::xtrace
