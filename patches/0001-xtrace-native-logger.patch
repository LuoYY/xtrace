--- /dev/null
+++ b/content/browser/xtrace/xtrace.pdl
@@ -0,0 +1,123 @@
+# Copyright 2026 The XTrace Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in Chromium's LICENSE file.
+
+version
+  major 1
+  minor 0
+
+# XTrace capture control plane (browser-only; schema v3 artifacts).
+# Ruled design: docs/chromium-p3-design.md v1.1 (R1 amendments incorporated:
+# unknown counters use optional fields; every capture starts at
+# generation "0", updateCapture serially from "1").
+
+experimental domain XTrace
+  depends on IO
+
+  type CaptureState extends string
+    enum
+      idle
+      starting
+      active
+      stopping
+      complete
+      incomplete
+      failed
+
+  experimental type ProducerStatus extends object
+    properties
+      string producerId
+      string kind
+      # Unknown (unconfirmed producer) producer-side counters are absent —
+      # the same rule as v3 manifest null (v1.2 §7); no "" sentinels.
+      optional string finalProducerSeq
+      optional string eligible
+      optional string enqueued
+      optional string dropped
+      string accepted
+      string written
+      string failed
+      boolean confirmed
+
+  experimental type ObserverScope extends object
+    properties
+      # N3-part2 selector (design docs/chromium-p4-scope-selector-design.md):
+      # URL-substring pattern lists over two non-interchangeable
+      # namespaces; empty list = namespace fully selected. denyInternal
+      # makes the internal-scheme exclusion explicit configuration.
+      array of string contexts
+      array of string scripts
+      boolean denyInternal
+
+  experimental type TerminalInfo extends object
+    properties
+      CaptureState state
+      optional string reason
+      array of string unconfirmedProducers
+
+  experimental type Capabilities extends object
+    properties
+      integer schemaVersion
+      array of string modes
+      array of string launchTimeConfig
+      array of string runtimeConfig
+      object limits
+      boolean trustedOnly
+
+  # Returns schema version, modes, observable paths and limits. The output
+  # is the authoritative source for Host capability negotiation.
+  experimental command getCapabilities
+    returns
+      Capabilities capabilities
+
+  # Starts a capture. Initial generation is always "0" for every capture
+  # (launch-time or runtime-created alike); updateCapture continues from "1".
+  experimental command startCapture
+    parameters
+      string categories
+      optional string captureValues
+      optional string captureAssets
+      optional string causality
+      # P4-E4 (design §4): mode/tier; conflict matrix enforced by the
+      # browser (authoritative layer).
+      optional string mode
+      optional string tier
+    returns
+      string captureId
+      string generation
+      CaptureState state
+      # The ACTUALLY effective configuration — machine-readable V14
+      # lesson (flag names are not tier truth).
+      object effectiveConfig
+
+  # Runtime filter update; serially allocated generation from "1".
+  # Confirmation evidence is each event's config_generation field; a
+  # producer listed in pendingProducers is registered but has not yet
+  # emitted an event on the new generation — silence is not a failure.
+  experimental command updateCapture
+    parameters
+      string categories
+      # N3-part2: the observer scope selector rides the same generation
+      # snapshot; omitted = keep the current scope.
+      optional ObserverScope observerScope
+    returns
+      string generation
+      array of string appliedProducers
+      array of string pendingProducers
+
+  experimental command getCaptureStatus
+    returns
+      string captureId
+      string generation
+      CaptureState state
+      object config
+      array of ProducerStatus producers
+      optional TerminalInfo terminal
+
+  # Idempotent stop. Returns stopping or an already-reached terminal state;
+  # never promises complete early. manifestStream is an IO handle created
+  # once the artifacts are settled (IO.read/IO.close).
+  experimental command stopCapture
+    returns
+      CaptureState state
+      optional string manifestStream
