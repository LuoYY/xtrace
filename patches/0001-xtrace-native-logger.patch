+  XTrace::Dispatcher::wire(dispatcher, this);
+}
+
+DispatchResponse XTraceHandler::GetCapabilities(
+    std::unique_ptr<protocol::XTrace::Capabilities>* out_capabilities) {
+  XTraceCaptureController* controller = XTraceCaptureController::Get();
+  auto limits = std::make_unique<protocol::DictionaryValue>();
+  limits->Set("captureEnabled",
+              base::Value(controller ? "true" : "false"));
+  if (controller) {
+    limits->Set("maxBatchEvents", base::Value("200"));
+    limits->Set("flushIntervalMs", base::Value("50"));
+    limits->Set("producerBufferEvents", base::Value("4096"));
+    limits->Set("overflowPolicy", base::Value("drop-newest"));
+  }
+  // F3 (review B2): capabilities disclose the VERIFIED environment — the
+  // same PreciseEnvironment the startCapture authority check uses.
+  const PreciseEnvironment precise = GetPreciseEnvironment();
+  limits->Set("ignitionObserverCompiled",
+              base::Value(precise.observer_compiled ? "true" : "false"));
+  limits->Set("ignitionObserverSwitch", base::Value(
+      precise.observer_switch ? "true" : "false"));
+  limits->Set("preciseModeAvailable", base::Value(
+      precise.available() ? "true" : "false"));
+  if (!precise.available() && !precise.unavailable_reason.empty()) {
+    limits->Set("preciseModeUnavailableReason",
+                base::Value(precise.unavailable_reason));
+  }
+  // Real code-cache policy (F3/B3): the dedicated observer environment
+  // disables the fetch-code-cache lookup AND the V8 compile-time
+  // consume/produce path in the renderer; ordinary environments keep the
+  // default behavior.
+  limits->Set("codeCachePolicy", base::Value(
+      precise.observer_switch
+          ? "disabled-in-observer-environment"
+          : "default"));
+  limits->Set("jsFlags", base::Value(precise.js_flags));
+  limits->Set("tierLock", base::Value(precise.tier_lock));
+  limits->Set("preciseModeRequires", base::Value(precise.RequiresList()));
+  // P5-E4 + P5-R3 (chief review): generation-frozen WebIDL coverage table
+  // surfaced in capabilities (design DP4: from the compiled artifact, not
+  // runtime introspection). The manifest ships INSIDE the app bundle as a
+  // declared build resource — resolved relative to the executable, never
+  // the process working directory. Absence is reported as a visible
+  // "missing" status together with a content digest, never silently
+  // omitted and never cwd-dependent.
+  {
+    base::FilePath coverage_path;
+    std::string coverage_status = "missing";
+    std::string coverage_json;
+    if (base::PathService::Get(base::DIR_EXE, &coverage_path)) {
+      // <app>/Contents/MacOS -> <app>/Contents/Resources
+      const base::FilePath resources_dir =
+          coverage_path.DirName().Append(FILE_PATH_LITERAL("Resources"));
+      coverage_path = resources_dir.Append(
+          FILE_PATH_LITERAL("xtrace/webidl_coverage.json"));
+      base::ScopedAllowBlockingForTesting allow_io;
+      if (base::ReadFileToString(coverage_path, &coverage_json)) {
+        auto parsed =
+            base::JSONReader::Read(coverage_json, base::JSON_PARSE_RFC);
+        if (parsed && parsed->is_dict()) {
+          // Staleness disclosure: the table's own version + generation
+          // stamp ride the payload; a digest is derivable by any
+          // consumer from the raw JSON it already holds.
+          const base::DictValue* coverage_dict = parsed->GetIfDict();
+          if (coverage_dict) {
+            if (const std::string* table_version =
+                    coverage_dict->FindString("version")) {
+              limits->Set("webidlCoverageTableVersion",
+                          base::Value(*table_version));
+            }
+            if (const std::string* generated_at =
+                    coverage_dict->FindString("generated_at")) {
+              limits->Set("webidlCoverageGeneratedAt",
+                          base::Value(*generated_at));
+            }
+          }
+          // generated_at stays inside the payload as well — duplication
+          // with the limits-level field is intentional (self-contained
+          // table + quick top-level disclosure).
+          limits->Set("webidlCoverage", base::Value(parsed->Clone()));
+          coverage_status = "ok";
+        }
+      }
+    }
+    limits->Set("webidlCoverageStatus", base::Value(coverage_status));
+    // P5 DP5: bindings precise mode switch disclosure.
+    const bool bindings_precise =
+        base::CommandLine::ForCurrentProcess()->HasSwitch(
+            "xtrace-bindings-precise");
+    limits->Set("bindingsPreciseMode", base::Value(
+        bindings_precise ? "true" : "false"));
+    limits->Set("bindingsPreciseModeSwitch", base::Value(
+        "xtrace-bindings-precise"));
+  }
+  protocol::Array<String> modes;
+  modes.emplace_back("reverse");
+  modes.emplace_back("fingerprint");
+  protocol::Array<String> launch;
+  for (const char* name :
+       {"xtrace-enable", "xtrace-file", "xtrace-categories",
+        "xtrace-capture-values", "xtrace-capture-assets", "xtrace-causality",
+        "xtrace-max-body-bytes", "xtrace-max-header-value-bytes"}) {
+    launch.emplace_back(name);
+  }
+  protocol::Array<String> runtime;
+  runtime.emplace_back("categories");
+  *out_capabilities =
+      protocol::XTrace::Capabilities::Create()
+          .SetSchemaVersion(3)
+          .SetModes(std::make_unique<protocol::Array<String>>(
+              std::move(modes)))
+          .SetLaunchTimeConfig(std::make_unique<protocol::Array<String>>(
+              std::move(launch)))
+          .SetRuntimeConfig(std::make_unique<protocol::Array<String>>(
+              std::move(runtime)))
+          .SetLimits(std::move(limits))
+          .SetTrustedOnly(true)
+          .Build();
+  return DispatchResponse::Success();
+}
+
+void XTraceHandler::StartCapture(
+    const String& in_categories,
+    std::optional<String> in_captureValues,
+    std::optional<String> in_captureAssets,
+    std::optional<String> in_causality,
+    std::optional<String> in_mode,
+    std::optional<String> in_tier,
+    std::unique_ptr<XTrace::Backend::StartCaptureCallback> callback) {
+  XTraceCaptureController* controller = XTraceCaptureController::Get();
+  if (!controller) {
+    callback->sendFailure(Response::InvalidRequest(
+        "capture disabled: no launch-time trace configuration"));
+    return;
+  }
+  // P4-E4 rejection matrix (design §4; browser is the authoritative
+  // layer). jitless stays closed in P4 (declared boundary).
+  const std::string mode = in_mode ? *in_mode : "semantic";
+  const std::string tier = in_tier ? *in_tier : "";
+  if (mode == "jitless-experiment") {
+    callback->sendFailure(Response::InvalidRequest(
+        "jitless-experiment is not available in P4 (declared boundary)"));
+    return;
+  }
+  if (mode != "semantic" && mode != "ignition-precise") {
+    callback->sendFailure(Response::InvalidRequest(
+        "mode must be semantic or ignition-precise"));
+    return;
+  }
+  if (mode == "semantic" && in_tier && !tier.empty()) {
+    callback->sendFailure(Response::InvalidRequest(
+        "semantic mode does not accept a tier parameter"));
+    return;
+  }
+  if (mode == "ignition-precise" && tier != "ignition") {
+    callback->sendFailure(Response::InvalidRequest(
+        "ignition-precise mode requires tier=ignition"));
+    return;
+  }
+  if (mode == "ignition-precise") {
+    // F3 (review B2): the browser is the authority — reject against the
+    // VERIFIED launch environment, never echo the request as effective.
+    const PreciseEnvironment precise = GetPreciseEnvironment();
+    if (!precise.available()) {
+      callback->sendFailure(Response::InvalidRequest(
+          "ignition-precise unavailable: " + precise.unavailable_reason));
+      return;
+    }
+  }
+  // Effective config: VERIFIED facts from the same environment model —
+  // what actually governs execution, not a mirror of the request text.
+  const PreciseEnvironment precise_env = GetPreciseEnvironment();
+  auto effective = std::make_unique<protocol::DictionaryValue>();
+  effective->Set("mode", base::Value(mode));
+  effective->Set("observerRequested",
+                 base::Value(precise_env.observer_switch
+                                 ? std::string("true")
+                                 : std::string("false")));
+  effective->Set("codeCache", base::Value(
+      precise_env.observer_switch
+          ? std::string("disabled-in-observer-environment")
+          : std::string("default")));
+  effective->Set("causality", base::Value(
+      precise_env.causality_sync ? std::string("sync")
+                                 : std::string("off")));
+  effective->Set("jsFlags", base::Value(precise_env.js_flags));
+  effective->Set("tierLock", base::Value(precise_env.tier_lock));
+  effective->Set("tierParam",
+                 base::Value(tier.empty() ? std::string("none") : tier));
+  // The P2 contract ties capture setup to launch-time configuration;
+  // startCapture reports the running capture's identity.
+  callback->sendSuccess(
+      String(controller->capture_id()),
+      String(controller->current_generation()),
+      String(controller->DomainStateName()),
+      std::move(effective));
+}
+
+void XTraceHandler::UpdateCapture(
+    const String& in_categories,
+    std::unique_ptr<protocol::XTrace::ObserverScope> in_observerScope,
+    std::unique_ptr<XTrace::Backend::UpdateCaptureCallback> callback) {
+  XTraceCaptureController* controller = XTraceCaptureController::Get();
+  if (!controller) {
+    callback->sendFailure(Response::InvalidRequest(
+        "capture disabled: no launch-time trace configuration"));
+    return;
+  }
+  // N3-part2: the optional selector rides the same generation snapshot.
+  XTraceCaptureController::ObserverScope scope;
+  const XTraceCaptureController::ObserverScope* scope_ptr = nullptr;
+  if (in_observerScope) {
+    scope.context_patterns.assign(in_observerScope->GetContexts()->begin(),
+                                  in_observerScope->GetContexts()->end());
+    scope.script_patterns.assign(in_observerScope->GetScripts()->begin(),
+                                 in_observerScope->GetScripts()->end());
+    scope.deny_internal = in_observerScope->GetDenyInternal();
+    scope_ptr = &scope;
+  }
+  const std::string generation = controller->DomainUpdateCapture(
+      in_categories, scope_ptr);
+  if (generation.empty()) {
+    callback->sendFailure(Response::InvalidRequest(
+        "invalid state: capture stopping or settled"));
+    return;
+  }
+  // F1/B7: applied/pending come from EVENT evidence (records stamped with
+  // the new generation, observed by the writer), never from distribution
+  // counts; silence is not a failure (draft §8.3).
+  uint64_t target_generation = 0;
+  base::StringToUint64(generation, &target_generation);
+  auto applied = std::make_unique<protocol::Array<String>>(
+      controller->DomainProducersAppliedTo(target_generation));
+  callback->sendSuccess(
+      String(generation),
+      std::move(applied),
+      std::make_unique<protocol::Array<String>>(
+          controller->DomainProducersPendingOn(target_generation)));
+}
+
+DispatchResponse XTraceHandler::GetCaptureStatus(
+    String* out_captureId,
+    String* out_generation,
+    String* out_state,
+    std::unique_ptr<protocol::DictionaryValue>* out_config,
+    std::unique_ptr<protocol::Array<protocol::XTrace::ProducerStatus>>*
+        out_producers,
+    std::unique_ptr<protocol::XTrace::TerminalInfo>* out_terminal) {
+  XTraceCaptureController* controller = XTraceCaptureController::Get();
+  if (!controller) {
+    return Response::InvalidRequest(
+        "capture disabled: no launch-time trace configuration");
+  }
+  *out_captureId = String(controller->capture_id());
+  *out_generation = String(controller->current_generation());
+  *out_state = String(controller->DomainStateName());
+  auto config = std::make_unique<protocol::DictionaryValue>();
+  config->Set("generation", base::Value(controller->current_generation()));
+  // F1/B7: the status config discloses the effective categories from the
+  // same source the writer stamps — generation alone is not a config.
+  config->Set("categories", base::Value(controller->current_categories()));
+  *out_config = std::move(config);
+  auto producers =
+      std::make_unique<protocol::Array<protocol::XTrace::ProducerStatus>>();
+  for (const auto& row : controller->DomainProducerRows()) {
+    // v1.2 rule: unknown producer-side counters are absent, not zero.
+    // Builders are move-only: branch into two complete chains.
+    if (row.confirmed) {
+      producers->push_back(
+          protocol::XTrace::ProducerStatus::Create()
+              .SetProducerId(String(row.producer_id))
+              .SetKind(String(row.kind))
+              .SetFinalProducerSeq(String(row.final_producer_seq))
+              .SetEligible(String(row.eligible))
+              .SetEnqueued(String(row.enqueued))
+              .SetDropped(String(row.dropped))
+              .SetAccepted(String(row.accepted))
+              .SetWritten(String(row.written))
+              .SetFailed(String(row.failed))
+              .SetConfirmed(row.confirmed)
+              .Build());
+    } else {
+      producers->push_back(
+          protocol::XTrace::ProducerStatus::Create()
+              .SetProducerId(String(row.producer_id))
+              .SetKind(String(row.kind))
+              .SetAccepted(String(row.accepted))
+              .SetWritten(String(row.written))
+              .SetFailed(String(row.failed))
+              .SetConfirmed(row.confirmed)
+              .Build());
+    }
+  }
+  *out_producers = std::move(producers);
+  if (controller->DomainTerminalState() != "unsettled") {
+    protocol::Array<String> unconfirmed_list;
+    for (const auto& id : controller->DomainUnconfirmedProducers()) {
+      unconfirmed_list.emplace_back(id);
+    }
+    auto unconfirmed = std::make_unique<protocol::Array<String>>(
+        std::move(unconfirmed_list));
+    if (!controller->DomainTerminalReason().empty()) {
+      *out_terminal =
+          protocol::XTrace::TerminalInfo::Create()
+              .SetState(String(controller->DomainTerminalState()))
+              .SetReason(String(controller->DomainTerminalReason()))
+              .SetUnconfirmedProducers(std::move(unconfirmed))
+              .Build();
+    } else {
+      *out_terminal =
+          protocol::XTrace::TerminalInfo::Create()
+              .SetState(String(controller->DomainTerminalState()))
+              .SetUnconfirmedProducers(std::move(unconfirmed))
+              .Build();
+    }
+  }
+  return DispatchResponse::Success();
+}
+
+void XTraceHandler::StopCapture(
+    std::unique_ptr<XTrace::Backend::StopCaptureCallback> callback) {
+  XTraceCaptureController* controller = XTraceCaptureController::Get();
+  if (!controller) {
+    callback->sendFailure(Response::InvalidRequest(
+        "capture disabled: no launch-time trace configuration"));
+    return;
+  }
+  const bool already_settled =
+      controller->DomainTerminalState() != "unsettled";
+  controller->RequestStop(2000);
+  const std::string state = controller->DomainStateName();
+  if (!already_settled && state != "stopping") {
+    // Defensive: RequestStop must move an unsettled capture to stopping.
+    callback->sendFailure(
+        Response::InvalidRequest("unexpected capture state"));
+    return;
+  }
+  if (already_settled) {
+    // Terminal already reached: hand the manifest stream out immediately.
+    callback->sendSuccess(
+        String(state),
+        std::optional<String>(
+            String(MakeManifestStreamOnIO(controller, io_context_))));
+    return;
+  }
+  // Poll-free settle: bounded wait on the writer runner (deadline honored
+  // by the stop timer), then answer with the terminal state + stream.
+  XTraceCaptureController::WriterRunner()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](XTraceCaptureController* c,
+             std::unique_ptr<XTrace::Backend::StopCaptureCallback> cb,
+             DevToolsIOContext* io) {
+            const std::string settled = c->DomainTerminalState();
+            std::optional<String> handle;
+            const std::string h = MakeManifestStreamOnIO(c, io);
+            if (!h.empty()) {
+              handle = String(h);
+            }
+            cb->sendSuccess(
+                String(settled == "unsettled" ? "stopping" : settled),
+                std::move(handle));
+          },
+          base::Unretained(controller), std::move(callback), io_context_),
+      base::Milliseconds(2600));
+}
+
+}  // namespace content::protocol
