+// F2 (review B2-4/B5): the single supported V8 boundary — function
+// declarations with primitive signatures. No V8 struct layout is mirrored
+// in content; compile truth is the RETURN VALUE of IgnitionObserverIs
+// Compiled(), never a symbol's address.
+namespace v8 {
+namespace internal {
+namespace xtrace {
+bool IgnitionObserverIsCompiled();
+}  // namespace xtrace
+}  // namespace internal
+}  // namespace v8
+
+namespace content::protocol {
