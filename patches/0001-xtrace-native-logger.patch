new file mode 100644
index 0000000000..5ddb033146
--- /dev/null
+++ b/third_party/blink/renderer/platform/xtrace/xtrace_generated_scope.h
@@ -0,0 +1,122 @@
+// Copyright 2026 The XTrace Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in Chromium's LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_XTRACE_XTRACE_GENERATED_SCOPE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_XTRACE_XTRACE_GENERATED_SCOPE_H_
+
+#include <cstdint>
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "v8/include/v8-function-callback.h"
+
+namespace v8 {
+template <typename T>
+class FunctionCallbackInfo;
+}
+
+namespace blink::xtrace {
+
+// P5-E2 (design §DP1): generated-callback entry scope. Injected by bind_gen
+// at the six logical entry kinds (three physical sites). One call chain
+// produces exactly ONE entry event — the overload dispatcher records
+// routing facts; the selected implementation only appends signature
+// detail via RecordOverload().
+//
+// The FIRST_BATCH set is decided at GENERATION time: bind_gen only emits
+// the scope construction for instrumented interfaces, so non-first-batch
+// interfaces carry zero overhead (no code emitted at all).
+class PLATFORM_EXPORT XTraceGeneratedScope {
+ public:
+  enum EntryKind : uint8_t {
+    kGetter = 0,
+    kSetter = 1,
+    kOverloadDispatcher = 2,
+    kConstructor = 3,
+    kNadcCallback = 4,
+    kOperation = 5,
+  };
+
+  // The single constructor shape for all six entry kinds (every generated
+  // callback uses v8::FunctionCallbackInfo<v8::Value> in this tree).
+  // `api` is the fully-qualified name (e.g. "URL.constructor",
+  // "Element.scroll"); `overload_count` is the number of overloads for
+  // dispatchers/constructors, 0 for single-signature entries.
+  // `promise_returning` marks promise-returning entries so the paired
+  // outcome distinguishes "sync exception converts to a rejection" from a
+  // plain throw (chief review R2: never mix the two classes).
+  XTraceGeneratedScope(const char* api,
+                       EntryKind kind,
+                       const char* interface_name,
+                       const char* member_name,
+                       unsigned overload_count,
+                       const v8::FunctionCallbackInfo<v8::Value>& info,
+                       bool promise_returning = false);
+
+  // Fast API / NADC variant: [NoAllocDirectCall] callbacks have no
+  // FunctionCallbackInfo. Identical semantics otherwise; only constructed
+  // AFTER the unconditional API call behind a passed TryEnter() precheck
+  // (P5-R1 ruling shape: API first, observation conditional).
+  XTraceGeneratedScope(const char* api,
+                       EntryKind kind,
+                       const char* interface_name,
+                       const char* member_name,
+                       unsigned overload_count,
+                       bool promise_returning = false);
+
+  ~XTraceGeneratedScope();
+
+  XTraceGeneratedScope(const XTraceGeneratedScope&) = delete;
+  XTraceGeneratedScope& operator=(const XTraceGeneratedScope&) = delete;
+
+  // Called by overload-dispatcher generated bodies after the branch is
+  // selected; appends routing facts to the already-emitted entry event
+  // (does NOT create a second event — DP1 hard rule). The selected index
+  // (0-based, IDL declaration order) rides the paired outcome event.
+  void RecordOverload(unsigned selected_index);
+
+  // E3: set the terminal outcome (default "ok" in destructor). Called by
+  // generated code at exception/early-return points; if never called the
+  // destructor records "ok".
+  void SetOutcome(const char* outcome);
+
+  // Path-classified outcome marking for generated code (P5 review fix 2).
+  // Static so overload bodies — separate functions from the dispatcher
+  // holding the scope — can mark the innermost ACTIVE scope through a
+  // thread-local chain. No allocation, no V8 API re-entry; safe to call
+  // from any generated error path. No-op when no scope is active
+  // (non-first-batch interfaces emit no call sites at all).
+  static void MarkOutcome(const char* outcome);
+
+  // NADC/no-alloc entry precheck (design §DP1 + §9 ruling): returns true
+  // when the bounded-buffer path can accept an event without allocating.
+  // Must be called before ANY allocation in the callback. When false the
+  // entry is marked partial in the coverage bookkeeping — never forced.
+  static bool TryEnter();
+
+  // P5-R3 (chief review): the REAL bindings-precise predicate — consumed
+  // by generated code to gate first-batch fast-entry installation
+  // (precise mode keeps every call on the instrumented slow path) and by
+  // the capabilities surface to report the effective state, not just the
+  // switch name.
+  static bool BindingsPreciseMode();
+
+  // DP1 ruling condition: when TryEnter() rejects an NADC entry (buffer
+  // cannot accommodate), the fact is accounted — never silently dropped.
+  // Allocation-free atomic increment on the owning thread producer's
+  // settlement counters; falls back to a hub-level counter when no thread
+  // producer exists yet.
+  static void MarkNadcPartial();
+
+ private:
+  uint64_t token_ = 0;
+  bool active_ = false;
+  bool entry_admitted_ = false;  // entry accepted by the producer
+  bool promise_returning_ = false;
+  const char* outcome_ = "ok";
+  int selected_overload_ = -1;  // set by RecordOverload; -1 = not routed
+};
+
+}  // namespace blink::xtrace
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_XTRACE_XTRACE_GENERATED_SCOPE_H_
diff --git a/third_party/blink/renderer/platform/xtrace/xtrace_producer.cc b/third_party/blink/renderer/platform/xtrace/xtrace_producer.cc
