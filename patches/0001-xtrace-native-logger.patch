+def make_xtrace_scope(cg_context, entry_kind):
+    """P5-E2: emit the XTraceGeneratedScope construction for first-batch
+    interfaces only. entry_kind maps to the six logical entry kinds."""
+    assert isinstance(cg_context, CodeGenContext)
+    assert entry_kind in (
+        "getter", "setter", "overload-dispatcher", "constructor",
+        "nadc-callback", "operation")
