+TEST_F(XTraceProducerTest, EffectiveConfigSnapshotSwapsAtomically) {
+  // F1/B7: SetCurrentConfig publishes ONE immutable snapshot; generation
+  // and categories move together so an event can never mix the old
+  // filter with the new stamp (or vice versa).
+  auto before = XTraceProducerHub::Get()->SnapshotConfig();
+  ASSERT_TRUE(before);
+  EXPECT_EQ(before->generation, "0");
+  EXPECT_FALSE(before->categories.empty());  // launch default
+  XTraceProducerHub::Get()->SetCurrentConfig("7", "fingerprint", {});
+  auto after = XTraceProducerHub::Get()->SnapshotConfig();
+  ASSERT_TRUE(after);
+  EXPECT_EQ(after->generation, "7");
+  EXPECT_EQ(after->categories, "fingerprint");
+  // The earlier snapshot is immutable — holders keep a consistent view.
+  EXPECT_EQ(before->generation, "0");
+  EXPECT_NE(before->categories, after->categories);
+  EXPECT_EQ(XTraceProducerHub::Get()->current_generation(), "7");
+}
+
+// P5 review fix 5 (DP1 ruling condition): the NADC TryEnter partial path.
+// A buffer that cannot accommodate must reject the precheck and ACCOUNT the
+// rejected entry — never crash, never silently drop.
+TEST_F(XTraceProducerTest, NadcTryEnterRejectsWhenBufferFull) {
+  XTraceThreadProducer::SetHostFactoryForTesting(base::BindRepeating(
+      [](FakeXTraceHost* h) { return static_cast<blink::mojom::XTraceHost*>(h); },
+      base::Unretained(&host_)));
+  base::Thread thread("xtrace-nadc-full");
+  ASSERT_TRUE(thread.Start());
+  thread.task_runner()->PostTask(FROM_HERE, base::BindOnce([]() {
+    XTraceProducerHub* hub = XTraceProducerHub::Get();
+    hub->SetBufferCapacityForTesting(2);
+    XTraceThreadProducer* p = XTraceThreadProducer::Current();
+    ASSERT_TRUE(p);
+    // Fresh bounded buffer: the allocation-free precheck accepts.
+    EXPECT_TRUE(p->BufferHasRoom());
+    // Fill to capacity: the precheck must now reject — this is the state
+    // an NADC fast callback observes before deciding to instrument.
+    ASSERT_TRUE(p->AcceptEvent("{\"api\":\"a\"}", "0").has_value());
+    ASSERT_TRUE(p->AcceptEvent("{\"api\":\"b\"}", "0").has_value());
+    EXPECT_FALSE(p->BufferHasRoom());
+    // The rejected path accounts through the partial counter (what
+    // XTraceGeneratedScope::MarkNadcPartial does on this thread) instead
+    // of forcing an event through the no-allocation protocol.
+    p->RecordNadcPartial();
+    p->RecordNadcPartial();
+    EXPECT_EQ(p->nadc_partial(), 2u);
+    // No crash, and the buffer state is unchanged by the accounting.
+    EXPECT_FALSE(p->BufferHasRoom());
+  }));
+  thread.Stop();  // thread teardown settles -> watermark
+  XTraceThreadProducer::SetHostFactoryForTesting({});
+
+  // Settlement carries the partial count with the same closure discipline
+  // as eligible/enqueued/dropped — the rejected entries are traceable in
+  // the manifest, not lost.
+  ASSERT_EQ(host_.watermark_count(), 1u);
+  auto wm = host_.last_watermark();
+  EXPECT_EQ(DecOrZero(wm->eligible), 2u);
+  EXPECT_EQ(DecOrZero(wm->nadc_partial), 2u);
+}
+
+TEST_F(XTraceProducerTest, NadcPartialHubFallbackWithoutProducer) {
+  // Rejections with no thread producer to carry them (MarkNadcPartial's
+  // fallback branch) land on the hub-level counter: accounted, queryable,
+  // and crash-free. (Current() is not probed here: on a capture-enabled
+  // process it lazily creates a producer on the calling thread.)
+  XTraceProducerHub* hub = XTraceProducerHub::Get();
+  const uint64_t before = hub->nadc_partial_no_producer();
+  hub->RecordNadcPartialNoProducer();
+  hub->RecordNadcPartialNoProducer();
+  hub->RecordNadcPartialNoProducer();
+  EXPECT_EQ(hub->nadc_partial_no_producer() - before, 3u);
+}
+
+TEST_F(XTraceProducerTest, BufferHasRoomRejectsAfterSettle) {
+  XTraceThreadProducer::SetHostFactoryForTesting(base::BindRepeating(
+      [](FakeXTraceHost* h) { return static_cast<blink::mojom::XTraceHost*>(h); },
+      base::Unretained(&host_)));
+  base::Thread thread("xtrace-nadc-settled");
+  ASSERT_TRUE(thread.Start());
+  thread.task_runner()->PostTask(FROM_HERE, base::BindOnce([]() {
+    XTraceThreadProducer* p = XTraceThreadProducer::Current();
+    ASSERT_TRUE(p);
+    EXPECT_TRUE(p->BufferHasRoom());
+    p->Settle();
+    // Outside the capture window the precheck must reject — a settled
+    // producer accepts nothing, not even a prechecked NADC entry.
+    EXPECT_FALSE(p->BufferHasRoom());
+  }));
+  thread.Stop();
+  XTraceThreadProducer::SetHostFactoryForTesting({});
+}
+
+TEST_F(XTraceProducerTest, AcceptEventStampsCallerGeneration) {
+  // F1/B7: the identity tail carries the generation passed by the event
+  // entry (its filter snapshot), not a re-read of the hub at accept time.
+  XTraceThreadProducer::SetHostFactoryForTesting(base::BindRepeating(
+      [](FakeXTraceHost* h) { return static_cast<blink::mojom::XTraceHost*>(h); },
+      base::Unretained(&host_)));
+  base::Thread thread("xtrace-genstamp");
+  ASSERT_TRUE(thread.Start());
+  thread.task_runner()->PostTask(FROM_HERE, base::BindOnce([]() {
+    XTraceThreadProducer* p = XTraceThreadProducer::Current();
+    ASSERT_TRUE(p);
+    EXPECT_TRUE(p->AcceptEvent("{\"api\":\"g\"}", "5").has_value());
+    // An update arriving AFTER the entry snapshot must not re-stamp the
+    // already-buffered record (it only affects later events).
+    XTraceProducerHub::Get()->SetCurrentConfig("6", "fingerprint", {});
+  }));
+  thread.Stop();  // settle flushes the buffered line
+  XTraceThreadProducer::SetHostFactoryForTesting({});
+  auto lines = host_.last_batch_lines();
+  ASSERT_EQ(lines.size(), 1u);
+  EXPECT_NE(lines[0].find("\"config_generation\":\"5\""), std::string::npos);
+}
