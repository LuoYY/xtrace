+
+void XTraceAppendCryptoKeyFields(std::string& args,
+                                 const char* prefix,
+                                 CryptoKey* key) {
+  if (!key) {
+    return;
+  }
+  const WebCryptoKey& web_crypto_key = key->Key();
+  XTraceAppendJsonFieldName(args, prefix, "key_id");
+  args.append(std::to_string(XTracePointerId(key)));
+  XTraceAppendJsonFieldName(args, prefix, "key_handle_id");
+  args.append(std::to_string(XTracePointerId(web_crypto_key.Handle())));
+  XTraceAppendJsonFieldName(args, prefix, "key_ref");
+  args.append(XTraceLogger::QuoteJson(
+                  String::FromUtf8(XTraceCryptoKeyRef(web_crypto_key)))
+                  .Utf8());
+  XTraceAppendJsonFieldName(args, prefix, "key_algorithm");
+  args.append(XTraceLogger::QuoteJson(
+                  String(XTraceKeyAlgorithmName(web_crypto_key.Algorithm())))
+                  .Utf8());
+  XTraceAppendJsonFieldName(args, prefix, "key_type");
+  args.append(XTraceLogger::QuoteJson(
+                  String(XTraceKeyTypeName(web_crypto_key.GetType())))
+                  .Utf8());
+  XTraceAppendJsonFieldName(args, prefix, "key_extractable");
+  args.append(key->extractable() ? "true" : "false");
+  XTraceAppendJsonFieldName(args, prefix, "key_usages_mask");
+  args.append(std::to_string(web_crypto_key.Usages()));
