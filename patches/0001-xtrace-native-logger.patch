+String XTraceBroadcastMessageType(const ScriptValue& message) {
+  if (message.IsEmpty()) {
+    return String("empty");
+  }
+  v8::Local<v8::Value> value = message.V8Value();
+  if (value.IsEmpty()) {
+    return String("empty");
+  }
+  if (value->IsUndefined()) {
+    return String("undefined");
+  }
+  if (value->IsNull()) {
+    return String("null");
+  }
+  if (value->IsString()) {
+    return String("string");
+  }
+  if (value->IsBoolean()) {
+    return String("boolean");
+  }
+  if (value->IsNumber()) {
+    return String("number");
+  }
+  if (value->IsBigInt()) {
+    return String("bigint");
+  }
+  if (value->IsArrayBufferView()) {
+    return String("array_buffer_view");
+  }
+  if (value->IsArrayBuffer()) {
+    return String("array_buffer");
+  }
+  if (value->IsArray()) {
+    return String("array");
+  }
+  if (value->IsFunction()) {
+    return String("function");
+  }
+  if (value->IsObject()) {
+    return String("object");
+  }
+  return String("unknown");
+}
+
+String XTraceBroadcastMessageValue(const ScriptValue& message) {
+  if (message.IsEmpty()) {
+    return String();
+  }
+  v8::Local<v8::Value> value = message.V8Value();
+  if (value.IsEmpty()) {
+    return String();
+  }
+  v8::Isolate* isolate = message.GetIsolate();
+  if (value->IsUndefined()) {
+    return String("undefined");
+  }
+  if (value->IsNull()) {
+    return String("null");
+  }
+  if (value->IsString()) {
+    return ToCoreString(isolate, value.As<v8::String>());
+  }
+  if (value->IsBoolean()) {
+    return value.As<v8::Boolean>()->Value() ? String("true") : String("false");
+  }
+  if (value->IsNumber()) {
+    return String::Number(value.As<v8::Number>()->Value());
+  }
+  return String();
+}
+
+String XTraceSerializedDataHex(SerializedScriptValue* serialized) {
+  if (!serialized) {
+    return String();
+  }
+  return String::FromUtf8(base::HexEncode(serialized->GetWireData()));
+}
