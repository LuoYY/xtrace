+class XTraceProducerTest : public ::testing::Test {
+ public:
+  XTraceProducerTest() { XTraceProducerHub::Get()->ResetForTesting(); }
+
+  void SetUp() override {
+    // Capture enabled for this test binary (switches are read per call).
+    base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    cmd->AppendSwitch("xtrace-enable");
+    cmd->AppendSwitchPath("xtrace-file", base::FilePath("/tmp/xtrace-p3e0-test.ndjson"));
+  }
+
+  // Producer tests run each on a fresh thread: the producer is thread_local,
+  // so a fresh thread gives a fresh producer instance and its destruction at
+  // thread stop IS the "thread teardown settles" behavior under test.
+  FakeXTraceHost host_;
+};
+
+TEST_F(XTraceProducerTest, ParseTestCapacitySwitch) {
+  EXPECT_EQ(ParseTestCapacitySwitchForTest(""), 0u);
+  EXPECT_EQ(ParseTestCapacitySwitchForTest("0"), 0u);
+  EXPECT_EQ(ParseTestCapacitySwitchForTest("abc"), 0u);
+  EXPECT_EQ(ParseTestCapacitySwitchForTest("5"), 5u);
+  EXPECT_EQ(ParseTestCapacitySwitchForTest("4096"), 4096u);
+}
+
+TEST_F(XTraceProducerTest, OverflowCountsStickyDropNewest) {
+  XTraceThreadProducer::SetHostFactoryForTesting(base::BindRepeating(
+      [](FakeXTraceHost* h) { return static_cast<blink::mojom::XTraceHost*>(h); },
+      base::Unretained(&host_)));
+  base::Thread thread("xtrace-overflow");
+  ASSERT_TRUE(thread.Start());
+  uint64_t accepted = 0;
+  thread.task_runner()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](XTraceProducerHub* hub, FakeXTraceHost* host,
+                        uint64_t* accepted) {
+                       hub->SetBufferCapacityForTesting(3);
+                       XTraceThreadProducer* p = XTraceThreadProducer::Current();
+                       ASSERT_TRUE(p);
+                       // 3 fill the buffer; 2 overflow (sticky drop-newest).
+                       for (int i = 0; i < 5; ++i) {
+                         auto seq = p->AcceptEvent("{\"api\":\"x\"}", "0");
+                         if (seq) ++*accepted;
+                       }
+                     },
+                     XTraceProducerHub::Get(), &host_, &accepted));
+  thread.Stop();  // destroys the thread-local producer -> Settle() runs.
+  XTraceThreadProducer::SetHostFactoryForTesting({});
+
+  // Contract: an overflowed event still returns its consumed sequence
+  // number (asset rows may reference tail gaps), so all 5 calls returned
+  // a value; the loss is only visible in the counters.
+  EXPECT_EQ(accepted, 5u);
+  // Watermark from the destructor settlement: eligible 5, enqueued 3,
+  // dropped 2, final seq 5 — tail-only gap under drop-newest.
+  ASSERT_EQ(host_.watermark_count(), 1u);
+  auto wm = host_.last_watermark();
+  EXPECT_EQ(DecOrZero(wm->eligible), 5u);
+  EXPECT_EQ(DecOrZero(wm->enqueued), 3u);
+  EXPECT_EQ(DecOrZero(wm->dropped), 2u);
+  EXPECT_EQ(DecOrZero(wm->final_producer_seq), 5u);
+  // The 3 buffered events were flushed as one batch before the watermark.
+  EXPECT_EQ(host_.batch_count(), 1u);
+  EXPECT_EQ(host_.total_batch_lines(), 3u);
+}
+
+TEST_F(XTraceProducerTest, SettleIsIdempotentAndStopsAccepting) {
+  XTraceThreadProducer::SetHostFactoryForTesting(base::BindRepeating(
+      [](FakeXTraceHost* h) { return static_cast<blink::mojom::XTraceHost*>(h); },
+      base::Unretained(&host_)));
+  base::Thread thread("xtrace-settle");
+  ASSERT_TRUE(thread.Start());
+  thread.task_runner()->PostTask(
+      FROM_HERE, base::BindOnce([]() {
+        XTraceThreadProducer* p = XTraceThreadProducer::Current();
+        ASSERT_TRUE(p);
+        EXPECT_TRUE(p->AcceptEvent("{\"api\":\"a\"}", "0").has_value());
+        p->Settle();
+        p->Settle();  // idempotent
+        // After settle: outside the capture window, not counted.
+        EXPECT_FALSE(p->AcceptEvent("{\"api\":\"b\"}", "0").has_value());
+      }));
+  thread.Stop();
+  XTraceThreadProducer::SetHostFactoryForTesting({});
+  ASSERT_EQ(host_.watermark_count(), 1u);
+  auto wm = host_.last_watermark();
+  EXPECT_EQ(DecOrZero(wm->eligible), 1u);
+  EXPECT_EQ(DecOrZero(wm->enqueued), 1u);
+  EXPECT_EQ(DecOrZero(wm->dropped), 0u);
+  EXPECT_EQ(DecOrZero(wm->final_producer_seq), 1u);
+  EXPECT_EQ(host_.total_batch_lines(), 1u);
+}
+
+TEST_F(XTraceProducerTest, StopFlagRejectsNewEvents) {
+  XTraceThreadProducer::SetHostFactoryForTesting(base::BindRepeating(
+      [](FakeXTraceHost* h) { return static_cast<blink::mojom::XTraceHost*>(h); },
+      base::Unretained(&host_)));
+  base::Thread thread("xtrace-stopflag");
+  ASSERT_TRUE(thread.Start());
+  thread.task_runner()->PostTask(FROM_HERE, base::BindOnce([]() {
+    XTraceThreadProducer* p = XTraceThreadProducer::Current();
+    ASSERT_TRUE(p);
+    XTraceProducerHub::Get()->BeginStop();
+    EXPECT_FALSE(p->AcceptEvent("{\"api\":\"late\"}", "0").has_value());
+  }));
+  thread.Stop();
+  XTraceThreadProducer::SetHostFactoryForTesting({});
+  // A thread that never produced an event has no descriptor and therefore
+  // submits NO watermark — the browser only knows producers by their data.
+  EXPECT_EQ(host_.watermark_count(), 0u);
+}
