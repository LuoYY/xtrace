+
+void XTraceCaptureController::FinalizeLocked(const std::string& reason) {
+  if (finalized_.load(std::memory_order_acquire)) {
+    return;
+  }
+  finalized_.store(true, std::memory_order_release);
+  stop_timer_.Stop();
+
+  bool all_confirmed = true;
+  bool equations_hold = true;
+  bool dropped_zero = true;
+  bool failed_zero = true;
+  for (const auto& [id, state] : producers_) {
+    if (!state->watermark_received) {
+      all_confirmed = false;
+      continue;
+    }
+    if (state->eligible != state->enqueued + state->dropped ||
+        state->enqueued != state->accepted ||
+        state->accepted != state->written + state->failed ||
+        state->assets_out !=
+            state->assets_written + state->assets_failed) {
+      equations_hold = false;
+    }
+    if (state->dropped > 0) {
+      dropped_zero = false;
+    }
+    if (state->failed > 0 || state->assets_failed > 0) {
+      failed_zero = false;
+    }
+  }
+
+  // Count equations are the sole terminal judge (handoff §6.7): no
+  // "looks complete" shortcuts.
+  std::string terminal_state;
+  std::string terminal_reason = reason;
+  if (producers_.empty()) {
+    // No producer ever registered: the capture observed nothing; this is a
+    // coverage gap, never a successful settlement.
+    terminal_state = "incomplete";
+    if (terminal_reason.empty()) {
+      terminal_reason = "no-producers-observed";
+    }
+  } else if (!all_confirmed) {
+    terminal_state = "incomplete";
+    if (terminal_reason.empty()) {
+      terminal_reason = "producer-unconfirmed";
+    }
+  } else if (!equations_hold) {
+    terminal_state = "incomplete";
+    if (terminal_reason.empty()) {
+      terminal_reason = "inconsistent-counts";
+    }
+  } else if (dropped_zero && failed_zero && !trace_write_failed_) {
+    terminal_state = "complete";
+    terminal_reason.clear();
+  } else {
+    terminal_state = "incomplete";
+    if (terminal_reason.empty()) {
+      terminal_reason = trace_write_failed_ ? "disk-write-failure"
+                                            : (dropped_zero ? "write-failures"
+                                                            : "dropped>0");
+    }
+  }
+
+  last_terminal_state_ = terminal_state;
+  last_terminal_reason_ = terminal_reason;
+  // P3-E5: the identity crosswalk needs a UI-thread snapshot; the manifest
+  // write is the continuation on the writer runner (sync waits are
+  // forbidden on pool threads). Posting while holding writer_lock_ is
+  // safe; the reply re-acquires it.
+  // The controller has process lifetime (destructor deleted): Unretained
+  // is safe, and WeakPtr would trip its sequence checker on the UI hop.
+  GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](XTraceCaptureController* self,
+             const std::string& state, const std::string& reason) {
+            std::vector<IdentityRow> rows = self->DomainIdentityRows();
+            XTraceCaptureController::WriterRunner()->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    [](XTraceCaptureController* self,
+                       const std::string& state, const std::string& reason,
+                       std::vector<IdentityRow> rows) {
+                      base::AutoLock lock(self->writer_lock_);
+                      self->identity_rows_ = std::move(rows);
+                      self->WriteManifest(state, reason);
+                      self->trace_file_.Close();
+                      self->asset_manifest_file_.Close();
+                    },
+                    self, state, reason, std::move(rows)));
+          },
+          base::Unretained(this), terminal_state, terminal_reason));
+}
+
+std::string XTraceCaptureController::BuildManifestJson(
+    const std::string& terminal_state, const std::string& reason) {
+  // Pure builder: state read under writer_lock_ by both callers (writer
+  // sequence via Finalize; the exiting thread via FinalizeForProcessExit).
+  std::string json;
+  json.append("{\"manifest_version\":3");
+  json.append(",\"schema_version\":3");
+  json.append(",\"capture_id\":" + base::GetQuotedJSONString(capture_id_));
+  json.append(",\"config\":" + config_json_);
+  // F1/B7: the effective config at settlement — after runtime updates the
+  // startup snapshot above stays historical, this is what governed the
+  // tail of the capture (filter + generation from one source).
+  json.append(",\"effective_config\":{\"generation\":" +
+              base::GetQuotedJSONString(status_generation_) +
+              ",\"categories\":" +
+              base::GetQuotedJSONString(status_categories_) + "}");
+  {
+    std::string build_json = ",\"build\":{\"product\":";
+    build_json += base::GetQuotedJSONString(
+        version_info::GetVersionNumber());
+    build_json += ",\"is_debug\":";
+    // F5 (review B6): NDEBUG is the debug-build truth; DCHECK_IS_ON()
+    // conflated debug builds with dcheck-always-on release builds (this
+    // release reported is_debug=true via DCHECKs). Report both axes.
+#if defined(NDEBUG)
+    build_json += "false";
+#else
+    build_json += "true";
+#endif
+    build_json += ",\"dcheck_always_on\":";
+    build_json += DCHECK_IS_ON() ? "true" : "false";
+    build_json += ",\"component_build\":";
+#if defined(COMPONENT_BUILD)
+    build_json += "true";
+#else
+    build_json += "false";
+#endif
+    build_json += "}";
+    json.append(build_json);
+  }
+  json.append(",\"artifacts\":{");
+  json.append("\"trace\":" + base::GetQuotedJSONString(
+                                 trace_file_path_.BaseName().AsUTF8Unsafe()));
+  json.append(",\"asset_manifest\":\"assets/" + trace_stem_ +
+              "/manifest.ndjson\"");
+  json.append(",\"asset_dir\":\"assets/" + trace_stem_ + "/\"");
+  json.append(",\"asset_count\":\"" +
+              base::NumberToString(asset_rows_written_) + "\"}");
+  json.append(",\"batching\":{\"max_batch_events\":\"200\""
+              ",\"flush_interval_ms\":\"50\""
+              ",\"producer_buffer_events\":\"4096\""
+              ",\"overflow_policy\":\"drop-newest\"}");
+  json.append(",\"producers\":[");
+  bool first = true;
+  for (const auto& [id, state] : producers_) {
+    if (!first) {
+      json.append(",");
+    }
+    first = false;
+    json.append("{\"producer_id\":" + base::GetQuotedJSONString(id));
+    json.append(",\"process_epoch\":" +
+                base::GetQuotedJSONString(state->process_epoch));
+    json.append(",\"kind\":" +
+                base::GetQuotedJSONString(
+                    state->pkind == "bnet"
+                        ? std::string("browser-network")
+                        : (state->worker ? state->worker_kind + "-worker"
+                                         : std::string("main-thread"))));
+    // Schema v3 §7 (v1.2): producer-side counters of an unconfirmed
+    // producer are UNKNOWN — emit JSON null, never zero-filled.
+    auto null_or = [](bool confirmed, uint64_t value) -> std::string {
+      return confirmed ? ("\"" + base::NumberToString(value) + "\"")
+                       : std::string("null");
+    };
+    json.append(",\"final_producer_seq\":" +
+                null_or(state->watermark_received,
+                        state->final_producer_seq));
+    json.append(",\"eligible\":" +
+                null_or(state->watermark_received, state->eligible) +
+                ",\"enqueued\":" +
+                null_or(state->watermark_received, state->enqueued) +
+                ",\"dropped\":" +
+                null_or(state->watermark_received, state->dropped) +
+                ",\"assets_out\":" +
+                null_or(state->watermark_received, state->assets_out) +
+                // DP1 (P5): NADC entries rejected by the TryEnter precheck —
+                // reported alongside the drop counters, same null discipline
+                // for unconfirmed producers.
+                ",\"nadc_partial\":" +
+                null_or(state->watermark_received, state->nadc_partial) +
+                // P5-R2a/R5: marks dropped for lack of an attributable
+                // scope — reported beside the drop counters.
+                ",\"scope_overflow\":" +
+                null_or(state->watermark_received, state->scope_overflow) +
+                // Writer-side counters are measured for every producer.
+                ",\"accepted\":\"" + base::NumberToString(state->accepted) +
+                "\",\"written\":\"" + base::NumberToString(state->written) +
+                "\",\"failed\":\"" + base::NumberToString(state->failed) +
+                "\",\"assets_written\":\"" +
+                base::NumberToString(state->assets_written) +
+                "\",\"assets_failed\":\"" +
+                base::NumberToString(state->assets_failed) + "\"");
+    json.append(",\"watermark\":{\"received\":" +
+                std::string(state->watermark_received ? "true" : "false") +
+                "}");
+    json.append(",\"confirmed\":" +
+                std::string(state->watermark_received ? "true" : "false"));
+    json.append("}");
+  }
+  json.append("]");
+  // Global counts: producer-side sums cover CONFIRMED producers only
+  // (unknown values are not zero-filled); writer-side sums cover all.
+  // The visible equation gap under loss is itself the evidence (§7).
+  uint64_t total_eligible = 0, total_enqueued = 0, total_dropped = 0,
+           total_accepted = 0, total_written = 0, total_failed = 0;
+  for (const auto& [id, state] : producers_) {
+    if (state->watermark_received) {
+      total_eligible += state->eligible;
+      total_enqueued += state->enqueued;
+      total_dropped += state->dropped;
+    }
+    total_accepted += state->accepted;
+    total_written += state->written;
+    total_failed += state->failed;
+  }
+  json.append(",\"counts\":{" +
+              std::string("\"eligible\":\"") +
+              base::NumberToString(total_eligible) + "\",\"enqueued\":\"" +
+              base::NumberToString(total_enqueued) + "\",\"dropped\":\"" +
+              base::NumberToString(total_dropped) + "\",\"accepted\":\"" +
+              base::NumberToString(total_accepted) + "\",\"written\":\"" +
+              base::NumberToString(total_written) + "\",\"failed\":\"" +
+              base::NumberToString(total_failed) +
+              "\",\"sampled_out\":\"0\"}");
+  json.append(",\"overflow_intervals\":[]");
+  // P3-E5 identity crosswalk (manifest-only; event rows stay light).
+  // P5.5 E5: the nav_chain successions ride the SAME section (event rows
+  // gain no fields — the crosswalk-in-manifest decision).
+  json.append(",\"nav_chain\":[");
+  {
+    bool first = true;
+    for (const auto& row : succession_rows_) {
+      if (!first) json.append(",");
+      first = false;
+      json.append("{\"nav_chain_id\":");
+      json.append(base::GetQuotedJSONString(row.nav_chain_id));
+      json.append(",\"frame_tree_node_id\":");
+      json.append(base::GetQuotedJSONString(row.frame_tree_node_id));
+      json.append(",\"from_document\":");
+      json.append(base::GetQuotedJSONString(row.from_document));
+      json.append(",\"to_document\":");
+      json.append(base::GetQuotedJSONString(row.to_document));
+      json.append(",\"from_url\":");
+      json.append(base::GetQuotedJSONString(row.from_url));
+      json.append(",\"to_url\":");
+      json.append(base::GetQuotedJSONString(row.to_url));
+      json.append(",\"cause\":");
+      json.append(base::GetQuotedJSONString(row.cause));
+      json.append(",\"wall_us\":");
+      json.append(base::GetQuotedJSONString(row.wall_us));
+      json.append("}");
+    }
+    json.append("]");
+  }
+  json.append(",\"identity\":[");
+  {
+    {
+      bool first_row = true;
+      for (const auto& row : identity_rows_) {
+        if (!first_row) {
+          json.append(",");
+        }
+        first_row = false;
+        json.append("{\"frame_tree_node_id\":\"");
+        json.append(row.frame_tree_node_id);
+        json.append("\",\"document_token\":");
+        json.append(row.resolved
+                        ? base::GetQuotedJSONString(row.document_token)
+                        : std::string("null"));
+        json.append(",\"frame_url\":");
+        json.append(row.resolved
+                        ? base::GetQuotedJSONString(row.frame_url)
+                        : std::string("null"));
+        json.append(",\"status\":");
+        json.append(row.resolved ? std::string("\"resolved\"")
+                                 : std::string("\"unresolved\""));
+        json.append("}");
+      }
+    }
+  }
+  json.append("]");
+  json.append(",\"terminal\":{\"state\":" +
+              base::GetQuotedJSONString(terminal_state) + ",\"reason\":" +
+              (reason.empty() ? std::string("null")
+                              : base::GetQuotedJSONString(reason)) +
+              ",\"unconfirmed_producers\":[");
+  bool first_unconfirmed = true;
+  for (const auto& [id, state] : producers_) {
+    if (state->watermark_received) {
+      continue;
+    }
+    if (!first_unconfirmed) {
+      json.append(",");
+    }
+    first_unconfirmed = false;
+    json.append(base::GetQuotedJSONString(id));
+  }
+  json.append("]}}");
+
+  return json;
+}
+
+void XTraceCaptureController::WriteManifest(
+    const std::string& terminal_state, const std::string& reason) {
+  base::FilePath manifest_path = trace_file_path_.DirName().Append(
+      trace_file_path_.BaseName().RemoveExtension().AddExtension(
+          ".manifest.json"));
+  if (!base::CreateDirectory(manifest_path.DirName())) {
+    return;
+  }
+  const std::string json = BuildManifestJson(terminal_state, reason);
+  base::File manifest_file(manifest_path,
+                           base::File::FLAG_CREATE_ALWAYS |
+                               base::File::FLAG_WRITE);
+  if (manifest_file.IsValid()) {
+    manifest_file.WriteAtCurrentPosAndCheck(base::as_byte_span(json));
+  } else {
+    // Diagnostics stay queryable even when the manifest itself cannot be
+    // written (e.g. read-only capture directory).
+    LOG(ERROR) << "XTrace manifest write failed (" << manifest_path.value()
+               << "); terminal state: " << json;
+  }
+}
+
+void XTraceCaptureController::WriteManifestRaw(
+    const std::string& terminal_state, const std::string& reason) {
+  // Raw POSIX IO: the process-exit path runs on a thread without blocking
+  // allowances, and base::File would trip thread-restriction checks (or
+  // need friend-list edits). Raw syscalls are bounded and uninstrumented.
+  const std::string path =
+      trace_file_path_.value().substr(0, trace_file_path_.value().size() -
+                                            strlen(".ndjson")) +
+      ".manifest.json";
+  ::mkdir(trace_file_path_.DirName().value().c_str(), 0755);  // EEXIST ok
+  const std::string json = BuildManifestJson(terminal_state, reason);
+  int fd = ::open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+  if (fd < 0) {
+    return;
+  }
+  size_t written = 0;
+  while (written < json.size()) {
+    const ssize_t n = ::write(fd, json.data() + written, json.size() - written);
+    if (n <= 0) {
+      break;
+    }
+    written += static_cast<size_t>(n);
+  }
+  ::close(fd);
+}
