+// F5 (review B6): a non-empty trace file at the target path is refused —
+// appending would mix captures; the writer never manufactures a mixed file.
+TEST_F(XTraceCaptureControllerTest, RefusesToAppendNonEmptyTrace) {
+  base::ScopedAllowBlockingForTesting allow_io;
+  ASSERT_TRUE(base::WriteFile(trace_, "{\"old\":1}\n"));
+  SendBatch(MakeBatch("rtx:1.1:1:1", 1, {"{\"api\":\"a\"}"}));
+  // The write path failed: nothing accepted, nothing written.
+  ProducerState* state = controller_->FindProducer("rtx:1.1:1:1");
+  ASSERT_TRUE(state);
+  EXPECT_EQ(state->accepted, 1u);
+  EXPECT_EQ(state->written, 0u);
+  EXPECT_EQ(state->failed, 1u);
+  std::string after;
+  base::ReadFileToString(trace_, &after);
+  EXPECT_EQ(after, "{\"old\":1}\n");  // previous capture untouched
+}
