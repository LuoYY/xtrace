+// In-process XTraceHost replacement (P3-E0 test seam): records batches,
+// assets and watermarks without any mojo broker binding.
+class FakeXTraceHost : public blink::mojom::XTraceHost {
+ public:
+  void LogBatch(blink::mojom::XTraceBatchPtr batch) override {
+    base::AutoLock lock(lock_);
+    batches_.push_back(std::move(batch));
+  }
+  void LogAsset(blink::mojom::XTraceAssetPtr asset) override {
+    base::AutoLock lock(lock_);
+    assets_.push_back(std::move(asset));
+  }
+  void SubmitWatermark(
+      blink::mojom::XTraceWatermarkPtr watermark) override {
+    base::AutoLock lock(lock_);
+    watermarks_.push_back(std::move(watermark));
+  }
+  void ProvideControlEndpoint(
+      blink::mojom::XTraceProducerDescriptorPtr producer,
+      mojo::PendingRemote<blink::mojom::XTraceControl> control) override {}
+
+  size_t batch_count() const {
+    base::AutoLock lock(lock_);
+    return batches_.size();
+  }
+  size_t watermark_count() const {
+    base::AutoLock lock(lock_);
+    return watermarks_.size();
+  }
+  blink::mojom::XTraceWatermarkPtr last_watermark() const {
+    base::AutoLock lock(lock_);
+    return watermarks_.empty() ? nullptr : watermarks_.back().Clone();
+  }
+  uint32_t total_batch_lines() const {
+    base::AutoLock lock(lock_);
+    uint32_t n = 0;
+    for (const auto& b : batches_) n += b->count;
+    return n;
+  }
+  uint64_t first_seq_of_last_batch() const {
+    base::AutoLock lock(lock_);
+    if (batches_.empty()) return 0;
+    uint64_t v = 0;
+    base::StringToUint64(batches_.back()->first_producer_seq, &v);
+    return v;
+  }
+  std::vector<std::string> last_batch_lines() const {
+    base::AutoLock lock(lock_);
+    if (batches_.empty()) return {};
+    return batches_.back()->event_json_lines;
+  }
+
+ private:
+  mutable base::Lock lock_;
+  std::vector<blink::mojom::XTraceBatchPtr> batches_;
+  std::vector<blink::mojom::XTraceAssetPtr> assets_;
+  std::vector<blink::mojom::XTraceWatermarkPtr> watermarks_;
+};
+
+uint64_t DecOrZero(const std::string& s) {
+  uint64_t v = 0;
+  base::StringToUint64(s, &v);
+  return v;
+}
