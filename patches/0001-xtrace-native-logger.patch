+#ifndef CONTENT_BROWSER_XTRACE_XTRACE_CAPTURE_CONTROLLER_H_
+#define CONTENT_BROWSER_XTRACE_XTRACE_CAPTURE_CONTROLLER_H_
+
+#include <atomic>
+#include <map>
+#include <vector>
+#include <memory>
+#include <string>
+
+#include "base/files/file.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/synchronization/lock.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/timer/timer.h"
+#include "content/common/content_export.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/mojom/xtrace/xtrace.mojom.h"
+
+namespace content {
+
+struct ProducerState;
+
+// Single logical writer + capture coordinator for schema v3 (P2-E3, draft
+// §7). One capture per browser process in P2. All file IO, counting and
+// settlement run on a dedicated BLOCK_SHUTDOWN sequenced runner (DP5):
+// shutdown only drains what is already queued locally and never waits on
+// remote processes; a mid-capture teardown finalizes as incomplete with
+// reason "browser-shutdown".
+//
+// Stop distribution uses the in-band control endpoints delivered by
+// renderer processes over their first XTraceHost pipe
+// (XTraceHost.ProvideControlEndpoint); the endpoint disconnect doubles as
+// the renderer-death signal. Delivery counts are never acknowledgements
+// (draft V09) — settlement counts watermarks only.
+class CONTENT_EXPORT XTraceCaptureController {
+ public:
+  // Returns null when capture is disabled at startup (no --xtrace-enable /
+  // XTRACE_ENABLE with a trace file).
+  static XTraceCaptureController* Get();
+
+  // Writer runner (broker registration hands receivers to it).
+  static scoped_refptr<base::SequencedTaskRunner> WriterRunner();
+
+  // Bound per producer pipe (each renderer thread binds its own XTraceHost
+  // receiver through the browser interface broker).
+  void BindXTraceHostReceiver(
+      mojo::PendingReceiver<blink::mojom::XTraceHost> receiver);
+
+  // In-process browser-network producer (chrome/ layer): the private
+  // AppendToFile path is gone; events flow into the same writer and count
+  // conservation as every other producer (P2-E3 merge).
+  void AcceptBrowserNetworkEvent(std::string event_json);
+
+  // P3-E6: stop-after scaffolding removed (kept as a no-op anchor).
+  void MaybeScheduleTestStop();
+
+  // Normal stop path trigger (deadline in ms for watermark collection).
+  void RequestStop(uint32_t deadline_ms);
+
+  // CDP-domain read accessors (P3-E2/E3). Snapshots taken under
+  // writer_lock_; safe to call from any thread.
+  struct DomainProducerRow {
+    std::string producer_id;
+    std::string kind;
+    std::string final_producer_seq;  // "" when unknown
+    std::string eligible;
+    std::string enqueued;
+    std::string dropped;
+    std::string accepted;
+    std::string written;
+    std::string failed;
+    bool confirmed = false;
+  };
+  const std::string& capture_id() const { return capture_id_; }
+  std::string current_generation() const;
+  // F1/B7: the effective runtime categories (launch value until the first
+  // updateCapture). Status/manifest/backfill all read this one source.
+  std::string current_categories();
+  void set_current_generation_for_status(const std::string& g) {
+    base::AutoLock lock(writer_lock_);
+    status_generation_ = g;
+  }
+  void SetStatusConfigForTesting(const std::string& generation,
+                                 const std::string& categories) {
+    base::AutoLock lock(writer_lock_);
+    status_generation_ = generation;
+    status_categories_ = categories;
+  }
+  std::string DomainStateName();
+  std::vector<DomainProducerRow> DomainProducerRows();
+  std::string DomainTerminalState();   // "unsettled" while not final
+  std::string DomainTerminalReason();
+  std::vector<std::string> DomainUnconfirmedProducers();
+  // F1/B7: applied/pending by EVENT evidence — applied producers have
+  // emitted at least one record stamped with `generation`; pending are the
+  // registered members that have not (silence is not a failure). Watermark
+  // confirmation is a separate axis (DomainUnconfirmedProducers).
+  std::vector<std::string> DomainProducersAppliedTo(uint64_t generation);
+  std::vector<std::string> DomainProducersPendingOn(uint64_t generation);
+
+  // P4-E4: whether the renderer-side ignition observer was requested at
+  // launch (--xtrace-ignition-observer forwarded to renderers).
+  bool DomainObserverRequested();
+
+  // P3-E3: manifest path for the IO stream (valid once settled).
+  base::FilePath DomainManifestPath();
+
+  // P3-E4: serial generation allocation + config distribution through the
+  // in-band control endpoints. Returns the new generation, or "" when the
+  // capture is stopping/settled (updateCapture -> invalidState).
+  struct ObserverScope {
+    std::vector<std::string> context_patterns;
+    std::vector<std::string> script_patterns;
+    bool deny_internal = true;
+  };
+  std::string DomainUpdateCapture(const std::string& categories,
+                                  const ObserverScope* observer_scope);
+
+  // P3-E5: identity crosswalk — frame_tree_node -> document token +
+  // frame URL, captured at manifest time; unresolved entries are
+  // recorded as such (never guessed).
+  // P5.5 E5 (contract §7): same-frame navigation succession, recorded at
+  // commit time into manifest.identity — event rows gain NO new fields.
+  struct SuccessionRow {
+    std::string nav_chain_id;      // "ftn-<frame_tree_node_id>" (same-frame
+                                   // navigation sequences share the chain)
+    std::string frame_tree_node_id;
+    std::string from_document;     // previous document token (empty on
+                                   // first sighting: no succession emitted)
+    std::string to_document;
+    std::string from_url;
+    std::string to_url;
+    std::string cause;             // reload | navigation | same-document
+    std::string wall_us;
+  };
+  // RenderFrameHostImpl::DidNavigate hook (UI thread). Returns nothing;
+  // records a succession only when an ACTIVE capture knew a DIFFERENT
+  // previous document token for the frame.
+  void AcceptNavigationSuccession(uint32_t frame_tree_node_id,
+                                  const std::string& new_document_token,
+                                  const std::string& url,
+                                  bool is_reload,
+                                  bool same_document);
+
+  struct IdentityRow {
+    std::string frame_tree_node_id;
+    std::string document_token;
+    std::string frame_url;
+    bool resolved = false;
+  };
+  std::vector<IdentityRow> DomainIdentityRows();
+
+
+  // Terminal outcome recorded by FinalizeLocked for the domain accessors.
+  std::string last_terminal_state_;
+  std::string last_terminal_reason_;
+  // P3-E5: identity rows captured on the UI thread for the manifest.
+  std::vector<IdentityRow> identity_rows_;
+  std::vector<SuccessionRow> succession_rows_;  // writer lock
+  std::map<uint32_t, std::string> last_document_by_ftn_;  // writer lock
+  uint64_t next_generation_ = 1;  // updateCapture allocations from "1"
+  std::string status_generation_ = "0";
+  std::string status_categories_;  // launch categories until first update
+  ObserverScope status_observer_scope_;  // N3-part2 selector (backfill)
+
+  // DP5 shutdown evidence: synchronous, idempotent finalization as
+  // incomplete/browser-shutdown using only data already at the writer (no
+  // cross-process waits). Called from chrome's OnClosingAllBrowsers (every
+  // exit path passes it before any immediate-exit) and the thread-pool
+  // teardown hook; the AtExit callback is the last-ditch belt.
+  void NotifyBrowserShuttingDown();
+
+  // Runs on the writer runner at teardown; the controller has process
+  // lifetime (destructor deleted), so the binding is Unretained-safe.
+  // Process-exit path (base::RegisterExitCallback): runs after the thread
+  // pool has been joined, so touching writer state from the exiting thread
+  // is race-free; idempotent via the finalized_ gate.
+  void FinalizeForProcessExit();
+
+  friend class XTraceCaptureControllerTest;
+
+
+  XTraceCaptureController(const base::FilePath& trace_file_path,
+                          std::string capture_id);
+  ~XTraceCaptureController() = delete;
+
+  // XTraceHost message handlers (writer runner).
+  void OnLogBatch(blink::mojom::XTraceBatchPtr batch);
+  void OnLogAsset(blink::mojom::XTraceAssetPtr asset);
+  void OnWatermark(blink::mojom::XTraceWatermarkPtr watermark);
+  void OnProvideControlEndpoint(
+      blink::mojom::XTraceProducerDescriptorPtr producer,
+      mojo::PendingRemote<blink::mojom::XTraceControl> control);
+  void OnControlDisconnected(const std::string& process_epoch);
+
+  void RegisterProducer(const blink::mojom::XTraceProducerDescriptor& d);
+  ProducerState* FindProducer(const std::string& producer_id);  // struct below
+  // F1/B7: raises state->observed_generation from the record's declared
+  // config_generation (identity-tail scan). Writer lock held by callers.
+  void ObserveGenerationLocked(ProducerState* state, const std::string& raw);
+
+  bool EnsureTraceFile();
+  bool EnsureAssetManifestFile();
+  bool WriteLine(base::File& file, const std::string& json);
+  std::string StampWriterFields(std::string json);  // writer_seq + capture_id
+
+  // Stop orchestration, entirely on the writer runner: distribution via the
+  // in-band control endpoints, settlement by watermark or deadline.
+  // Finalization only consumes data already received — no cross-process
+  // waits anywhere in the stop or shutdown paths (DP5).
+  void BeginStopOnWriter(uint32_t deadline_ms);
+  void MaybeFinalizeForStopSettled();
+  void OnStopDeadline();
+  void OnBrowserNetworkEventLocked(std::string json);
+  void Finalize(const std::string& reason);
+  // Requires writer_lock_ held.
+  void FinalizeLocked(const std::string& reason);
+  std::string BuildManifestJson(const std::string& terminal_state,
+                                 const std::string& reason);
+  void WriteManifest(const std::string& terminal_state,
+                     const std::string& reason);
+  // Raw-IO sink for the process-exit path (no thread allowances there).
+  void WriteManifestRaw(const std::string& terminal_state,
+                        const std::string& reason);
+
+  const base::FilePath trace_file_path_;
+  const std::string capture_id_;
+  const std::string trace_stem_;
+  std::string config_json_;  // startup config snapshot for manifest
+
+  base::File trace_file_;
+  base::File asset_manifest_file_;
+  uint64_t next_writer_seq_ = 1;
+  bool trace_write_failed_ = false;
+
+  std::map<std::string, std::unique_ptr<ProducerState>> producers_;
+  size_t asset_rows_written_ = 0;
+  size_t asset_rows_failed_ = 0;
+
+  // Control endpoints per renderer process (key: process_epoch). Writer
+  // runner; disconnects drive renderer-gone accounting.
+  std::map<std::string, mojo::Remote<blink::mojom::XTraceControl>>
+      control_remotes_by_epoch_;
+
+  bool stopping_ = false;
+  bool stop_distributed_ = false;
+  std::atomic<bool> finalized_{false};
+  // Guards writer state for the process-exit finalize path.
+  mutable base::Lock writer_lock_;
+  uint32_t stop_deadline_ms_ = 0;
+  base::OneShotTimer stop_timer_;  // writer runner
+  raw_ptr<ProducerState> bnet_state_ = nullptr;  // writer runner (owned by map)
+  uint64_t browser_network_lseq_ = 0;
+
+  base::WeakPtrFactory<XTraceCaptureController> weak_factory_{this};
+
+  SEQUENCE_CHECKER(writer_sequence_);
+};
+
+// Per-producer accounting (writer runner only).
+struct ProducerState {
+  std::string producer_id;
+  std::string process_epoch;
+  std::string pkind;
+  bool worker = false;
+  std::string worker_kind;
+  std::string worker_scope;
+  bool pipe_alive = true;
+  // Watermark (producer side).
+  uint64_t final_producer_seq = 0;
+  uint64_t eligible = 0;
+  uint64_t enqueued = 0;
+  uint64_t dropped = 0;
+  uint64_t nadc_partial = 0;  // DP1 (P5): TryEnter-rejected NADC entries
+  uint64_t scope_overflow = 0;  // P5-R2a/R5: unattributable marks dropped
+  uint32_t assets_out = 0;
+  bool watermark_received = false;
+  // F1/B7: highest config_generation observed in this producer's accepted
+  // records — the writer's per-line scan of the identity tail.
+  uint64_t observed_generation = 0;
+  // Writer side.
+  uint64_t accepted = 0;
+  uint64_t written = 0;
+  uint64_t failed = 0;
+  uint32_t assets_written = 0;
+  uint32_t assets_failed = 0;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_XTRACE_XTRACE_CAPTURE_CONTROLLER_H_
