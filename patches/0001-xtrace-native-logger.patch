+// Manifest stream: copy the settled manifest bytes into an IO stream so
+// clients read them with IO.read (no file-path exposure).
+std::string MakeManifestStreamOnIO(XTraceCaptureController* controller,
+                                    DevToolsIOContext* io_context) {
+  if (!controller || !io_context ||
+      controller->DomainTerminalState() == "unsettled") {
+    return std::string();
+  }
+  std::string bytes;
+  {
+    base::ScopedAllowBlockingForTesting allow_io;  // settled file read
+    if (!base::ReadFileToString(controller->DomainManifestPath(), &bytes)) {
+      return std::string();
+    }
+  }
+  auto stream = DevToolsStreamFile::Create(io_context, /*binary=*/false);
+  stream->Append(std::make_unique<std::string>(std::move(bytes)));
+  return stream->handle();
+}
+
+}  // namespace
+
+// F3 (review B2, handoff §10.8-D): the ONE verified environment model —
+// capabilities, startCapture's authority check and the effectiveConfig
+// disclosure all read this; nobody re-derives truth from flag names.
+struct PreciseEnvironment {
+  bool observer_compiled = false;
+  bool observer_switch = false;
+  bool causality_sync = false;
+  bool ignition_locked = false;  // --js-flags actually locks Ignition-only
+  std::string js_flags;          // the raw --js-flags value, disclosed
+  std::string tier_lock;         // "ignition-locked" | "tiering-possible"
+  std::string unavailable_reason;
+
+  bool available() const {
+    return observer_compiled && observer_switch && causality_sync &&
+           ignition_locked;
+  }
+  std::string RequiresList() const {
+    return "v8-observer-compiled;--xtrace-ignition-observer;"
+           "--xtrace-causality=sync;--js-flags=--max-opt=0 (no tier-"
+           "enabling flags)";
+  }
+};
+
+// Parses --js-flags the way V8 applies it: whitespace/comma tokens,
+// --flag=value and "--flag value" forms, later tokens override earlier
+// ones, --no-X negates. Top-level browser switches (which forward to V8)
+// are folded in.
+PreciseEnvironment GetPreciseEnvironment() {
+  PreciseEnvironment env;
+  env.observer_compiled =
+      v8::internal::xtrace::IgnitionObserverIsCompiled();  // return value
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  env.observer_switch = cmd->HasSwitch("xtrace-ignition-observer");
+  env.causality_sync =
+      cmd->GetSwitchValueASCII("xtrace-causality") == "sync";
+  env.js_flags = cmd->GetSwitchValueASCII("js-flags");
+
+  // N3 (review R3): every tier flag keeps INDEPENDENT state — negating
+  // `--no-always-sparkplug` must never clear a plain `--sparkplug` (the
+  // merged-bool bug accepted a real baseline as ignition-locked). V8
+  // flag semantics per the pinned tree: later tokens override earlier
+  // ones, `--no-X` and the compact `--noX` negate, underscores are
+  // equivalent to dashes, booleans accept `--flag=value`. Anything not
+  // on the audited allowlist makes precise UNAVAILABLE (unknown and not
+  // provably inert), never silently ignored.
+  struct JsFlagState {
+    bool sparkplug = false;
+    bool always_sparkplug = false;
+    bool maglev = false;
+    bool turbofan = false;
+    bool always_turbofan = false;
+    bool jitless = false;
+    bool have_max_opt = false;
+    int max_opt = -1;
+    std::vector<std::string> unknown;
+  };
+  JsFlagState js;
+  // Top-level Chromium switches forward to V8 — fold them in first.
+  if (cmd->HasSwitch("sparkplug")) js.sparkplug = true;
+  if (cmd->HasSwitch("always-sparkplug")) js.always_sparkplug = true;
+
+  const std::vector<std::string> tokens = base::SplitString(
+      env.js_flags, " \t,", base::TRIM_WHITESPACE,
+      base::SPLIT_WANT_NONEMPTY);
+  // Audited non-tier flags that are provably inert for tier selection.
+  const std::set<std::string> kSafeFlags = {
+      "allow-natives-syntax", "expose-gc", "compilation-cache"};
+  for (size_t i = 0; i < tokens.size(); ++i) {
+    const std::string& token = tokens[i];
+    if (!base::StartsWith(token, "--")) {
+      continue;  // bare value consumed by its own flag token
+    }
+    std::string body = token.substr(2);
+    std::string value;
+    bool has_value = false;
+    const size_t eq = body.find('=');
+    if (eq != std::string::npos) {
+      value = body.substr(eq + 1);
+      has_value = true;
+      body = body.substr(0, eq);
+    }
+    std::replace(body.begin(), body.end(), '_', '-');
+    // Negation: `--no-X` and the compact `--noX`.
+    bool negate = false;
+    if (base::StartsWith(body, "no-")) {
+      negate = true;
+      body = body.substr(3);
+    } else if (base::StartsWith(body, "no") && body.size() > 2 &&
+               (kSafeFlags.count(body.substr(2)) ||
+                body.substr(2) == "sparkplug" ||
+                body.substr(2) == "always-sparkplug" ||
+                body.substr(2) == "maglev" || body.substr(2) == "turbofan" ||
+                body.substr(2) == "always-turbofan" ||
+                body.substr(2) == "jitless")) {
+      negate = true;
+      body = body.substr(2);
+    }
+    const bool on = has_value ? (value == "true" || value == "1") : !negate;
+    auto set_bool = [&](bool& slot) { slot = on; };
+    if (body == "max-opt") {
+      if (!has_value && i + 1 < tokens.size() &&
+          base::IsAsciiDigit(tokens[i + 1][0])) {
+        value = tokens[++i];
+        has_value = true;
+      }
+      if (has_value) {
+        js.have_max_opt = true;
+        js.max_opt = atoi(value.c_str());
+      }
+    } else if (body == "sparkplug") {
+      set_bool(js.sparkplug);
+    } else if (body == "always-sparkplug") {
+      set_bool(js.always_sparkplug);
+    } else if (body == "maglev") {
+      set_bool(js.maglev);
+    } else if (body == "turbofan") {
+      set_bool(js.turbofan);
+    } else if (body == "always-turbofan") {
+      set_bool(js.always_turbofan);
+    } else if (body == "jitless") {
+      set_bool(js.jitless);
+    } else if (!kSafeFlags.count(body)) {
+      js.unknown.push_back(token);
+    }
+  }
+  const bool tier_conflict = js.sparkplug || js.always_sparkplug ||
+                             js.maglev || js.turbofan ||
+                             js.always_turbofan || js.jitless;
+  env.ignition_locked = js.have_max_opt && js.max_opt == 0 &&
+                        !tier_conflict && js.unknown.empty();
+  env.tier_lock = tier_conflict ? "tiering-possible"
+                                : (js.have_max_opt && js.max_opt == 0
+                                       ? "ignition-locked"
+                                       : "no-max-opt-audit");
+  if (!env.observer_compiled) {
+    env.unavailable_reason = "v8 observer not compiled into this build";
+  } else if (!env.observer_switch) {
+    env.unavailable_reason =
+        "launch flag --xtrace-ignition-observer required";
+  } else if (!env.causality_sync) {
+    env.unavailable_reason = "launch flag --xtrace-causality=sync required";
+  } else if (!js.unknown.empty()) {
+    env.unavailable_reason =
+        "--js-flags carries token(s) outside the audited allowlist: " +
+        base::JoinString(js.unknown, " ");
+  } else if (tier_conflict || !js.have_max_opt || js.max_opt != 0) {
+    env.unavailable_reason =
+        "--js-flags must lock Ignition (--max-opt=0) without tier-enabling "
+        "flags (sparkplug/always-sparkplug/maglev/turbofan/always-turbofan/"
+        "jitless)";
+  }
+  return env;
+}
