@@ -0,0 +1,330 @@
+// Copyright 2026 The XTrace Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in Chromium's LICENSE file.
+
+#include "third_party/blink/renderer/platform/xtrace/xtrace-ignition-bridge.h"
+
+#include <atomic>
+#include <optional>
+#include <set>
+#include <string_view>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/environment.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/stringprintf.h"
+#include "base/synchronization/lock.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/bindings/v8_per_isolate_data.h"
+#include "third_party/blink/renderer/platform/xtrace/xtrace_logger.h"
+#include "third_party/blink/renderer/platform/xtrace/xtrace_producer.h"
+#include "v8/include/v8.h"
+
+// N3-part2: the SINGLE boundary declaration lives in
+// v8/include/xtrace_observer_boundary.h (compile-checked on both sides of
+// the link — no hand-written mirror here).
+#include "v8/include/xtrace_observer_boundary.h"
+
+namespace blink::xtrace {
+
+namespace {
+
+constexpr char kObserverSwitch[] = "xtrace-ignition-observer";
+constexpr char kObserverEnv[] = "XTRACE_IGNITION_OBSERVER";
+
+bool ObserverRequestedImpl() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(kObserverSwitch)) {
+    return true;
+  }
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> value = env->GetVar(kObserverEnv);
+  return value && *value == "1";
+}
+
+std::atomic<bool> g_installed{false};
+
+// Process-wide capture-stop latch (N2): published once by
+// IgnitionBridge::Close(); every isolate checks it on its own thread.
+std::atomic<bool>& StoppedLatch() {
+  static std::atomic<bool> stopped{false};
+  return stopped;
+}
+
+// N3-part2 scope selection (design §1/§2): explicit configuration, not a
+// hidden hardcode. contexts evaluate at activation begin against the
+// context URL (frame document / worker scope); scripts evaluate at the
+// event callback against the registry-cached script SOURCE URL.
+bool MatchesAnyPattern(const std::vector<std::string>& patterns,
+                       std::string_view url) {
+  if (patterns.empty()) {
+    return true;  // empty list = namespace fully selected
+  }
+  for (const std::string& pattern : patterns) {
+    if (url.find(pattern) != std::string_view::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool IsInternalSchemeUrl(std::string_view url) {
+  return url.starts_with("chrome-extension://") ||
+         url.starts_with("devtools://") || url.starts_with("chrome://") ||
+         url.starts_with("chrome-untrusted://");
+}
+
+bool ContextSelected(const xtrace::ObserverScopeConfig& scope,
+                     const char* frame_url) {
+  if (scope.deny_internal && frame_url &&
+      IsInternalSchemeUrl(std::string_view(frame_url))) {
+    return false;  // explicit denyInternal rule (default on)
+  }
+  if (!frame_url) {
+    return scope.context_patterns.empty();
+  }
+  return MatchesAnyPattern(scope.context_patterns,
+                           std::string_view(frame_url));
+}
+
+bool ScriptSelected(const xtrace::ObserverScopeConfig& scope,
+                    const char* script_url) {
+  if (!script_url) {
+    return scope.script_patterns.empty() ||
+           scope.script_patterns.size() == 0;
+    // null URL (inline/eval without resolvable source): matches only an
+    // unconstrained selector — a pattern list cannot be verified against
+    // nothing.
+  }
+  return MatchesAnyPattern(scope.script_patterns,
+                           std::string_view(script_url));
+}
+
+// Per-isolate observation scope (V8PerIsolateData::UserData owns the
+// lifetime; WillBeDestroyed unregisters the callback before anything
+// downstream dies).
+class IgnitionScope final : public V8PerIsolateData::UserData {
+ public:
+  ~IgnitionScope() override = default;
+
+  void WillBeDestroyed() override {
+    // N2 (review R2): runs on the OWNING isolate thread during
+    // V8PerIsolateData teardown, serialized with worker teardown. The
+    // isolate pointer stays valid until unregistration completes — it is
+    // never extracted or nulled by the stop path. Callback first (a
+    // racing event then no-ops), then the gate, then leave the registry.
+    v8::internal::xtrace::IgnitionObserverSetCallback(
+        isolate_.get(), nullptr);
+    v8::internal::xtrace::IgnitionObserverSetMetadataCallback(
+        isolate_.get(), nullptr);
+    v8::internal::xtrace::IgnitionObserverSetGate(
+        isolate_.get(), 0);
+    base::AutoLock lock(*scopes_lock());
+    scopes()->erase(this);
+  }
+
+  void Trace(Visitor*) const override {}
+
+  struct Activation {
+    bool selected;
+  };
+
+  raw_ptr<v8::Isolate> isolate_ = nullptr;
+  std::vector<Activation> stack;          // isolate thread only
+  std::atomic<bool> closed_{false};       // capture stop: never reopens
+
+  bool Stopped() const {
+    return closed_.load(std::memory_order_acquire) || StoppedLatch();
+  }
+
+  static std::set<IgnitionScope*>* scopes() {
+    static base::NoDestructor<std::set<IgnitionScope*>> scopes;
+    return scopes.get();
+  }
+  static base::Lock* scopes_lock() {
+    static base::NoDestructor<base::Lock> lock;
+    return lock.get();
+  }
+};
+
+void RecomputeGate(v8::Isolate* isolate, IgnitionScope* scope) {
+  // N3-part2 barrier: until the browser's config has been applied in
+  // this process, conservative non-acceptance — the gate stays closed.
+  const bool open = !scope->Stopped() &&
+                    XTraceProducerHub::Get()->ConfigReceived() &&
+                    !scope->stack.empty() && scope->stack.back().selected;
+  v8::internal::xtrace::IgnitionObserverSetGate(
+      isolate, open ? 1 : 0);
+}
+
+IgnitionScope* ScopeFor(v8::Isolate* isolate) {
+  return static_cast<IgnitionScope*>(V8PerIsolateData::From(isolate)
+                                         ->GetUserData(
+                                             V8PerIsolateData::UserData::
+                                                 Key::kXTraceIgnitionObserver));
+}
+
+void OnIgnitionEvent(v8::Isolate* isolate, uint32_t script_id,
+                     uint32_t bytecode_version, uint32_t bytecode_offset,
+                     uint32_t opcode, const char* script_url);
+void OnIgnitionMetadata(v8::Isolate* isolate, uint32_t script_id,
+                        uint32_t bytecode_version,
+                        const char* metadata_json, size_t metadata_len);
+
+IgnitionScope* InstallScope(v8::Isolate* isolate) {
+  if (!v8::internal::xtrace::IgnitionObserverIsCompiled()) {
+    return nullptr;  // V8 dylib compiled without the observer
+  }
+  V8PerIsolateData* data = V8PerIsolateData::From(isolate);
+  if (IgnitionScope* existing = ScopeFor(isolate)) {
+    return existing;
+  }
+  auto* scope = MakeGarbageCollected<IgnitionScope>();
+  scope->isolate_ = isolate;
+  data->SetUserData(
+      V8PerIsolateData::UserData::Key::kXTraceIgnitionObserver, scope);
+  {
+    base::AutoLock lock(*IgnitionScope::scopes_lock());
+    IgnitionScope::scopes()->insert(scope);
+  }
+  v8::internal::xtrace::IgnitionObserverSetCallback(
+      isolate, &OnIgnitionEvent);
+  // P5.5 D1: one-time compilation-instance metadata assets ride the same
+  // lifecycle as the event callback (unregistered in WillBeDestroyed).
+  v8::internal::xtrace::IgnitionObserverSetMetadataCallback(
+      isolate, &OnIgnitionMetadata);
+  return scope;
+}
+
+void OnIgnitionMetadata(v8::Isolate* isolate, uint32_t script_id,
+                        uint32_t bytecode_version,
+                        const char* metadata_json, size_t metadata_len) {
+  // Contract §3: exactly-once per compilation instance; scope state gets
+  // a second line beyond the generated-code gate like every event path.
+  IgnitionScope* scope = ScopeFor(isolate);
+  if (!scope || scope->Stopped() || scope->stack.empty() ||
+      !scope->stack.back().selected) {
+    return;
+  }
+  if (!metadata_json || metadata_len == 0) {
+    return;
+  }
+  // The asset content is the assembled blob verbatim (UTF-8-safe: the
+  // blob escapes control chars; non-ASCII source bytes are hex in the
+  // sha1, and string constants are JSON-escaped V8-side); the event row
+  // carries a compact summary so the manifest stays light. The asset
+  // "url" is a stable namespaced label — the blob carries source
+  // identity (sha1 + length), and the label never matches the
+  // internal-script filter.
+  // v3 args is an ARRAY by contract; the single summary element carries
+  // the instance key reference and the byte size of the asset content.
+  const std::string summary = base::StringPrintf(
+      "[{\"script_id\":%u,\"bytecode_version\":%u,\"bytes\":%zu}]",
+      script_id, bytecode_version, metadata_len);
+  const std::string asset_url = base::StringPrintf(
+      "v8-bytecode-metadata://%u/%u", script_id, bytecode_version);
+  // The blob is JSON (ASCII payload; non-ASCII escapes are V8-side),
+  // so the Latin-1 span constructor is exact for the content. The
+  // summary/url are ASCII by construction.
+  const String content(base::span<const char>(metadata_json, metadata_len));
+  XTraceLogger::LogAssetEvent(
+      "reverse", "asset", "V8.bytecodeMetadata", String(summary.c_str()),
+      "v8-bytecode-metadata", String(asset_url.c_str()), content);
+}
+
+void OnIgnitionEvent(v8::Isolate* isolate, uint32_t script_id,
+                     uint32_t bytecode_version, uint32_t bytecode_offset,
+                     uint32_t opcode, const char* script_url) {
+  IgnitionScope* scope = ScopeFor(isolate);
+  if (!scope || scope->Stopped() || scope->stack.empty() ||
+      !scope->stack.back().selected) {
+    return;  // second line: scope state beyond the generated-code gate
+  }
+  // SCRIPT selection (design §1): the registry-cached source URL against
+  // the selector from the CURRENT snapshot.
+  auto snapshot = xtrace::XTraceProducerHub::Get()->SnapshotConfig();
+  if (!ScriptSelected(snapshot->observer_scope, script_url)) {
+    return;
+  }
+  if (XTraceLogger::CurrentActivationToken() == 0) {
+    return;  // outside a tracked (sync-causality) activation
+  }
+  XTraceLogger::LogIgnitionEvent(
+      script_id, bytecode_version, bytecode_offset,
+      v8::internal::xtrace::IgnitionOpcodeName(opcode),
+      XTraceLogger::CurrentActivationCallId());
+}
+
+}  // namespace
+
+bool IgnitionBridge::ObserverRequested() {
+  // Process-lifetime constant: the command line never changes mid-process,
+  // and the code-cache gates (F3) consult this per request/script.
+  static const bool requested = ObserverRequestedImpl();
+  return requested;
+}
+
+void IgnitionBridge::EnsureInstalled() {
+  if (!ObserverRequestedImpl()) {
+    return;
+  }
+  bool expected = false;
+  g_installed.compare_exchange_strong(expected, true);
+}
+
+void IgnitionBridge::Close() {
+  // N2 (review R2): the stop path only publishes a process-wide latch.
+  // It never mutates scope objects or isolate pointers from a foreign
+  // thread (the old ExtractAsDangling() nulled the pointer that
+  // WillBeDestroyed later dereferenced — the stop->terminate SIGSEGV).
+  // Each isolate observes the latch on its own thread: activation
+  // begin/end recompute the gate closed, the event callback drops, and
+  // WillBeDestroyed unregisters with a still-valid pointer. Scopes
+  // created after the stop inherit the closed state via the latch.
+  StoppedLatch().store(true, std::memory_order_release);
+}
+
+void IgnitionBridge::OnActivationBegin(const char* frame_url) {
+  if (!g_installed.load(std::memory_order_acquire)) {
+    return;
+  }
+  v8::Isolate* isolate = v8::Isolate::GetCurrent();
+  if (!isolate) {
+    return;
+  }
+  IgnitionScope* scope = InstallScope(isolate);
+  if (!scope) {
+    return;
+  }
+  // One snapshot also feeds the CONTEXT selection (design §2: same
+  // immutable object as categories/generation).
+  auto snapshot = xtrace::XTraceProducerHub::Get()->SnapshotConfig();
+  // Always push (selected or not): end must have a pair to pop, and an
+  // unselected inner explicitly suppresses only ITSELF (review B1/B8-B).
+  scope->stack.push_back(
+      {ContextSelected(snapshot->observer_scope, frame_url)});
+  RecomputeGate(isolate, scope);
+}
+
+void IgnitionBridge::OnActivationEnd() {
+  if (!g_installed.load(std::memory_order_acquire)) {
+    return;
+  }
+  v8::Isolate* isolate = v8::Isolate::GetCurrent();
+  if (!isolate) {
+    return;
+  }
+  IgnitionScope* scope = ScopeFor(isolate);
+  if (!scope || scope->stack.empty()) {
+    return;
+  }
+  scope->stack.pop_back();
+  // Restores the OUTER activation's state — end is not close (review B1:
+  // the nested counterexample must keep the outer 2224 events).
+  RecomputeGate(isolate, scope);
+}
+
+}  // namespace blink::xtrace
