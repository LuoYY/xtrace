+namespace {
+
+constexpr char kEnableSwitch[] = "xtrace-enable";
+constexpr char kFileSwitch[] = "xtrace-file";
+constexpr char kCategoriesSwitch[] = "xtrace-categories";
+constexpr char kCaptureValuesSwitch[] = "xtrace-capture-values";
+constexpr char kCaptureAssetsSwitch[] = "xtrace-capture-assets";
+constexpr char kCausalitySwitch[] = "xtrace-causality";
+constexpr char kMaxBodyBytesSwitch[] = "xtrace-max-body-bytes";
+constexpr char kMaxHeaderValueBytesSwitch[] = "xtrace-max-header-value-bytes";
+
+std::atomic<XTraceCaptureController*> g_controller{nullptr};
+std::atomic<bool> g_controller_initialized{false};
+
+std::optional<base::FilePath> ReadTraceFilePathFromRuntime() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(kEnableSwitch)) {
+    base::FilePath trace_file = command_line->GetSwitchValuePath(kFileSwitch);
+    if (!trace_file.empty()) {
+      return trace_file;
+    }
+  }
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> enabled = env->GetVar("XTRACE_ENABLE");
+  if (!enabled || *enabled != "1") {
+    return std::nullopt;
+  }
+  std::optional<std::string> trace_file = env->GetVar("XTRACE_FILE");
+  if (!trace_file || trace_file->empty()) {
+    return std::nullopt;
+  }
+  return base::FilePath::FromUTF8Unsafe(*trace_file);
+}
+
+std::string MakeBrowserProcessEpoch() {
+  // Real creation time is not portably exposed; first-use monotonic tick
+  // is unique per process instance (schema v3 §3.1 epoch contract).
+  return base::NumberToString(base::GetCurrentProcId()) + "." +
+         base::NumberToString(
+             base::TimeTicks::Now().since_origin().InMicroseconds());
+}
+
+std::string SwitchValueOr(const char* name, const char* fallback) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  std::string value = command_line->GetSwitchValueASCII(name);
+  return value.empty() ? fallback : value;
+}
