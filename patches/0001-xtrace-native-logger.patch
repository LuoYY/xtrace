+// Copyright 2026 The XTrace Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in Chromium's LICENSE file.
+
+module blink.mojom;
+
+// Schema v3 capture plumbing (docs/trace-schema-v3.md, DP2 in
+// docs/chromium-p2-r1-decisions.md). The browser process owns the trace
+// files and the capture state machine; renderer sandboxing stays enabled.
+
+// Worker provenance for renderer worker-thread producers; "unresolved" is
+// the declared value when the scope is not (yet) known.
+struct XTraceWorkerDescriptor {
+  string kind;       // "dedicated" | "shared" | "service" | "unresolved"
+  string scope_url;  // scope URL or "unresolved"
+};
+
+// Producer identity, carried on every data message (registration is
+// piggybacked on the first message; no separate Register round trip).
+struct XTraceProducerDescriptor {
+  // "<pkind>:<pid>.<epoch>:<tid>:<lseq>"; lseq makes ids unique across
+  // operating-system tid reuse within one capture.
+  string producer_id;
+  string process_epoch;
+  string pkind;
+  string config_generation;  // P2: always the startup generation "0"
+  XTraceWorkerDescriptor? worker;
+};
+
+// Bounded batch of pre-serialized v3 event lines. `first_producer_seq` plus
+// `count` must match the lines' embedded producer_seq values; the writer
+// verifies this before accepting.
+struct XTraceBatch {
+  XTraceProducerDescriptor producer;
+  string first_producer_seq;  // decimal string (uint64 as text)
+  uint32 count;
+  array<string> event_json_lines;
+};
+
+// One asset manifest row plus its optional content payload. `asset_json` is
+// the v3 asset row; content_path/content are empty for metadata-only rows.
+struct XTraceAsset {
+  XTraceProducerDescriptor producer;
+  string asset_json;
+  string content_path;
+  string content;
+};
+
+// Terminal watermark: the producer's last message on its pipe. Pipe
+// ordering makes "no further events after the watermark" a transport
+// guarantee.
+struct XTraceWatermark {
+  XTraceProducerDescriptor producer;
+  string final_producer_seq;
+  string eligible;
+  string enqueued;
+  string dropped;
+  uint32 assets_out;
+  // DP1 (P5): NADC entries on this producer thread rejected by the
+  // allocation-free TryEnter precheck — accounted, never silently dropped.
+  string nadc_partial;
+  // P5-R2a/R5 (chief review): outcome marks dropped for lack of an
+  // attributable scope (TLS depth overflow region) — the recorded gap.
+  string scope_overflow;
+};
+
+// Data plane: one pipe per producer thread. Batch is the only event path
+// (per-event Log was removed with the v1/v2 writers). The control endpoint
+// is delivered in-band on this pipe (once per renderer process): in the
+// ASG era process-level associated interfaces are frame-routed, so an
+// in-band endpoint avoids frame dependence and gives the browser a
+// renderer-death signal for free (remote disconnect).
+interface XTraceHost {
+  LogBatch(XTraceBatch batch);
+  LogAsset(XTraceAsset asset);
+  SubmitWatermark(XTraceWatermark watermark);
+  // Sent once per renderer process by whichever producer binds first.
+  // `control` is bound to this process's XTraceControl implementation.
+  ProvideControlEndpoint(XTraceProducerDescriptor producer,
+                         pending_remote<XTraceControl> control);
+};
+
+// Control plane: one instance per renderer process; the endpoint is
+// delivered in-band via XTraceHost.ProvideControlEndpoint (see the data
+// plane comment above for why).
+interface XTraceControl {
+  // Distributes a stop to this process's producer threads. `accepted` only
+  // means "distributed", never "settled": settlement evidence is each
+  // producer's watermark on its own XTraceHost pipe (draft V09: forwarding
+  // delivery counts are not acknowledgements).
+  StopCapture(string capture_id, uint32 deadline_ms) => (bool accepted);
+
+  // Runtime filter update (P3-E4): applies the new generation to every
+  // producer thread of this process. Confirmation evidence is each
+  // event's config_generation field — no applied-ACK is fabricated here.
+  // N3-part2: the observer scope selector rides the SAME message —
+  // contexts/scripts URL-substring patterns and the explicit
+  // denyInternal switch (see docs/chromium-p4-scope-selector-design.md).
+  UpdateConfig(string generation, string categories,
+               array<string> observerContextPatterns,
+               array<string> observerScriptPatterns,
+               bool observerDenyInternal) => (bool distributed);
+};
