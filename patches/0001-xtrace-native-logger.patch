+// found in Chromium's LICENSE file.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_XTRACE_HANDLER_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_XTRACE_HANDLER_H_
+
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "content/browser/devtools/protocol/devtools_domain_handler.h"
+#include "content/browser/devtools/protocol/xtrace.h"
+#include "content/common/content_export.h"
+
+namespace content {
+
+class DevToolsIOContext;
+
+namespace protocol {
+
+// XTrace capture control plane (P3-E2/E3): bridges the browser-only CDP
+// domain onto the P2 capture controller. Registered only on the browser
+// target; the DevToolsSession trust gate rejects untrusted sessions before
+// the handler is even created (IsDomainAvailableToUntrustedClient defaults
+// to false for handlers without an explicit override).
+class XTraceHandler final : public DevToolsDomainHandler,
+                            public XTrace::Backend {
+ public:
+  explicit XTraceHandler(DevToolsIOContext* io_context);
+  XTraceHandler(const XTraceHandler& other) = delete;
+  XTraceHandler& operator=(const XTraceHandler& other) = delete;
+  ~XTraceHandler() override;
+
+  // DevToolsDomainHandler implementation.
+  void Wire(UberDispatcher* dispatcher) override;
+
+  // XTrace::Backend implementation.
+  DispatchResponse GetCapabilities(
+      std::unique_ptr<protocol::XTrace::Capabilities>* out_capabilities)
+      override;
+  void StartCapture(
+      const String& in_categories,
+      std::optional<String> in_captureValues,
+      std::optional<String> in_captureAssets,
+      std::optional<String> in_causality,
+      std::optional<String> in_mode,
+      std::optional<String> in_tier,
+      std::unique_ptr<XTrace::Backend::StartCaptureCallback> callback)
+      override;
+  void UpdateCapture(
+      const String& in_categories,
+      std::unique_ptr<protocol::XTrace::ObserverScope> in_observerScope,
+      std::unique_ptr<XTrace::Backend::UpdateCaptureCallback> callback)
+      override;
+  DispatchResponse GetCaptureStatus(
+      String* out_captureId,
+      String* out_generation,
+      String* out_state,
+      std::unique_ptr<protocol::DictionaryValue>* out_config,
+      std::unique_ptr<protocol::Array<protocol::XTrace::ProducerStatus>>*
+          out_producers,
+      std::unique_ptr<protocol::XTrace::TerminalInfo>* out_terminal)
+      override;
+  void StopCapture(
+      std::unique_ptr<XTrace::Backend::StopCaptureCallback> callback)
+      override;
+
+ private:
+  raw_ptr<DevToolsIOContext> io_context_;
+};
+
+}  // namespace protocol
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_PROTOCOL_XTRACE_HANDLER_H_
