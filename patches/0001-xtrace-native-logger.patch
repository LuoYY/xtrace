@@ -0,0 +1,305 @@
+// Copyright 2026 The XTrace Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in Chromium's LICENSE file.
+
+#include "content/browser/xtrace/xtrace_capture_controller.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "content/public/test/browser_task_environment.h"
+#include "base/memory/raw_ptr.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/mojom/xtrace/xtrace.mojom.h"
+
+namespace content {
+
+namespace {
+
+blink::mojom::XTraceProducerDescriptorPtr MakeDescriptor(
+    const std::string& producer_id) {
+  auto d = blink::mojom::XTraceProducerDescriptor::New();
+  d->producer_id = producer_id;
+  d->process_epoch = "99.1";
+  d->pkind = producer_id.starts_with("rtw") ? "rtw" : "rtx";
+  d->config_generation = "0";
+  return d;
+}
+
+blink::mojom::XTraceBatchPtr MakeBatch(const std::string& producer_id,
+                                       uint64_t first_seq,
+                                       std::vector<std::string> lines) {
+  auto batch = blink::mojom::XTraceBatch::New();
+  batch->producer = MakeDescriptor(producer_id);
+  batch->first_producer_seq = base::NumberToString(first_seq);
+  batch->count = static_cast<uint32_t>(lines.size());
+  batch->event_json_lines = std::move(lines);
+  return batch;
+}
+
+blink::mojom::XTraceWatermarkPtr MakeWatermark(const std::string& producer_id,
+                                               uint64_t final_seq,
+                                               uint64_t eligible,
+                                               uint64_t enqueued,
+                                               uint64_t dropped) {
+  auto wm = blink::mojom::XTraceWatermark::New();
+  wm->producer = MakeDescriptor(producer_id);
+  wm->final_producer_seq = base::NumberToString(final_seq);
+  wm->eligible = base::NumberToString(eligible);
+  wm->enqueued = base::NumberToString(enqueued);
+  wm->dropped = base::NumberToString(dropped);
+  wm->assets_out = 0;
+  wm->nadc_partial = "0";
+  wm->scope_overflow = "0";
+  return wm;
+}
+
+}  // namespace
+
+// P3-E0 (A.2 debt): terminal adjudication of the capture controller,
+// driven through the real message handlers. Private access happens only in
+// fixture members (gtest subclasses do not inherit friendship). Instances
+// register an AtExit callback holding |this|, so they live for the process.
+class XTraceCaptureControllerTest : public ::testing::Test {
+ public:
+  void SetUp() override {
+    base::ScopedAllowBlockingForTesting allow_io;
+    CHECK(base::CreateNewTempDirectory(base::FilePath::StringType(), &dir_));
+    trace_ = dir_.AppendASCII("trace.ndjson");
+    controller_ = new XTraceCaptureController(trace_, "ctest-capture");
+    controller_->config_json_ = "{\"generation\":\"0\"}";
+  }
+
+  // Fixture-level accessors: friendship lives here, not in TEST_F bodies.
+  void SendBatch(blink::mojom::XTraceBatchPtr batch) {
+    controller_->OnLogBatch(std::move(batch));
+  }
+  void SendWatermark(blink::mojom::XTraceWatermarkPtr wm) {
+    controller_->OnWatermark(std::move(wm));
+  }
+  void AdjustWriterCounters(const std::string& id,
+                            uint64_t accepted,
+                            uint64_t written,
+                            uint64_t failed) {
+    ProducerState* state = controller_->FindProducer(id);
+    ASSERT_TRUE(state);
+    state->accepted = accepted;
+    state->written = written;
+    state->failed = failed;
+  }
+  void BeginStop() {
+    controller_->BeginStopOnWriter(50);
+    env_.RunUntilIdle();  // flush UI snapshot + writer continuation (P3-E5)
+  }
+  void FireDeadline() {
+    controller_->OnStopDeadline();
+    env_.RunUntilIdle();
+  }
+  void FinalizeNow() {
+    controller_->Finalize(std::string());
+    env_.RunUntilIdle();
+  }
+  bool IsFinalized() { return controller_->finalized_.load(); }
+
+  base::Value ReadManifest() {
+    base::ScopedAllowBlockingForTesting allow_io;
+    std::string text;
+    CHECK(base::ReadFileToString(dir_.AppendASCII("trace.manifest.json"),
+                                  &text));
+    auto parsed = base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+    CHECK(parsed.has_value()) << text;
+    return std::move(*parsed);
+  }
+  static std::string TerminalState(const base::Value& manifest) {
+    const std::string* v =
+        manifest.GetDict().FindStringByDottedPath("terminal.state");
+    return v ? *v : std::string("<missing>");
+  }
+  static std::string TerminalReason(const base::Value& manifest) {
+    const std::string* v =
+        manifest.GetDict().FindStringByDottedPath("terminal.reason");
+    return v ? *v : std::string();
+  }
+  static std::string Count(const base::Value& manifest, const char* field) {
+    const std::string* v = manifest.GetDict().FindStringByDottedPath(
+        std::string("counts.") + field);
+    return v ? *v : std::string("<missing>");
+  }
+  // Returns null/""/value for a producer row field (v1.2 null semantics).
+  static std::string ProducerField(const base::Value& manifest,
+                                   const std::string& id,
+                                   const char* field) {
+    const base::ListValue* producers = manifest.GetDict().FindList("producers");
+    if (!producers) {
+      return "<no-list>";
+    }
+    for (const base::Value& entry : *producers) {
+      const std::string* row_id = entry.GetDict().FindString("producer_id");
+      if (row_id && *row_id == id) {
+        const std::string* v = entry.GetDict().FindString(field);
+        return v ? *v : std::string("<null>");
+      }
+    }
+    return "<no-row>";
+  }
+
+ protected:
+  // BrowserTaskEnvironment: FinalizeLocked posts the identity snapshot
+  // to the browser UI runner (P3-E5), which needs a browser task executor.
+  content::BrowserTaskEnvironment env_;
+  base::FilePath dir_;
+  base::FilePath trace_;
+  raw_ptr<XTraceCaptureController> controller_;  // process-lifetime (AtExit hook)
+};
+
+// State 1: all confirmed, equations hold, no loss -> complete.
+TEST_F(XTraceCaptureControllerTest, CompleteWhenConfirmedAndConsistent) {
+  SendBatch(
+      MakeBatch("rtx:1.1:1:1", 1, {"{\"api\":\"a\"}", "{\"api\":\"b\"}"}));
+  SendWatermark(MakeWatermark("rtx:1.1:1:1", 2, 2, 2, 0));
+  BeginStop();
+
+  EXPECT_TRUE(IsFinalized());
+  base::Value m = ReadManifest();
+  EXPECT_EQ(TerminalState(m), "complete");
+  EXPECT_EQ(TerminalReason(m), "");
+  EXPECT_EQ(Count(m, "written"), "2");
+}
+
+// State 2: overflow (dropped > 0) -> incomplete, reason names the loss.
+TEST_F(XTraceCaptureControllerTest, IncompleteWhenDroppedPositive) {
+  SendBatch(MakeBatch("rtx:1.1:1:1", 1, {"{\"api\":\"a\"}"}));
+  // eligible 4 = enqueued 3 + dropped 1; writer accepted 3, wrote 1, failed 2.
+  AdjustWriterCounters("rtx:1.1:1:1", 3, 1, 2);
+  SendWatermark(MakeWatermark("rtx:1.1:1:1", 4, 4, 3, 1));
+  BeginStop();
+
+  base::Value m = ReadManifest();
+  EXPECT_EQ(TerminalState(m), "incomplete");
+  EXPECT_EQ(TerminalReason(m), "dropped>0");
+}
+
+// State 3: unconfirmed producer -> incomplete via stop timeout; v1.2 rules:
+// null producer-side counters in the row; global counts sum confirmed-only
+// producer-side fields (the visible equation gap is the evidence of loss).
+TEST_F(XTraceCaptureControllerTest, IncompleteUnconfirmedNullCounters) {
+  SendBatch(
+      MakeBatch("rtx:1.1:1:1", 1, {"{\"api\":\"a\"}", "{\"api\":\"b\"}"}));
+  SendBatch(MakeBatch("rtx:2.2:2:1", 1, {"{\"api\":\"c\"}"}));
+  // Only the first producer settles.
+  SendWatermark(MakeWatermark("rtx:1.1:1:1", 2, 2, 2, 0));
+  FireDeadline();
+
+  base::Value m = ReadManifest();
+  EXPECT_EQ(TerminalState(m), "incomplete");
+  EXPECT_NE(TerminalReason(m).find("stop-timeout:rtx:2.2:2:1"),
+            std::string::npos);
+
+  // Unknown producer-side counters are JSON null, never zero-filled.
+  EXPECT_EQ(ProducerField(m, "rtx:2.2:2:1", "eligible"), "<null>");
+  EXPECT_EQ(ProducerField(m, "rtx:2.2:2:1", "final_producer_seq"), "<null>");
+  // Writer-side counters remain measured for the gone producer.
+  EXPECT_EQ(ProducerField(m, "rtx:2.2:2:1", "accepted"), "1");
+  // Global: producer-side sums cover confirmed only (2), writer side all (3).
+  EXPECT_EQ(Count(m, "eligible"), "2");
+  EXPECT_EQ(Count(m, "accepted"), "3");
+}
+
+// State 4: nothing ever registered -> never reported as a success.
+TEST_F(XTraceCaptureControllerTest, IncompleteNoProducersObserved) {
+  FinalizeNow();
+  base::Value m = ReadManifest();
+  EXPECT_EQ(TerminalState(m), "incomplete");
+  EXPECT_EQ(TerminalReason(m), "no-producers-observed");
+}
+
+// A batch that lies about its count is rejected before acceptance.
+TEST_F(XTraceCaptureControllerTest, MalformedBatchNotAccepted) {
+  auto batch = MakeBatch("rtx:1.1:1:1", 1, {"{\"api\":\"a\"}"});
+  batch->count = 2;
+  SendBatch(std::move(batch));
+  SendWatermark(MakeWatermark("rtx:1.1:1:1", 1, 1, 1, 0));
+  // enqueued(1) != accepted(0): inconsistent counts -> incomplete.
+  BeginStop();
+  base::Value m = ReadManifest();
+  EXPECT_EQ(TerminalState(m), "incomplete");
+  EXPECT_EQ(TerminalReason(m), "inconsistent-counts");
+}
+
+// F1/B7: applied/pending track EVENT evidence (records stamped with the
+// target generation), not watermark confirmation — two separate axes.
+TEST_F(XTraceCaptureControllerTest, AppliedPendingByObservedGeneration) {
+  controller_->SetStatusConfigForTesting("2", "fingerprint");
+  SendBatch(MakeBatch("rtx:1.1:1:1", 1,
+                      {"{\"api\":\"a\",\"config_generation\":\"2\"}"}));
+  SendBatch(MakeBatch("rtx:2.2:2:1", 1,
+                      {"{\"api\":\"c\",\"config_generation\":\"1\"}"}));
+  auto applied = controller_->DomainProducersAppliedTo(2);
+  auto pending = controller_->DomainProducersPendingOn(2);
+  ASSERT_EQ(applied.size(), 1u);
+  EXPECT_EQ(applied[0], "rtx:1.1:1:1");
+  ASSERT_EQ(pending.size(), 1u);
+  EXPECT_EQ(pending[0], "rtx:2.2:2:1");
+  // Neither has a watermark: the unconfirmed axis is independent.
+  EXPECT_EQ(controller_->DomainUnconfirmedProducers().size(), 2u);
+}
+
+// F1/B7: updateCapture stores the categories; the manifest discloses the
+// effective config at settlement next to the historical startup snapshot.
+TEST_F(XTraceCaptureControllerTest, UpdateStoresCategoriesAndManifestDiscloses) {
+  const std::string gen = controller_->DomainUpdateCapture("fingerprint", nullptr);
+  EXPECT_EQ(gen, "1");
+  EXPECT_EQ(controller_->current_generation(), "1");
+  EXPECT_EQ(controller_->current_categories(), "fingerprint");
+  SendBatch(MakeBatch("rtx:1.1:1:1", 1,
+                      {"{\"api\":\"a\",\"config_generation\":\"1\"}"}));
+  SendWatermark(MakeWatermark("rtx:1.1:1:1", 1, 1, 1, 0));
+  BeginStop();
+  base::Value m = ReadManifest();
+  EXPECT_EQ(TerminalState(m), "complete");
+  const std::string* eff_gen =
+      m.GetDict().FindStringByDottedPath("effective_config.generation");
+  const std::string* eff_cat =
+      m.GetDict().FindStringByDottedPath("effective_config.categories");
+  ASSERT_TRUE(eff_gen);
+  ASSERT_TRUE(eff_cat);
+  EXPECT_EQ(*eff_gen, "1");
+  EXPECT_EQ(*eff_cat, "fingerprint");
+  // The startup snapshot stays historical (generation 0).
+  const std::string* start_gen =
+      m.GetDict().FindStringByDottedPath("config.generation");
+  ASSERT_TRUE(start_gen);
+  EXPECT_EQ(*start_gen, "0");
