+std::string XTraceCaptureController::DomainStateName() {
+  base::AutoLock lock(writer_lock_);
+  if (finalized_.load(std::memory_order_acquire)) {
+    return last_terminal_state_.empty() ? "incomplete" : last_terminal_state_;
+  }
+  if (stopping_) {
+    return "stopping";
+  }
+  return producers_.empty() ? "idle" : "active";
