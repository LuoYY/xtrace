+}  // namespace
+
+// static
+XTraceCaptureController* XTraceCaptureController::Get() {
+  XTraceCaptureController* controller =
+      g_controller.load(std::memory_order_acquire);
+  if (controller != nullptr ||
+      g_controller_initialized.load(std::memory_order_acquire)) {
+    return controller;  // may be null when capture is disabled
+  }
+  g_controller_initialized.store(true, std::memory_order_release);
+  std::optional<base::FilePath> trace_file = ReadTraceFilePathFromRuntime();
+  if (!trace_file) {
+    return nullptr;
+  }
+  const int64_t wall_us =
+      (base::Time::Now() - base::Time::UnixEpoch()).InMicroseconds();
+  std::string nonce = base::HexEncode(crypto::SHA256HashString(
+      base::NumberToString(wall_us) + ":" +
+      base::NumberToString(base::GetCurrentProcId())));
+  nonce = nonce.substr(0, 8);
+  std::string capture_id = "c" + base::NumberToString(wall_us) + "-" +
+                           base::NumberToString(base::GetCurrentProcId()) +
+                           "-" + nonce;
+  // Startup config snapshot for the manifest (schema v3 §6).
+  std::string config_json =
+      "{\"generation\":\"0\",\"categories\":" +
+      base::GetQuotedJSONString(
+          SwitchValueOr(kCategoriesSwitch, "reverse,fingerprint")) +
+      ",\"capture_values\":" +
+      base::GetQuotedJSONString(SwitchValueOr(kCaptureValuesSwitch, "full")) +
+      ",\"capture_assets\":" +
+      base::GetQuotedJSONString(SwitchValueOr(kCaptureAssetsSwitch, "full")) +
+      ",\"causality\":" +
+      base::GetQuotedJSONString(SwitchValueOr(kCausalitySwitch, "off")) +
+      ",\"max_body_bytes\":\"" + SwitchValueOr(kMaxBodyBytesSwitch, "0") +
+      "\",\"max_header_value_bytes\":\"" +
+      SwitchValueOr(kMaxHeaderValueBytesSwitch, "0") + "\"}";
+  XTraceCaptureController* created =
+      new XTraceCaptureController(*trace_file, std::move(capture_id));
+  created->config_json_ = std::move(config_json);
+  created->status_categories_ =
+      SwitchValueOr(kCategoriesSwitch, "reverse,fingerprint");
+  g_controller.store(created, std::memory_order_release);
+  created->MaybeScheduleTestStop();
+  return created;
+}
+
+// static
+scoped_refptr<base::SequencedTaskRunner>
+XTraceCaptureController::WriterRunner() {
+  // DP5: BLOCK_SHUTDOWN so a graceful browser exit drains queued writes
+  // and the manifest task; the finalizer never waits on remote processes,
+  // so these tasks are bounded and cannot hang shutdown.
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> runner(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN,
+           base::TaskPriority::USER_VISIBLE}));
+  return *runner;
+}
+
+XTraceCaptureController::XTraceCaptureController(
+    const base::FilePath& trace_file_path, std::string capture_id)
+    : trace_file_path_(trace_file_path),
+      capture_id_(std::move(capture_id)),
+      trace_stem_(trace_file_path.BaseName().RemoveExtension().AsUTF8Unsafe()) {
+  DETACH_FROM_SEQUENCE(writer_sequence_);
+  // stop_timer_ binds its runner at Start() time, which only happens in
+  // BeginStopOnWriter on the writer sequence (Get() may first run on any
+  // thread, and SetTaskRunner here would DCHECK).
+  // Guaranteed last-ditch settlement: exit callbacks run after the thread
+  // pool has joined, on any process exit that unwinds main() — including
+  // the mac NSApp-terminate path where browser teardown hooks are skipped.
+  base::AtExitManager::RegisterCallback(
+      [](void* controller) {
+        static_cast<XTraceCaptureController*>(controller)
+            ->FinalizeForProcessExit();
+      },
+      this);
+}
+
+void XTraceCaptureController::FinalizeForProcessExit() {
+  if (finalized_.load(std::memory_order_acquire)) {
+    return;
+  }
+  base::AutoLock lock(writer_lock_);
+  if (finalized_.load(std::memory_order_acquire)) {
+    return;
+  }
+  finalized_.store(true, std::memory_order_release);
+  // Do NOT touch stop_timer_ here: it belongs to the writer sequence and
+  // this path runs on the exiting thread; the finalized_ gate already
+  // neutralizes any later timer callback.
+  WriteManifestRaw("incomplete", "browser-shutdown");
+}
+
+void XTraceCaptureController::BindXTraceHostReceiver(
+    mojo::PendingReceiver<blink::mojom::XTraceHost> receiver) {
+  WriterRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<XTraceCaptureController> weak,
+             mojo::PendingReceiver<blink::mojom::XTraceHost> receiver) {
+            if (!weak) {
+              return;
+            }
+            // Thin per-pipe shim; forwards into the controller's
+            // writer-runner handlers. Self-owned until disconnect.
+            class HostImpl : public blink::mojom::XTraceHost {
+             public:
+              explicit HostImpl(base::WeakPtr<XTraceCaptureController> w)
+                  : weak_(std::move(w)) {}
+              void LogBatch(blink::mojom::XTraceBatchPtr batch) override {
+                if (weak_) {
+                  weak_->OnLogBatch(std::move(batch));
+                }
+              }
+              void LogAsset(blink::mojom::XTraceAssetPtr asset) override {
+                if (weak_) {
+                  weak_->OnLogAsset(std::move(asset));
+                }
+              }
+              void SubmitWatermark(
+                  blink::mojom::XTraceWatermarkPtr watermark) override {
+                if (weak_) {
+                  weak_->OnWatermark(std::move(watermark));
+                }
+              }
+              void ProvideControlEndpoint(
+                  blink::mojom::XTraceProducerDescriptorPtr producer,
+                  mojo::PendingRemote<blink::mojom::XTraceControl> control)
+                  override {
+                if (weak_) {
+                  weak_->OnProvideControlEndpoint(std::move(producer),
+                                                  std::move(control));
+                }
+              }
+
+             private:
+              base::WeakPtr<XTraceCaptureController> weak_;
+            };
+            mojo::MakeSelfOwnedReceiver(
+                std::make_unique<HostImpl>(weak), std::move(receiver));
+          },
+          weak_factory_.GetWeakPtr(), std::move(receiver)));
+}
+
+void XTraceCaptureController::AcceptBrowserNetworkEvent(
+    std::string event_json) {
+  if (event_json.empty() || finalized_.load(std::memory_order_acquire)) {
+    return;
+  }
+  WriterRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<XTraceCaptureController> weak, std::string json) {
+            if (weak) {
+              weak->OnBrowserNetworkEventLocked(std::move(json));
+            }
+          },
+          weak_factory_.GetWeakPtr(), std::move(event_json)));
+}
+
+void XTraceCaptureController::MaybeScheduleTestStop() {
+  // P3-E6: --xtrace-stop-after-ms removed; XTrace.stopCapture (domain) is
+  // the sanctioned stop trigger. Launch-time captures that never receive
+  // a domain stop settle via the browser-shutdown path.
+}
+
+
+void XTraceCaptureController::RequestStop(uint32_t deadline_ms) {
+  {
+    // The domain's stopCapture must observe "stopping" synchronously; the
+    // writer-runner task only formalizes it later.
+    base::AutoLock lock(writer_lock_);
+    stopping_ = true;
+  }
+  WriterRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<XTraceCaptureController> weak, uint32_t deadline) {
+            if (weak) {
+              weak->BeginStopOnWriter(deadline);
+            }
+          },
+          weak_factory_.GetWeakPtr(), deadline_ms));
+}
+
+void XTraceCaptureController::NotifyBrowserShuttingDown() {
+  // Synchronous: the caller sits on an exit path that may bypass message
+  // loops and atexit entirely (immediate exit). FinalizeForProcessExit is
+  // idempotent and mutex-guarded for exactly this cross-thread call.
+  FinalizeForProcessExit();
+}
+
+void XTraceCaptureController::RegisterProducer(
+    const blink::mojom::XTraceProducerDescriptor& d) {
+  if (!producers_.count(d.producer_id)) {
+    auto state = std::make_unique<ProducerState>();
+    state->producer_id = d.producer_id;
+    state->process_epoch = d.process_epoch;
+    state->pkind = d.pkind;
+    if (d.worker) {
+      state->worker = true;
+      state->worker_kind = d.worker->kind;
+      state->worker_scope = d.worker->scope_url;
+    }
+    producers_[d.producer_id] = std::move(state);
+  }
+}
+
+ProducerState* XTraceCaptureController::FindProducer(
+    const std::string& producer_id) {
+  auto it = producers_.find(producer_id);
+  return it == producers_.end() ? nullptr : it->second.get();
+}
+
+std::string XTraceCaptureController::StampWriterFields(std::string json) {
+  const size_t object_end = json.find_last_not_of(" \t\r\n");
+  if (object_end == std::string::npos || json[object_end] != '}') {
+    return std::string();
+  }
+  std::string tail = ",\"writer_seq\":\"" +
+                     base::NumberToString(next_writer_seq_++) +
+                     "\",\"capture_id\":" +
+                     base::GetQuotedJSONString(capture_id_);
+  json.insert(object_end, tail);
+  return json;
+}
+
+bool XTraceCaptureController::EnsureTraceFile() {
+  if (trace_file_.IsValid()) {
+    return true;
+  }
+  if (!base::CreateDirectory(trace_file_path_.DirName())) {
+    return false;
+  }
+  // F5 (review B6): a non-empty trace file at the target path means a
+  // previous capture's records are there — appending would mix captures
+  // (validator rejects mixed identity, but the writer must not create
+  // the mess in the first place). Refuse instead of appending; the
+  // failure surfaces through the normal failed-write accounting.
+  {
+    base::File existing(trace_file_path_,
+                        base::File::FLAG_OPEN | base::File::FLAG_READ);
+    if (existing.IsValid()) {
+      const int64_t size = existing.GetLength();
+      if (size > 0) {
+        DLOG(WARNING) << "XTrace refusing to append to non-empty trace "
+                      << trace_file_path_.AsUTF8Unsafe() << " (" << size
+                      << " bytes from a previous capture)";
+        return false;
+      }
+    }
+  }
+  trace_file_.Initialize(trace_file_path_,
+                         base::File::FLAG_OPEN_ALWAYS | base::File::FLAG_APPEND);
+  return trace_file_.IsValid();
+}
+
+bool XTraceCaptureController::EnsureAssetManifestFile() {
+  if (asset_manifest_file_.IsValid()) {
+    return true;
+  }
+  base::FilePath manifest_path =
+      trace_file_path_.DirName().AppendASCII("assets")
+          .Append(base::FilePath::FromUTF8Unsafe(trace_stem_))
+          .AppendASCII("manifest.ndjson");
+  if (!base::CreateDirectory(manifest_path.DirName())) {
+    return false;
+  }
+  asset_manifest_file_.Initialize(
+      manifest_path, base::File::FLAG_OPEN_ALWAYS | base::File::FLAG_APPEND);
+  return asset_manifest_file_.IsValid();
+}
+
+bool XTraceCaptureController::WriteLine(base::File& file,
+                                        const std::string& json) {
+  if (!file.WriteAtCurrentPosAndCheck(base::as_byte_span(json))) {
+    return false;
+  }
+  static constexpr char kNewline[] = "\n";
+  return json.empty() || json.back() == '\n' ||
+         file.WriteAtCurrentPosAndCheck(base::byte_span_from_cstring(kNewline));
+}
+
+void XTraceCaptureController::OnLogBatch(blink::mojom::XTraceBatchPtr batch) {
+  {
+    base::AutoLock lock(writer_lock_);
+    DCHECK_CALLED_ON_VALID_SEQUENCE(writer_sequence_);
+    if (finalized_.load(std::memory_order_acquire)) {
+      return;
+    }
+    RegisterProducer(*batch->producer);
+    ProducerState* state = FindProducer(batch->producer->producer_id);
+    if (!state || batch->event_json_lines.size() != batch->count) {
+      return;  // malformed batch: rejected before acceptance accounting
+    }
+    if (!EnsureTraceFile()) {
+      trace_write_failed_ = true;
+      state->accepted += batch->count;
+      state->failed += batch->count;
+      return;
+    }
+    for (const std::string& raw : batch->event_json_lines) {
+      // F1/B7: the writer observes each record's declared generation —
+      // applied/pending accounting comes from event evidence, never from
+      // distribution counts (draft §8.3).
+      ObserveGenerationLocked(state, raw);
+      std::string line = StampWriterFields(raw);
+      if (line.empty() || !WriteLine(trace_file_, line)) {
+        trace_write_failed_ = true;
+        ++state->failed;
+      } else {
+        ++state->written;
+      }
+      ++state->accepted;
+    }
+  }
+}
+
+void XTraceCaptureController::ObserveGenerationLocked(ProducerState* state,
+                                                      const std::string& raw) {
+  // Writer lock held. The identity tail appended by the renderer producer
+  // is the only generation evidence (events, not distribution counts).
+  static constexpr char kGenerationKey[] = "\"config_generation\":\"";
+  const size_t key = raw.find(kGenerationKey);
+  if (key == std::string::npos) {
+    return;
+  }
+  const size_t start = key + sizeof(kGenerationKey) - 1;
+  const size_t end = raw.find('"', start);
+  if (end == std::string::npos) {
+    return;
+  }
+  uint64_t generation = 0;
+  if (base::StringToUint64(raw.substr(start, end - start), &generation)) {
+    state->observed_generation =
+        std::max(state->observed_generation, generation);
+  }
+}
+
+void XTraceCaptureController::OnLogAsset(blink::mojom::XTraceAssetPtr asset) {
+  {
+    base::AutoLock lock(writer_lock_);
+    DCHECK_CALLED_ON_VALID_SEQUENCE(writer_sequence_);
+    if (finalized_.load(std::memory_order_acquire) || asset->asset_json.empty()) {
+      return;
+    }
+    RegisterProducer(*asset->producer);
+    ProducerState* state = FindProducer(asset->producer->producer_id);
+    if (!state) {
+      return;
+    }
+    // Schema v3 §5.3: asset rows carry the producer identity; stamp it along
+    // with the writer fields (rows arrive without either).
+    const size_t row_open = asset->asset_json.find('{');
+    if (row_open != std::string::npos) {
+      asset->asset_json.insert(
+          row_open + 1, "\"producer_id\":" +
+                           base::GetQuotedJSONString(
+                               asset->producer->producer_id) +
+                           ",");
+    }
+    std::string row = StampWriterFields(std::move(asset->asset_json));
+    if (row.empty()) {
+      ++state->assets_failed;
+      return;
+    }
+    if (!asset->content_path.empty() && !asset->content.empty() &&
+        asset->content_path[0] != '/' &&
+        asset->content_path.find("..") == std::string::npos) {
+      base::FilePath asset_path = trace_file_path_.DirName().Append(
+          base::FilePath::FromUTF8Unsafe(asset->content_path));
+      if (!base::CreateDirectory(asset_path.DirName())) {
+        ++state->assets_failed;
+      } else {
+        base::File content_file(
+            asset_path, base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+        if (!content_file.IsValid() ||
+            !content_file.WriteAtCurrentPosAndCheck(
+                base::as_byte_span(asset->content))) {
+          ++state->assets_failed;
+        }
+      }
+    }
+    if (!EnsureAssetManifestFile() || !WriteLine(asset_manifest_file_, row)) {
+      ++state->assets_failed;
+      return;
+    }
+    ++state->assets_written;
+    ++asset_rows_written_;
+  }
+}
+
+void XTraceCaptureController::OnWatermark(
+    blink::mojom::XTraceWatermarkPtr watermark) {
+  {
+    base::AutoLock lock(writer_lock_);
+    DCHECK_CALLED_ON_VALID_SEQUENCE(writer_sequence_);
+    if (finalized_.load(std::memory_order_acquire)) {
+      return;
+    }
+    RegisterProducer(*watermark->producer);
+    ProducerState* state = FindProducer(watermark->producer->producer_id);
+    if (!state) {
+      return;
+    }
+    uint64_t final_seq = 0, eligible = 0, enqueued = 0, dropped = 0;
+    uint64_t nadc_partial = 0;
+    base::StringToUint64(watermark->final_producer_seq, &final_seq);
+    base::StringToUint64(watermark->eligible, &eligible);
+    base::StringToUint64(watermark->enqueued, &enqueued);
+    base::StringToUint64(watermark->dropped, &dropped);
+    uint64_t scope_overflow = 0;
+    base::StringToUint64(watermark->nadc_partial, &nadc_partial);
+    base::StringToUint64(watermark->scope_overflow, &scope_overflow);
+    state->final_producer_seq = final_seq;
+    state->eligible = eligible;
+    state->enqueued = enqueued;
+    state->dropped = dropped;
+    state->nadc_partial = nadc_partial;
+    state->scope_overflow = scope_overflow;
+    state->assets_out = watermark->assets_out;
+    state->watermark_received = true;
+    state->pipe_alive = false;  // watermark is the pipe's last word
+    MaybeFinalizeForStopSettled();
+  }
+}
+
+void XTraceCaptureController::OnProvideControlEndpoint(
+    blink::mojom::XTraceProducerDescriptorPtr producer,
+    mojo::PendingRemote<blink::mojom::XTraceControl> control) {
+  {
+    base::AutoLock lock(writer_lock_);
+    DCHECK_CALLED_ON_VALID_SEQUENCE(writer_sequence_);
+    if (finalized_.load(std::memory_order_acquire) || !control.is_valid()) {
+      return;
+    }
+    RegisterProducer(*producer);
+    const std::string epoch = producer->process_epoch;
+    if (control_remotes_by_epoch_.count(epoch)) {
+      return;  // one endpoint per process; first wins
+    }
+    mojo::Remote<blink::mojom::XTraceControl> remote(std::move(control));
+    remote.set_disconnect_handler(base::BindOnce(
+        [](base::WeakPtr<XTraceCaptureController> weak,
+           const std::string& process_epoch) {
+          if (weak) {
+            weak->OnControlDisconnected(process_epoch);
+          }
+        },
+        weak_factory_.GetWeakPtr(), epoch));
+    control_remotes_by_epoch_[epoch] = std::move(remote);
+    // F1/B7 + N3-part2 barrier: a renderer registering at ANY time
+    // receives the current effective config — including generation "0".
+    // The arrival releases the renderer's first-config barrier, making
+    // "no observation before confirmation" deterministic for zero-wait
+    // first scripts.
+    control_remotes_by_epoch_[epoch]->UpdateConfig(
+        status_generation_, status_categories_,
+        status_observer_scope_.context_patterns,
+        status_observer_scope_.script_patterns,
+        status_observer_scope_.deny_internal,
+        base::BindOnce([](bool distributed) {}));
+  }
+}
+
+void XTraceCaptureController::OnControlDisconnected(
+    const std::string& process_epoch) {
+  {
+    base::AutoLock lock(writer_lock_);
+    DCHECK_CALLED_ON_VALID_SEQUENCE(writer_sequence_);
+    control_remotes_by_epoch_.erase(process_epoch);
+    if (finalized_.load(std::memory_order_acquire) || producers_.empty()) {
+      return;
+    }
+    if (!control_remotes_by_epoch_.empty()) {
+      return;  // other renderer processes still live
+    }
+    // Every renderer endpoint is gone. Whole-browser quit settles what
+    // already reached the writer (DP5 shutdown path); renderer loss without
+    // a quit leaves settlement to the normal stop path or its deadline.
+    const bool quitting = GetContentClient()->browser()->IsShuttingDown();
+    if (quitting) {
+      FinalizeLocked("browser-shutdown");
+    }
+  }
+}
+
+void XTraceCaptureController::OnBrowserNetworkEventLocked(std::string json) {
+  {
+    base::AutoLock lock(writer_lock_);
+    DCHECK_CALLED_ON_VALID_SEQUENCE(writer_sequence_);
+    // Outside the capture window once stopping begins: the synthesized bnet
+    // watermark in BeginStopOnWriter is final, and later events would write
+    // sequence numbers beyond it (observed by the validator as a real race).
+    if (stopping_ || finalized_.load(std::memory_order_acquire)) {
+      return;
+    }
+    // The browser-network producer is local: one synthetic producer identity,
+    // counted through the same conservation accounting. In-process
+    // submission means eligible/enqueued equal accepted here.
+    if (!bnet_state_) {
+      // Schema v3 §4.2 (v1.2): bnet follows the five-segment format —
+      // real browser process epoch, writer-thread tid, lseq fixed at 1.
+      const std::string epoch = MakeBrowserProcessEpoch();
+      const std::string producer_id =
+          "bnet:" + epoch + ":" +
+          base::NumberToString(base::PlatformThread::CurrentId().raw()) + ":1";
+      auto state = std::make_unique<ProducerState>();
+      state->producer_id = producer_id;
+      state->process_epoch = epoch;
+      state->pkind = "bnet";
+      bnet_state_ = state.get();
+      producers_[producer_id] = std::move(state);
+    }
+    ProducerState* state = bnet_state_;
+    const uint64_t seq = state->accepted + 1;
+    ++state->eligible;
+    ++state->enqueued;
+    ++state->accepted;
+    // Stamp the local producer identity (single producer: producer_seq ==
+    // accepted count) plus the writer fields. The generation is the
+    // controller's current effective config (F1/B7) — the browser-local
+    // producer is in the same authority domain as updateCapture itself.
+    const size_t close = json.find_last_of('}');
+    if (close != std::string::npos) {
+      json.insert(close,
+                  ",\"producer_seq\":\"" + base::NumberToString(seq) +
+                      "\",\"producer_id\":\"" + state->producer_id +
+                      "\",\"process_epoch\":\"local\""
+                      ",\"config_generation\":\"" + status_generation_ +
+                      "\"");
+      ObserveGenerationLocked(state, json);
+    }
+    std::string line = StampWriterFields(std::move(json));
+    if (line.empty() || !EnsureTraceFile() || !WriteLine(trace_file_, line)) {
+      trace_write_failed_ = true;
+      ++state->failed;
+    } else {
+      ++state->written;
+    }
+  }
+}
+
+void XTraceCaptureController::BeginStopOnWriter(uint32_t deadline_ms) {
+  {
+    base::AutoLock lock(writer_lock_);
+    DCHECK_CALLED_ON_VALID_SEQUENCE(writer_sequence_);
+    if (stop_distributed_ || finalized_.load(std::memory_order_acquire)) {
+      return;  // idempotent: eager stop flag (RequestStop) is not the guard
+    }
+    stop_distributed_ = true;
+    stopping_ = true;
+    stop_deadline_ms_ = deadline_ms;
+    // The local browser-network producer settles immediately (in-process;
+    // nothing to wait for).
+    if (bnet_state_) {
+      bnet_state_->final_producer_seq = bnet_state_->accepted;
+      bnet_state_->dropped = 0;
+      bnet_state_->watermark_received = true;
+      bnet_state_->pipe_alive = false;
+    }
+    // Distribute the stop through each renderer's in-band control endpoint.
+    // Delivery is distribution, never acknowledgement (draft V09): settlement
+    // counts watermarks on the data pipes.
+    for (auto& [epoch, remote] : control_remotes_by_epoch_) {
+      remote->StopCapture(
+          capture_id_, deadline_ms,
+          base::BindOnce([](bool accepted) {
+            // Distribution ack only; ignored for settlement.
+          }));
+    }
+    MaybeFinalizeForStopSettled();
+    if (!finalized_) {
+      stop_timer_.Start(
+          FROM_HERE, base::Milliseconds(deadline_ms),
+          base::BindOnce(&XTraceCaptureController::OnStopDeadline,
+                         base::Unretained(this)));
+    }
+  }
+}
+
+void XTraceCaptureController::MaybeFinalizeForStopSettled() {
+  // Internal: caller holds writer_lock_.
+  DCHECK_CALLED_ON_VALID_SEQUENCE(writer_sequence_);
+  if (!stopping_ || finalized_.load(std::memory_order_acquire)) {
+    return;
+  }
+  for (const auto& [id, state] : producers_) {
+    if (!state->watermark_received) {
+      return;  // still waiting on renderer watermarks (or the deadline)
+    }
+  }
+  stop_timer_.Stop();
+  FinalizeLocked(std::string());
+
+}
+
+void XTraceCaptureController::OnStopDeadline() {
+  // Stop timeout: report the unconfirmed producers; the timeout itself
+  // does not authorize killing any process (draft §7.4).
+  std::string unconfirmed;
+  {
+    base::AutoLock lock(writer_lock_);
+    if (finalized_.load(std::memory_order_acquire)) {
+      return;
+    }
+    for (const auto& [id, state] : producers_) {
+      if (!state->watermark_received) {
+        unconfirmed += (unconfirmed.empty() ? "" : ",") + id;
+      }
+    }
+    FinalizeLocked(unconfirmed.empty() ? std::string("stop-timeout")
+                                       : "stop-timeout:" + unconfirmed);
+  }
+}
+
+void XTraceCaptureController::Finalize(const std::string& reason) {
+  // Writer-sequence entry; the exit path uses FinalizeForProcessExit.
+  base::AutoLock lock(writer_lock_);
+  FinalizeLocked(reason);
+}
