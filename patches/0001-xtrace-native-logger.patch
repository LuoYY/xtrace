@@ -0,0 +1,509 @@
+// Copyright 2026 The XTrace Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in Chromium's LICENSE file.
+
+#include "third_party/blink/renderer/platform/xtrace/xtrace_producer.h"
+
+#include "third_party/blink/renderer/platform/xtrace/xtrace-ignition-bridge.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/environment.h"
+#include "base/functional/bind.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "base/no_destructor.h"
+#include "base/functional/callback.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/mojom/xtrace/xtrace.mojom.h"
+#include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
+#include "third_party/blink/public/platform/platform.h"
+#include "third_party/blink/public/platform/xtrace_control.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/blink/renderer/platform/wtf/wtf.h"
+
+namespace blink::xtrace {
+
+namespace {
+
+constexpr char kEnableSwitch[] = "xtrace-enable";
+constexpr char kFileSwitch[] = "xtrace-file";
+constexpr char kEnableEnv[] = "XTRACE_ENABLE";
+constexpr char kFileEnv[] = "XTRACE_FILE";
+// Launch categories for the initial effective-config snapshot. Precedence
+// must stay identical to ReadConfigFromRuntime in xtrace_logger.cc (switch
+// first, then env, then the same default).
+constexpr char kCategoriesSwitch[] = "xtrace-categories";
+constexpr char kCategoriesEnv[] = "XTRACE_CATEGORIES";
+
+std::string ReadLaunchCategories() {
+  std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kCategoriesSwitch);
+  if (!value.empty()) {
+    return value;
+  }
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> from_env = env->GetVar(kCategoriesEnv);
+  if (from_env && !from_env->empty()) {
+    return *from_env;
+  }
+  return std::string("reverse,fingerprint");
+}
+
+// XTRACE_TEST_SCAFFOLDING (P3-E6, ruled keep+rename): the long-term
+// test-only override shrinks producer buffers so fault injection gets
+// deterministic overflow through the REAL drop-newest accounting path.
+// Not exposed through the launcher; unit tests use the seam directly.
+constexpr char kTestCapacitySwitch[] = "xtrace-test-buffer-capacity";
+
+// Test seam (P3-E0): in-process host replacement slot.
+XTraceThreadProducer::HostFactoryForTesting& HostFactorySlot() {
+  static base::NoDestructor<XTraceThreadProducer::HostFactoryForTesting>
+      slot;
+  return *slot;
+}
+
+bool CaptureRuntimeEnabled() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(kEnableSwitch) &&
+      !command_line->GetSwitchValueNative(kFileSwitch).empty()) {
+    return true;
+  }
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::optional<std::string> enabled = env->GetVar(kEnableEnv);
+  std::optional<std::string> file = env->GetVar(kFileEnv);
+  return enabled && *enabled == "1" && file && !file->empty();
+}
+
+uint32_t ParseTestCapacitySwitchForTest(const std::string& value);
+uint32_t ParseTestCapacitySwitch(const std::string& value) {
+  // Extracted for unit testing (P3-E0): decimal > 0 or 0 (no override).
+  unsigned parsed = 0;
+  if (value.empty() || !base::StringToUint(value, &parsed) || parsed == 0) {
+    return 0;
+  }
+  return base::saturated_cast<uint32_t>(parsed);
+}
+
+std::string MakeProcessEpoch() {
+  // True process creation time is not portably exposed; the first-use
+  // monotonic tick is unique per process instance (two processes reusing
+  // one pid necessarily start at different ticks), which is all the
+  // epoch field promises (schema v3 §3.1).
+  return base::NumberToString(base::GetCurrentProcId()) + "." +
+         base::NumberToString(
+             base::TimeTicks::Now().since_origin().InMicroseconds());
+}
+
+}  // namespace
+
+//
+// XTraceProducerHub
+//
+
+uint32_t ParseTestCapacitySwitchForTest(const std::string& value) {
+  return ParseTestCapacitySwitch(value);
+}
+
+XTraceProducerHub::XTraceProducerHub()
+    : process_epoch_(MakeProcessEpoch()) {
+  // XTRACE_TEST_SCAFFOLDING consumption point (definition: kTestCapacitySwitch
+  // above). See the comment there; P3 removes switch parsing and this block.
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  config_.buffer_capacity =
+      ParseTestCapacitySwitch(
+          command_line->GetSwitchValueASCII(kTestCapacitySwitch)) ?: 4096;
+  // F1/B7: the initial effective snapshot mirrors the launch categories so
+  // filter + generation agree before the first UpdateConfig arrives.
+  auto initial = std::make_shared<EffectiveCaptureConfig>();
+  initial->categories = ReadLaunchCategories();
+  effective_config_ = std::move(initial);
+}
+
+XTraceProducerHub* XTraceProducerHub::Get() {
+  static base::NoDestructor<XTraceProducerHub> hub;
+  return hub.get();
+}
+
+uint64_t XTraceProducerHub::NextLseq() {
+  return next_lseq_.fetch_add(1, std::memory_order_relaxed) + 1;
+}
+
+uint64_t XTraceProducerHub::Register(
+    std::shared_ptr<RegistryEntry> entry) {
+  base::AutoLock lock(lock_);
+  const uint64_t id = next_registry_id_++;
+  registry_[id] = std::move(entry);
+  return id;
+}
+
+void XTraceProducerHub::Unregister(uint64_t registry_id) {
+  base::AutoLock lock(lock_);
+  registry_.erase(registry_id);
+}
+
+std::string XTraceProducerHub::current_generation() const {
+  return SnapshotConfig()->generation;
+}
+
+std::shared_ptr<const EffectiveCaptureConfig>
+XTraceProducerHub::SnapshotConfig() const {
+  base::AutoLock lock(config_lock_);
+  return effective_config_;
+}
+
+void XTraceProducerHub::SetCurrentConfig(
+    const std::string& generation, const std::string& categories,
+    const ObserverScopeConfig& observer_scope) {
+  auto next = std::make_shared<EffectiveCaptureConfig>();
+  next->generation = generation;
+  next->categories = categories;
+  next->observer_scope = observer_scope;
+  base::AutoLock lock(config_lock_);
+  effective_config_ = std::move(next);
+  config_received_.store(true, std::memory_order_release);
+}
+
+void XTraceProducerHub::ResetForTesting() {
+  base::AutoLock lock(lock_);
+  stopping_.store(false, std::memory_order_release);
+  registry_.clear();
+}
+
+// static
+void XTraceThreadProducer::SetHostFactoryForTesting(
+    HostFactoryForTesting factory) {
+  HostFactorySlot() = std::move(factory);
+}
+
+void XTraceProducerHub::BeginStop() {
+  stopping_.store(true, std::memory_order_release);
+  // F2 (review B1): stop closes every live isolate's Ignition observer —
+  // no later activation may reopen it.
+  IgnitionBridge::Close();
+  // Draft V09: the number of forwarded settle tasks is NOT an
+  // acknowledgement. Settlement evidence is each producer's watermark on
+  // its own XTraceHost pipe; the browser side counts only watermarks.
+  std::vector<std::shared_ptr<RegistryEntry>> entries;
+  {
+    base::AutoLock lock(lock_);
+    entries.reserve(registry_.size());
+    for (const auto& [id, entry] : registry_) {
+      entries.push_back(entry);
+    }
+  }
+  for (const auto& entry : entries) {
+    if (!entry->alive.load(std::memory_order_acquire)) {
+      continue;
+    }
+    if (entry->runner->RunsTasksInCurrentSequence()) {
+      // Same-sequence producer (the renderer main thread when the stop
+      // arrives): settle inline.
+      entry->producer->Settle();
+      continue;
+    }
+    std::shared_ptr<RegistryEntry> pinned = entry;
+    entry->runner->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](std::shared_ptr<RegistryEntry> e) {
+              if (e->alive.load(std::memory_order_acquire)) {
+                e->producer->Settle();
+              }
+            },
+            std::move(pinned)));
+  }
+}
+
+//
+// XTraceThreadProducer
+//
+
+// static
+XTraceThreadProducer* XTraceThreadProducer::Current() {
+  if (!CaptureRuntimeEnabled()) {
+    return nullptr;
+  }
+  // Stack-allocated thread local: the destructor runs at thread teardown
+  // and settles an active capture (P2-E4 worker lifecycle hook).
+  thread_local XTraceThreadProducer producer;
+  return &producer;
+}
+
+namespace {
+
+// Registered by XTraceThreadProducer's constructor so the P5-R1 reject
+// path (CurrentIfExists) can observe an existing producer without
+// constructing one.
+thread_local XTraceThreadProducer* t_existing_producer = nullptr;
+
+}  // namespace
+
+XTraceThreadProducer* XTraceThreadProducer::CurrentIfExists() {
+  // P5-R1: the reject path observes without initializing. Reads the
+  // constructor-registered thread-local pointer (see t_existing below).
+  return t_existing_producer;
+}
+
+// static
+void XTraceThreadProducer::EnsureControlEndpointRegistered() {
+  XTraceThreadProducer* producer = Current();
+  if (!producer) {
+    return;  // capture disabled in this process
+  }
+  // host() only registers the endpoint for a built descriptor; build it
+  // now so the registration (and the browser's config backfill) happens
+  // before any page script runs in this process.
+  if (!producer->descriptor_built_) {
+    producer->BuildDescriptor();
+  }
+  producer->host();
+}
+
+// static
+void XTraceThreadProducer::SetCurrentThreadWorkerDescriptor(
+    const char* kind,
+    const String& scope_url) {
+  XTraceThreadProducer* producer = Current();
+  if (!producer || producer->descriptor_built_) {
+    return;
+  }
+  producer->worker_kind_ = kind ? kind : "unresolved";
+  std::string scope = scope_url.Utf8();
+  producer->worker_scope_ = scope.empty() ? "unresolved" : scope;
+}
+
+XTraceThreadProducer::XTraceThreadProducer() {
+  auto entry = std::make_shared<XTraceProducerHub::RegistryEntry>();
+  entry->producer = this;
+  entry->runner = base::SequencedTaskRunner::GetCurrentDefault();
+  registry_id_ = XTraceProducerHub::Get()->Register(std::move(entry));
+  t_existing_producer = this;  // P5-R1: CurrentIfExists observation
+}
+
+XTraceThreadProducer::~XTraceThreadProducer() {
+  // Worker-thread teardown settles an active capture (P2-E4): the
+  // watermark is submitted on this thread's pipe while it still lives.
+  if (!settled_) {
+    Settle();
+  }
+  if (t_existing_producer == this) {
+    t_existing_producer = nullptr;
+  }
+  XTraceProducerHub::Get()->Unregister(registry_id_);
+}
+
+void XTraceThreadProducer::BuildDescriptor() {
+  descriptor_built_ = true;
+  generation_ = XTraceProducerHub::Get()->current_generation();
+  process_epoch_ = XTraceProducerHub::Get()->process_epoch();
+  is_worker_ = !IsMainThread();  // blink::IsMainThread (wtf.h)
+  pkind_ = is_worker_ ? "rtw" : "rtx";
+  producer_id_ =
+      pkind_ + ":" + base::NumberToString(base::GetCurrentProcId()) + "." +
+      process_epoch_ + ":" +
+      base::NumberToString(base::PlatformThread::CurrentId().raw()) + ":" +
+      base::NumberToString(XTraceProducerHub::Get()->NextLseq());
+}
+
+blink::mojom::XTraceProducerDescriptorPtr
+XTraceThreadProducer::MakeDescriptor() {
+  auto descriptor = blink::mojom::XTraceProducerDescriptor::New();
+  descriptor->producer_id = producer_id_;
+  descriptor->process_epoch = process_epoch_;
+  descriptor->pkind = pkind_;
+  descriptor->config_generation = generation_;
+  if (is_worker_) {
+    auto worker = blink::mojom::XTraceWorkerDescriptor::New();
+    worker->kind = worker_kind_;
+    worker->scope_url = worker_scope_;
+    descriptor->worker = std::move(worker);
+  }
+  return descriptor;
+}
+
+blink::mojom::XTraceHost* XTraceThreadProducer::host() {
+  // P4-E3: first real producer activity is the capture-lifecycle point to
+  // install the ignition observer (idempotent; no-op unless requested).
+  IgnitionBridge::EnsureInstalled();
+  if (!HostFactorySlot().is_null()) {
+    // Installed by the test before any producer exists (P3-E0).
+    return HostFactorySlot().Run();
+  }
+  if (!host_bound_) {
+    host_bound_ = true;
+    Platform::Current()->GetBrowserInterfaceBroker()->GetInterface(
+        host_.BindNewPipeAndPassReceiver());
+    if (descriptor_built_) {
+      // Once per renderer process: hand the browser a control endpoint for
+      // stop distribution (in-band delivery, see XTraceHost.mojom).
+      static std::atomic<bool> control_endpoint_sent{false};
+      if (!control_endpoint_sent.exchange(true)) {
+        mojo::PendingRemote<blink::mojom::XTraceControl> control;
+        blink::BindXTraceControlReceiver(
+            control.InitWithNewPipeAndPassReceiver());
+        host_->ProvideControlEndpoint(MakeDescriptor(), std::move(control));
+      }
+    }
+  }
+  return host_.get();
+}
+
+std::optional<uint64_t> XTraceThreadProducer::AcceptEvent(
+    std::string line, const std::string& config_generation) {
+  if (settled_ || XTraceProducerHub::Get()->stopping()) {
+    return std::nullopt;  // outside the capture window; not counted
+  }
+  const size_t close = line.find_last_of('}');
+  if (close == std::string::npos) {
+    return std::nullopt;  // malformed line never entered the capture
+  }
+  if (!descriptor_built_) {
+    BuildDescriptor();
+  }
+  // The sequence number is assigned before enqueue (draft §7.1), so
+  // overflow drops leave a tail-only gap accounted for by the counters.
+  const uint64_t seq = next_seq_++;
+  ++eligible_;
+  const uint32_t capacity = XTraceProducerHub::Get()->config().buffer_capacity;
+  if (overflowed_ || buffer_.size() >= capacity) {
+    // drop-newest (DP3 ruling): only tail gaps are allowed. Under sustained
+    // pressure a bounded buffer would otherwise punch holes between flushes
+    // (accepted/dropped/accepted), so the first overflow makes this
+    // producer stop accepting: everything after the buffered prefix is
+    // counted as dropped, and the written set stays a contiguous prefix.
+    overflowed_ = true;
+    ++dropped_;
+    return seq;
+  }
+  // Identity tail is appended here so hot hook sites build lines once. The
+  // generation comes from the caller's snapshot (F1/B7): one per event.
+  line.insert(close,
+              ",\"producer_seq\":\"" + base::NumberToString(seq) +
+                  "\",\"producer_id\":\"" + producer_id_ +
+                  "\",\"process_epoch\":\"" + process_epoch_ +
+                  "\",\"config_generation\":\"" + config_generation + "\"");
+  buffer_.push_back(std::move(line));
+  ++enqueued_;
+  if (buffer_.size() >= XTraceProducerHub::Get()->config().max_batch_events) {
+    Flush();
+  } else {
+    MaybeScheduleFlushTimer();
+  }
+  return seq;
+}
+
+void XTraceThreadProducer::SendAsset(std::string asset_json,
+                                      std::string content_path,
+                                      std::string content) {
+  if (settled_ || asset_json.empty()) {
+    return;
+  }
+  if (!descriptor_built_) {
+    BuildDescriptor();
+  }
+  blink::mojom::XTraceAssetPtr message =
+      blink::mojom::XTraceAsset::New();
+  message->producer = MakeDescriptor();
+  message->asset_json = std::move(asset_json);
+  message->content_path = std::move(content_path);
+  message->content = std::move(content);
+  host()->LogAsset(std::move(message));
+  ++assets_out_;
+}
+
+void XTraceThreadProducer::MaybeScheduleFlushTimer() {
+  if (flush_timer_posted_ || buffer_.empty()) {
+    return;
+  }
+  flush_timer_posted_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce([]() {
+        XTraceThreadProducer* producer = Current();
+        if (producer) {
+          producer->flush_timer_posted_ = false;
+          producer->Flush();
+        }
+      }),
+      base::Milliseconds(
+          XTraceProducerHub::Get()->config().flush_interval_ms));
+}
+
+void XTraceThreadProducer::SendBatchLocked() {
+  if (buffer_.empty()) {
+    return;
+  }
+  const uint64_t first_seq = next_seq_ - 1 - buffer_.size() + 1;
+  blink::mojom::XTraceBatchPtr batch =
+      blink::mojom::XTraceBatch::New();
+  batch->producer = MakeDescriptor();
+  batch->first_producer_seq = base::NumberToString(first_seq);
+  batch->count = base::saturated_cast<uint32_t>(buffer_.size());
+  batch->event_json_lines.reserve(buffer_.size());
+  while (!buffer_.empty()) {
+    batch->event_json_lines.push_back(std::move(buffer_.front()));
+    buffer_.pop_front();
+  }
+  host()->LogBatch(std::move(batch));
+}
+
+void XTraceThreadProducer::Flush() {
+  if (!descriptor_built_) {
+    return;
+  }
+  SendBatchLocked();
+}
+
+void XTraceThreadProducer::Settle() {
+  if (settled_) {
+    return;
+  }
+  settled_ = true;
+  if (!descriptor_built_) {
+    return;  // nothing was ever produced on this thread
+  }
+  SendBatchLocked();
+  blink::mojom::XTraceWatermarkPtr watermark =
+      blink::mojom::XTraceWatermark::New();
+  watermark->producer = MakeDescriptor();
+  watermark->final_producer_seq = base::NumberToString(next_seq_ - 1);
+  watermark->eligible = base::NumberToString(eligible_);
+  watermark->enqueued = base::NumberToString(enqueued_);
+  watermark->dropped = base::NumberToString(dropped_);
+  watermark->assets_out = assets_out_;
+  // DP1 (P5 review fix 5): NADC entries rejected by the TryEnter precheck.
+  // Settled with the same closure discipline as the other counters so a
+  // rejected entry is accounted, never silently dropped.
+  watermark->nadc_partial = base::NumberToString(
+      nadc_partial_.load(std::memory_order_relaxed));
+  watermark->scope_overflow = base::NumberToString(
+      scope_overflow_.load(std::memory_order_relaxed));
+  host()->SubmitWatermark(std::move(watermark));
+}
+
+bool XTraceThreadProducer::BufferHasRoom() const {
+  // P5-R1 precheck: the capture window must be open and the bounded
+  // buffer below capacity. The sticky drop-newest state counts as
+  // no-room (AcceptEvent rejects everything from the first overflow on —
+  // the precheck must agree with it). Chief review R1: reserve headroom
+  // for the entry+outcome pair so an accepted precheck cannot strand a
+  // half-pair. Sequence-confined read, matching AcceptEvent's access
+  // discipline.
+  if (settled_ || overflowed_ || XTraceProducerHub::Get()->stopping()) {
+    return false;
+  }
+  return buffer_.size() + 2 <=
+         XTraceProducerHub::Get()->config().buffer_capacity;
+}
+
+}  // namespace blink::xtrace
